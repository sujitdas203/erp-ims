@model IMS.Models.MockTest.MockTestFormViewModel
@{
    ViewData["Title"] = "Create Mock Test";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-calendar-plus me-2"></i>Create Mock Test</h3>
    <a asp-controller="MockTests" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm("CreateAjax", "MockTests", FormMethod.Post, new { id = "mockTestCreateForm" }))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/mocktests.js"></script>
}
