@model IMS.Models.MockTest.MockTestDetailsViewModel
@{
    ViewData["Title"] = "Mock Test Details";

    var passedCount = Model.Results.Count(r => r.Score >= Model.Test.MT_PassMarks);
    var failedCount = Model.Results.Count - passedCount;
    var passRate = Model.Results.Count > 0 ? (passedCount * 100.0 / Model.Results.Count) : 0;
    var highestScore = Model.Results.Any() ? Model.Results.Max(r => r.Score) : 0;
    var lowestScore = Model.Results.Any() ? Model.Results.Min(r => r.Score) : 0;

    string StatusBadge(string status) => (status ?? "").ToLower() switch
    {
        "scheduled" => "bg-primary",
        "ongoing" => "bg-warning text-dark",
        "completed" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-file-earmark-check me-2"></i>Mock Test Details</h3>
    <div class="d-flex gap-2">
        <a asp-controller="MockTests" asp-action="Edit" asp-route-id="@Model.Test.MT_Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Test
        </a>
        <a asp-controller="MockTests" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<!-- Test Summary Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <h4 class="mb-1 text-primary fw-bold">@Model.Test.MT_Title</h4>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-secondary"><i class="bi bi-collection me-1"></i>@Model.Test.BatchName</span>
                    <span class="badge bg-info text-dark"><i class="bi bi-book me-1"></i>@Model.Test.SubjectName</span>
                    <span class="badge @StatusBadge(Model.Test.MT_Status)">@Model.Test.MT_Status</span>
                    @if (Model.Test.MT_IsActive)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-pause-circle me-1"></i>Inactive</span>
                    }
                </div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Test Schedule</div>
                <div class="fw-bold text-dark fs-5">
                    <i class="bi bi-calendar3 me-1 text-primary"></i>@Model.Test.MT_TestDate.ToString("dd MMM yyyy, hh:mm tt")
                </div>
                <span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i>@Model.Test.MT_DurationMinutes Minutes</span>
            </div>
        </div>

        <div class="row g-3 py-3 border-top border-bottom bg-light rounded px-2 my-2">
            <div class="col-md-3">
                <span class="text-muted small d-block">Total Marks</span>
                <strong class="fs-5 text-dark">@Model.Test.MT_TotalMarks.ToString("0.##")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Pass Marks</span>
                <strong class="fs-5 text-secondary">@Model.Test.MT_PassMarks.ToString("0.##")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Submissions / Attended</span>
                <span class="badge bg-primary fs-6">@Model.Results.Count Students</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Pass Rate</span>
                <strong class="fs-5 @(passRate >= 50 ? "text-success" : "text-danger")">@passRate.ToString("0.#")%</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Test.MT_Description))
        {
            <div class="mt-3">
                <h6 class="fw-bold text-secondary">Description / Topics:</h6>
                <div class="p-3 bg-white border rounded text-dark" style="white-space: pre-line;">@Model.Test.MT_Description</div>
            </div>
        }
    </div>
</div>

<!-- Performance Overview Cards -->
@if (Model.Results.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-start border-success border-4">
                <div class="card-body">
                    <div class="text-muted small">Highest Score</div>
                    <div class="fs-4 fw-bold text-success">@highestScore.ToString("0.##") <small class="text-muted fs-6">/ @Model.Test.MT_TotalMarks.ToString("0.##")</small></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-start border-primary border-4">
                <div class="card-body">
                    <div class="text-muted small">Average Score</div>
                    <div class="fs-4 fw-bold text-primary">@(Model.Test.AvgScore.HasValue ? Model.Test.AvgScore.Value.ToString("0.#") : "0")%</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-start border-info border-4">
                <div class="card-body">
                    <div class="text-muted small">Passed Students</div>
                    <div class="fs-4 fw-bold text-info">@passedCount <small class="text-muted fs-6">(@passRate.ToString("0.#")%)</small></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-start border-danger border-4">
                <div class="card-body">
                    <div class="text-muted small">Failed Students</div>
                    <div class="fs-4 fw-bold text-danger">@failedCount</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Results Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-dark"><i class="bi bi-trophy me-2"></i>Student Results & Scores (@Model.Results.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Results.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-mortarboard text-muted" style="font-size: 2.5rem;"></i>
                <p class="text-muted mt-2 mb-0">No student results recorded yet for this mock test.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Score</th>
                            <th>Percentage</th>
                            <th>Result</th>
                            <th>Grade</th>
                            <th>Completed At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model.Results)
                        {
                            var isPassed = res.Score >= Model.Test.MT_PassMarks;
                            <tr>
                                <td>
                                    <div class="fw-bold">@res.StudentName</div>
                                    <small class="text-muted">Code: @res.StudentCode | Adm: @res.AdmissionNumber</small>
                                </td>
                                <td>
                                    <strong>@res.Score.ToString("0.##")</strong>
                                    <span class="text-muted small">/ @Model.Test.MT_TotalMarks.ToString("0.##")</span>
                                </td>
                                <td>
                                    <div class="progress" style="height: 6px; width: 80px;">
                                        <div class="progress-bar @(isPassed ? "bg-success" : "bg-danger")" style="width: @Math.Min(100, Math.Max(0, res.Percentage))%;"></div>
                                    </div>
                                    <small class="text-muted">@res.Percentage.ToString("0.#")%</small>
                                </td>
                                <td>
                                    @if (isPassed)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Pass</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>Fail</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(string.IsNullOrWhiteSpace(res.Grade) ? "-" : res.Grade)</span>
                                </td>
                                <td>
                                    <small class="text-muted">@res.CompletedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
