@model IMS.Models.ViewModels.ExamFormViewModel
@{ ViewData["Title"] = "Edit Exam"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-file-pen me-2"></i>Edit Exam</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="examEditForm" asp-controller="Exam" asp-action="EditExam" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/exams.js"></script>
    <script>
        $(function () {
            IMSExamForm.init('/Exam/EditExam');
            IMSDatePicker.init({ input: '#EX_StartDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
            IMSDatePicker.init({ input: '#EX_EndDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

            Dropdown.load({ element: '#EX_AcademicYearId', entityType: 'AcademicYear', defaultText: 'Select Year', includeDefault: true, selectedValue: $('#EX_AcademicYearId').data('selected-value') });
            Dropdown.load({ element: '#EX_CourseId', entityType: 'Course', defaultText: 'Select Course', includeDefault: true, selectedValue: $('#EX_CourseId').data('selected-value') });
            Dropdown.load({ element: '#EX_BatchId', entityType: 'Batch', defaultText: 'Select Batch', includeDefault: true, selectedValue: $('#EX_BatchId').data('selected-value') });
            Dropdown.load({ element: '#EX_ExamTypeId', entityType: 'ExamType', defaultText: 'Select Type', includeDefault: true, selectedValue: $('#EX_ExamTypeId').data('selected-value') });
        });
    </script>
}
