@model IMS.Models.ViewModels.DailyCollectionReportViewModel
@{
    ViewData["Title"] = "Cashier Day-End Fee Collection Scroll";
}

<div class="container-fluid px-3 py-2">
    <!-- Header & Print Actions -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fa-solid fa-cash-register text-primary me-2"></i>Day-End Cash Collection Scroll
                <span class="badge bg-light text-secondary border ms-2 fs-6">দৈনিক আদায় খতিয়ান</span>
            </h4>
            <p class="text-muted small mb-0">Daily counter collection scroll, mode-wise audit breakdown, and cashier balancing.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print Scroll
            </button>
            <a asp-controller="Fees" asp-action="CollectFee" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> POS Collection Desk
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-3 bg-light d-print-none">
        <div class="card-body p-3">
            @using (Html.BeginForm("DailyScroll", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">From Date</label>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">To Date</label>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Payment Mode</label>
                    <select name="paymentMethodId" class="form-select">
                        <option value="">-- All Payment Methods --</option>
                        @foreach (var opt in Model.PaymentMethodOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.PaymentMethodId?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filter Scroll
                    </button>
                    <a asp-controller="Fees" asp-action="DailyScroll" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Mode-Wise Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col">
            <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Cash (নগদ)</div>
                    <h4 class="fw-bold mb-0 text-success">₹@Model.CashTotal.ToString("N2")</h4>
                    <small class="text-muted">In Cash Drawer</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">UPI / QR Code</div>
                    <h4 class="fw-bold mb-0 text-primary">₹@Model.UpiTotal.ToString("N2")</h4>
                    <small class="text-muted">Instant Bank Credit</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Bank / NEFT / RTGS</div>
                    <h4 class="fw-bold mb-0 text-info">₹@Model.BankTotal.ToString("N2")</h4>
                    <small class="text-muted">Direct Transfer</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Cheque / DD</div>
                    <h4 class="fw-bold mb-0 text-dark">₹@Model.ChequeTotal.ToString("N2")</h4>
                    <small class="text-muted">Subject to Realization</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm rounded-3 border-start border-dark border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Total Collection</div>
                    <h4 class="fw-bold mb-0 text-dark">₹@Model.GrandTotal.ToString("N2")</h4>
                    <small class="text-muted">@Model.Items.Count Receipts Cleared</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Collection Items Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="fa-solid fa-list-check me-2 text-secondary"></i>Itemized Transaction Scroll
                <span class="text-muted small fw-normal ms-2">(@Model.FromDate.ToString("dd-MMM-yyyy") to @Model.ToDate.ToString("dd-MMM-yyyy"))</span>
            </h6>
            <span class="badge bg-primary rounded-pill">@Model.Items.Count Transactions</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Receipt #</th>
                        <th>Date & Time</th>
                        <th>Student Name & Code</th>
                        <th>Class / Section</th>
                        <th>Mode</th>
                        <th>Ref / Cheque #</th>
                        <th>Cashier</th>
                        <th class="text-end">Amount (₹)</th>
                        <th class="text-center">Status</th>
                        <th class="text-end d-print-none">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-receipt fs-2 mb-2 d-block text-secondary"></i>
                                No fee collections recorded in this date range.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@index</td>
                                <td>
                                    <strong class="text-primary">@item.ReceiptNumber</strong>
                                </td>
                                <td>@item.PaymentDate.ToString("dd-MMM-yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.StudentName</div>
                                    <small class="text-muted">@item.StudentCode</small>
                                </td>
                                <td>
                                    <small class="text-secondary">@(item.CourseName ?? "-") @(string.IsNullOrEmpty(item.BatchName) ? "" : $"({item.BatchName})")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.PaymentMethod</span>
                                </td>
                                <td>
                                    <small class="text-muted">@(item.TransactionRef ?? item.ChequeNumber ?? "-")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@(item.CashierName ?? "Admin")</small>
                                </td>
                                <td class="text-end fw-bold text-success fs-6">
                                    ₹@item.Amount.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@item.Status</span>
                                </td>
                                <td class="text-end d-print-none">
                                    <a asp-controller="Fees" asp-action="Receipt" asp-route-id="@item.PaymentId" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Receipt">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
                @if (Model.Items.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="8" class="text-end text-uppercase">Day-End Net Total:</td>
                            <td class="text-end text-success fs-5">₹@Model.GrandTotal.ToString("N2")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <!-- Official West Bengal School Cashier & Headmaster Sign-Off Block -->
    <div class="row mt-5 pt-4 text-center">
        <div class="col-4">
            <div class="border-top border-dark pt-2 mx-4">
                <strong>Cashier / Collecting Clerk</strong>
                <div class="small text-muted">হিসাবরক্ষক / ক্যাশিয়ার</div>
            </div>
        </div>
        <div class="col-4">
            <div class="border-top border-dark pt-2 mx-4">
                <strong>Office Assistant / Accountant</strong>
                <div class="small text-muted">অফিস সহায়ক / কেরানী</div>
            </div>
        </div>
        <div class="col-4">
            <div class="border-top border-dark pt-2 mx-4">
                <strong>Headmaster / Teacher-In-Charge</strong>
                <div class="small text-muted">প্রধান শিক্ষক / ভারপ্রাপ্ত শিক্ষক</div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body { font-size: 11pt; background: #fff !important; }
        .d-print-none, .navbar, .sidebar, footer { display: none !important; }
        .container-fluid { width: 100% !important; padding: 0 !important; }
        .card { border: none !important; box-shadow: none !important; }
        .table { width: 100% !important; border-collapse: collapse !important; }
        .table th, .table td { border: 1px solid #dee2e6 !important; padding: 4px 8px !important; }
    }
</style>
