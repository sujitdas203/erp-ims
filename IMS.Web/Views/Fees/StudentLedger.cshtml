@model IMS.Models.ViewModels.StudentFeeLedgerViewModel
@{
    ViewData["Title"] = $"Fee Ledger - {Model.StudentName} ({Model.StudentCode})";
}

<div class="container-fluid px-3 py-2">
    <!-- Action Bar & Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Fees" asp-action="Invoices">Fees</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Fees" asp-action="CollectFee" asp-route-studentId="@Model.StudentId">Collect Fee</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Student Ledger</li>
                </ol>
            </nav>
            <h4 class="mb-0 fw-bold text-dark">
                <i class="fa-solid fa-book-bookmark text-primary me-2"></i>Student Fee Ledger & Passbook
                <span class="badge bg-light text-secondary border ms-2 fs-6">ছাত্র/ছাত্রীর হিসাব খতিয়ান</span>
            </h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print Passbook
            </button>
            <a asp-controller="Fees" asp-action="CollectFee" asp-route-studentId="@Model.StudentId" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-cash-register me-1"></i> Collect Fee Desk
            </a>
        </div>
    </div>

    <!-- Student Profile Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 72px; height: 72px; font-size: 28px;">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
                <div class="col">
                    <h4 class="fw-bold mb-1 text-primary">@Model.StudentName</h4>
                    <div class="d-flex flex-wrap gap-3 text-muted small">
                        <span><i class="fa-solid fa-id-badge me-1 text-secondary"></i><strong>ID:</strong> @Model.StudentCode</span>
                        @if (!string.IsNullOrEmpty(Model.AdmissionNumber))
                        {
                            <span><i class="fa-solid fa-hashtag me-1 text-secondary"></i><strong>Adm No:</strong> @Model.AdmissionNumber</span>
                        }
                        <span><i class="fa-solid fa-chalkboard-user me-1 text-secondary"></i><strong>Class:</strong> @(Model.CourseName ?? "N/A") - @(Model.BatchName ?? "General")</span>
                        <span><i class="fa-solid fa-calendar me-1 text-secondary"></i><strong>Session:</strong> @(Model.AcademicYearName ?? "Current")</span>
                        @if (!string.IsNullOrEmpty(Model.GuardianName))
                        {
                            <span><i class="fa-solid fa-user-group me-1 text-secondary"></i><strong>Guardian:</strong> @Model.GuardianName</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <span><i class="fa-solid fa-phone me-1 text-secondary"></i>@Model.Phone</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Key Financial Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Total Billed</div>
                            <h4 class="fw-bold mb-0 text-dark">₹@Model.TotalBilled.ToString("N2")</h4>
                            <small class="text-muted">All sessions combined</small>
                        </div>
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                            <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Total Paid</div>
                            <h4 class="fw-bold mb-0 text-success">₹@Model.TotalPaid.ToString("N2")</h4>
                            <small class="text-muted">Cleared receipts</small>
                        </div>
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                            <i class="fa-solid fa-circle-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start @(Model.OutstandingDue > 0 ? "border-danger" : "border-secondary") border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Net Outstanding Due</div>
                            <h4 class="fw-bold mb-0 @(Model.OutstandingDue > 0 ? "text-danger" : "text-dark")">₹@Model.OutstandingDue.ToString("N2")</h4>
                            <small class="text-muted">Payable to school</small>
                        </div>
                        <div class="p-3 @(Model.OutstandingDue > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-light text-secondary") rounded-circle">
                            <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Advance Wallet</div>
                            <h4 class="fw-bold mb-0 text-info">₹@Model.AdvanceWalletBalance.ToString("N2")</h4>
                            <small class="text-muted">Surplus credit on file</small>
                        </div>
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                            <i class="fa-solid fa-wallet fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ledger Tabs -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs m-0 px-3" id="ledgerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold py-3 px-4 border-0 border-bottom border-primary border-3" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices-panel" type="button" role="tab">
                        <i class="fa-solid fa-file-invoice me-2 text-primary"></i>Invoices & Billing History (@Model.Invoices.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold py-3 px-4 text-secondary" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments-panel" type="button" role="tab">
                        <i class="fa-solid fa-receipt me-2 text-success"></i>Payment Receipts (@Model.Payments.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold py-3 px-4 text-secondary" id="advances-tab" data-bs-toggle="tab" data-bs-target="#advances-panel" type="button" role="tab">
                        <i class="fa-solid fa-wallet me-2 text-info"></i>Advance Wallet Ledger (@Model.Advances.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="tab-content" id="ledgerTabContent">
                
                <!-- Tab 1: Invoices -->
                <div class="tab-pane fade show active" id="invoices-panel" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Type / Period</th>
                                    <th>Fee Heads Description</th>
                                    <th>Invoice Date</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Total (₹)</th>
                                    <th class="text-end">Paid (₹)</th>
                                    <th class="text-end">Balance (₹)</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Invoices.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-folder-open fs-2 mb-2 d-block text-secondary"></i>
                                            No fee invoices or billing charges recorded for this student yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var inv in Model.Invoices)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-dark">@inv.FI_InvoiceNumber</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@(inv.FI_InvoiceType ?? "General")</span>
                                                @if (!string.IsNullOrEmpty(inv.FI_BillingPeriod))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@inv.FI_BillingPeriod</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@(string.IsNullOrEmpty(inv.FeeHeadsSummary) ? "Tuition & Development Fees" : inv.FeeHeadsSummary)</small>
                                            </td>
                                            <td>@inv.FI_InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <span class="@(inv.FI_BalanceAmount > 0 && inv.FI_DueDate < DateTime.Today ? "text-danger fw-bold" : "")">
                                                    @inv.FI_DueDate.ToString("dd-MMM-yyyy")
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold">₹@inv.FI_TotalAmount.ToString("N2")</td>
                                            <td class="text-end text-success">₹@inv.FI_PaidAmount.ToString("N2")</td>
                                            <td class="text-end fw-bold @(inv.FI_BalanceAmount > 0 ? "text-danger" : "text-muted")">
                                                ₹@inv.FI_BalanceAmount.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @InvoiceBadge(inv.FI_Status)">@inv.FI_Status</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: Payments / Receipts -->
                <div class="tab-pane fade" id="payments-panel" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Receipt #</th>
                                    <th>Date</th>
                                    <th>Payment Mode</th>
                                    <th>Ref / Cheque</th>
                                    <th>Cashier</th>
                                    <th class="text-end">Amount Paid (₹)</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Print Receipt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Payments.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-receipt fs-2 mb-2 d-block text-secondary"></i>
                                            No payment receipts found for this student.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var p in Model.Payments)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-primary">@p.PAY_PaymentNumber</strong>
                                            </td>
                                            <td>@p.PAY_PaymentDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    <i class="fa-solid fa-wallet me-1 text-secondary"></i>@p.PaymentMethodName
                                                </span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(p.TransactionRef ?? "-")</small>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(p.CashierName ?? "Admin")</small>
                                            </td>
                                            <td class="text-end fw-bold text-success fs-6">
                                                ₹@p.PAY_Amount.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @PaymentBadge(p.PAY_Status)">@p.PAY_Status</span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Fees" asp-action="Receipt" asp-route-id="@p.PAY_Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa-solid fa-print me-1"></i> Receipt
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Advance Wallet Ledger -->
                <div class="tab-pane fade" id="advances-panel" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date Deposited</th>
                                    <th>Originating Receipt #</th>
                                    <th class="text-end">Original Surplus (₹)</th>
                                    <th class="text-end">Remaining Available Balance (₹)</th>
                                    <th class="text-center">Wallet Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Advances.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-piggy-bank fs-2 mb-2 d-block text-secondary"></i>
                                            No advance wallet balance or surplus deposits recorded.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var adv in Model.Advances)
                                    {
                                        <tr>
                                            <td>@adv.CreatedAt.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <strong class="text-dark">@adv.OriginatingReceiptNumber</strong>
                                            </td>
                                            <td class="text-end fw-semibold">₹@adv.OriginalAmount.ToString("N2")</td>
                                            <td class="text-end fw-bold @(adv.AvailableBalance > 0 ? "text-info" : "text-muted")">
                                                ₹@adv.AvailableBalance.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @(adv.Status == "available" ? "bg-info text-dark" : "bg-secondary")">@adv.Status</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@functions {
    string InvoiceBadge(string s) => s switch {
        "Paid" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Partial" => "bg-info text-dark",
        "partially_paid" => "bg-info text-dark",
        "Overdue" => "bg-danger",
        _ => "bg-secondary"
    };

    string PaymentBadge(string s) => s switch {
        "Completed" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Cancelled" => "bg-danger",
        "Refunded" => "bg-danger",
        _ => "bg-secondary"
    };
}
