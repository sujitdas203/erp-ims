@model IMS.Models.ViewModels.FeeStructureIndexViewModel
@{ ViewData["Title"] = "Fee Structures & Master Plans"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-indian-rupee-sign text-primary me-2"></i>Fee Structures & Master Plans</h4>
        <p class="text-muted small mb-0">Configure fee plans, component breakdowns, and academic year schedules for West Bengal school classes.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Fees" asp-action="CollectFee" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-cash-register me-1"></i> POS Collect Fee
        </a>
        <a asp-controller="Fees" asp-action="Invoices" class="btn btn-outline-primary shadow-sm">
            <i class="fa-solid fa-file-invoice me-1"></i> Invoices
        </a>
        <a asp-controller="Fees" asp-action="Payments" class="btn btn-outline-primary shadow-sm">
            <i class="fa-solid fa-receipt me-1"></i> Receipts
        </a>
        <a asp-controller="Fees" asp-action="DailyScroll" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-calendar-day me-1"></i> Daily Scroll
        </a>
        <a asp-controller="Fees" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add Structure
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-5">
                @Html.Label("searchTerm", "Search Structure", new { @class = "form-label fw-semibold text-secondary small" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Name or structure code" })
            </div>
            <div class="col-md-4">
                @Html.Label("academicYearId", "Academic Session / Year", new { @class = "form-label fw-semibold text-secondary small" })
                <select name="academicYearId" id="filterAcademicYearId" class="form-select" data-selected-value="@(Model.AcademicYearFilter?.ToString())">
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter Plans</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Fee Structure Name</th>
                    <th>Class / Course</th>
                    <th>Section / Batch</th>
                    <th>Academic Year</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.FeeStructures)
                {
                    <tr id="fs-row-@f.FS_Id">
                        <td><strong>@f.FS_Code</strong></td>
                        <td>@f.FS_Name</td>
                        <td>@(f.CourseName ?? "All Classes")</td>
                        <td>@(f.BatchName ?? "All Sections")</td>
                        <td>@f.AcademicYearName</td>
                        <td>
                            <span class="badge @(f.FS_IsActive ? "bg-success" : "bg-secondary")">
                                @(f.FS_IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Fees" asp-action="Edit" asp-route-id="@f.FS_Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-id="@f.FS_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@f.FS_Id"><i class="fa-solid fa-trash"></i></button>
                            <div class="modal fade text-start" id="deleteModal-@f.FS_Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Delete Fee Structure</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">Are you sure you want to delete fee structure <strong>@f.FS_Name</strong>?</div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/fees.js"></script>
    <script>
    $(function () {
        $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[0, 'asc']] });
        Dropdown.load({ element: '#filterAcademicYearId', entityType: 'AcademicYear', defaultText: 'All Years', includeDefault: true, selectedValue: $('#filterAcademicYearId').data('selected-value') });
    });
    </script>
}
