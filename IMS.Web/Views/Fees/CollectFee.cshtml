@model IMS.Models.ViewModels.FeeCollectViewModel
@{
    ViewData["Title"] = "Fee Collection Desk";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-cash-register me-2 text-primary"></i>Fee Collection Desk (ফি কাউন্টার)</h4>
        <p class="text-muted small mb-0">Record student fee payments, settle pending dues, generate instant charges, and print official Money Receipts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DailyScroll" class="btn btn-outline-secondary"><i class="fa-solid fa-scroll me-1"></i> Day Scroll</a>
        <a asp-action="Payments" class="btn btn-outline-primary"><i class="fa-solid fa-list me-1"></i> All Receipts</a>
    </div>
</div>

<!-- Student Lookup Bar -->
<div class="card shadow-sm mb-3 border-0 bg-light">
    <div class="card-body py-3">
        <form method="get" asp-action="CollectFee" class="row g-2 align-items-center">
            <div class="col-md-8">
                <label class="form-label small fw-bold text-muted mb-1">Select Student (Student Code, Name, or Roll No)</label>
                <select id="lookupStudentId" name="studentId" class="form-select"></select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2 mt-auto">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass me-1"></i> Load Student Dues</button>
            </div>
        </form>
    </div>
</div>

@if (Model.StudentId.HasValue && Model.StudentId != Guid.Empty)
{
    <!-- Student Snapshot Banner -->
    <div class="card shadow-sm mb-3 border-0 border-start border-4 border-primary">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle bg-primary-subtle text-primary fw-bold fs-4 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            @(string.IsNullOrEmpty(Model.StudentName) ? "S" : Model.StudentName.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold text-dark">@Model.StudentName</h5>
                            <p class="mb-0 text-muted small">
                                <span class="badge bg-secondary me-1">@Model.StudentCode</span>
                                <strong>Class:</strong> @(Model.CourseName ?? "-") | <strong>Batch:</strong> @(Model.BatchName ?? "-") | <strong>Adm No:</strong> @(Model.AdmissionNumber ?? "-")
                            </p>
                            <p class="mb-0 text-muted small">
                                <strong>Guardian:</strong> @(Model.GuardianName ?? "-") | <strong>Phone:</strong> @(Model.Phone ?? "-")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <div class="d-inline-flex gap-3 text-start">
                        <div class="p-2 px-3 rounded bg-light border">
                            <span class="text-muted small d-block">Total Dues Pending</span>
                            <span class="fs-5 fw-bold text-danger">₹@Model.OutstandingDue.ToString("N2")</span>
                        </div>
                        <div class="p-2 px-3 rounded bg-light border">
                            <span class="text-muted small d-block">Advance Wallet</span>
                            <span class="fs-5 fw-bold text-success">₹@Model.AdvanceWalletBalance.ToString("N2")</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <a asp-action="StudentLedger" asp-route-studentId="@Model.StudentId" class="btn btn-outline-info btn-sm" target="_blank" title="View Full Ledger / Passbook">
                                <i class="fa-solid fa-book-open me-1"></i> Passbook
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Outstanding Invoices & Settlement Form -->
    <form id="posCollectionForm" asp-action="ProcessCollection" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="StudentId" value="@Model.StudentId" />
        <input type="hidden" id="selectedInvoiceIdsHidden" name="SelectedInvoiceIds" value="" />

        <div class="row g-3">
            <!-- Left: Dues Selection Table -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Pending Dues & Invoices (বকেয়া বিল)</h6>
                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#quickChargeModal">
                            <i class="fa-solid fa-plus me-1"></i> Add Quick Charge (TC / Fine / Event)
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="invoicesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" id="selectAllInvoices" class="form-check-input" checked />
                                    </th>
                                    <th>Invoice #</th>
                                    <th>Fee Heads / বিবরণ</th>
                                    <th>Period / Type</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Balance Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PendingInvoices.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="fa-solid fa-circle-check text-success fs-3 d-block mb-2"></i>
                                            No outstanding dues for this student! (কোনো বকেয়া নেই)
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var inv in Model.PendingInvoices)
                                    {
                                        <tr data-invoice-id="@inv.InvoiceId" data-balance="@inv.BalanceAmount">
                                            <td>
                                                <input type="checkbox" class="form-check-input inv-checkbox" value="@inv.InvoiceId" data-balance="@inv.BalanceAmount" checked />
                                            </td>
                                            <td>
                                                <span class="fw-bold">@inv.InvoiceNumber</span>
                                                <div class="small text-muted">@inv.InvoiceDate.ToString("dd-MMM-yyyy")</div>
                                            </td>
                                            <td>
                                                <span class="small">@(string.IsNullOrEmpty(inv.FeeHeadsSummary) ? "Fee Charge" : inv.FeeHeadsSummary)</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@(inv.BillingPeriod ?? inv.InvoiceType ?? "Standard")</span>
                                            </td>
                                            <td>
                                                <span class="@(inv.DueDate < DateTime.Today ? "text-danger fw-bold" : "text-muted") small">
                                                    @inv.DueDate.ToString("dd-MMM-yyyy")
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-dark">
                                                ₹@inv.BalanceAmount.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right: Payment Mode & Cashier Tender -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-receipt me-2"></i>Payment Settlement (টাকা গ্রহণ)</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Total Selected Dues</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="text" id="selectedDuesDisplay" class="form-control fw-bold fs-5 bg-light" readonly value="₹@Model.AmountTendered.ToString("N2")" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Payment Method (পরিশোধ পদ্ধতি) <span class="text-danger">*</span></label>
                            <select id="paymentMethodSelect" name="PaymentMethodId" class="form-select" required>
                                <option value="">Select Method</option>
                                @foreach (var pm in Model.PaymentMethodOptions)
                                {
                                    <option value="@pm.Value" selected="@pm.Selected">@pm.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Amount Paid (গৃহীত অর্থ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" id="paidAmountInput" name="Amount" class="form-control fw-bold text-success fs-5" step="0.01" min="0.01" value="@Model.AmountTendered" required />
                            </div>
                            <div class="form-text small" id="walletAdvanceNotice"></div>
                        </div>

                        <!-- Dynamic UPI Reference field -->
                        <div class="mb-3 payment-conditional" id="upiRefContainer" style="display: none;">
                            <label class="form-label small fw-bold">UPI / Bank Transaction UTR No.</label>
                            <input type="text" name="TransactionReference" class="form-control" placeholder="12-digit UPI Ref / UTR" />
                        </div>

                        <!-- Dynamic Cheque fields -->
                        <div class="payment-conditional" id="chequeContainer" style="display: none;">
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Cheque / DD Number</label>
                                <input type="text" name="ChequeNumber" class="form-control" placeholder="e.g. 000142" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Bank & Branch Name</label>
                                <input type="text" name="BankName" class="form-control" placeholder="e.g. SBI Shyambazar" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Cheque Date</label>
                                <input type="date" name="ChequeDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Payment Date</label>
                            <input type="date" name="PaymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Counter Remarks / Notes</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="e.g. Cash collected at Counter 1"></textarea>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" id="btnSubmitPayment" class="btn btn-success btn-lg shadow-sm">
                                <i class="fa-solid fa-print me-2"></i> Receive & Print Receipt
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Quick Charge Modal (Instant TC / Fine / On-Demand Bill) -->
    <div class="modal fade" id="quickChargeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="quickChargeForm" asp-action="AddQuickCharge" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StudentId" value="@Model.StudentId" />
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold"><i class="fa-solid fa-bolt text-warning me-2"></i>Add Quick On-Demand Charge</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Fee Category (খাত) <span class="text-danger">*</span></label>
                            <select name="FeeCategoryId" class="form-select" required>
                                <option value="">Select Category</option>
                                @foreach (var fc in Model.FeeCategoryOptions)
                                {
                                    <option value="@fc.Value">@fc.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Charge Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" name="Amount" class="form-control" step="0.01" min="1" placeholder="e.g. 100.00" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Particulars / Description <span class="text-danger">*</span></label>
                            <input type="text" name="Description" class="form-control" placeholder="e.g. Transfer Certificate (TC) Fee" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Add to Current Bill</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 py-5 text-center">
        <div class="card-body">
            <i class="fa-solid fa-user-graduate text-muted mb-3" style="font-size: 64px;"></i>
            <h5 class="fw-bold">No Student Selected</h5>
            <p class="text-muted">Search and select a student from the dropdown above to load their pending fee dues, advance wallet, and bill breakdown.</p>
        </div>
    </div>
}

@section Scripts {
<script>
$(function() {
    // Dropdown student search
    Dropdown.load({
        element: '#lookupStudentId',
        entityType: 'Student',
        defaultText: 'Search by Student Code or Name...',
        includeDefault: true,
        selectedValue: '@(Model.StudentId?.ToString() ?? "")'
    });

    // Auto-calculate selected dues
    function recalculateTotal() {
        var total = 0;
        var selectedIds = [];
        $('.inv-checkbox:checked').each(function() {
            var bal = parseFloat($(this).data('balance')) || 0;
            total += bal;
            selectedIds.push($(this).val());
        });

        $('#selectedDuesDisplay').val('₹' + total.toFixed(2));
        $('#paidAmountInput').val(total.toFixed(2));
        $('#selectedInvoiceIdsHidden').val(selectedIds.join(','));

        var advanceBal = @(Model.AdvanceWalletBalance);
        if (advanceBal > 0) {
            $('#walletAdvanceNotice').html('<span class="text-success"><i class="fa-solid fa-wallet me-1"></i> Student has ₹' + advanceBal.toFixed(2) + ' in advance credit wallet.</span>');
        }
    }

    $('#selectAllInvoices').on('change', function() {
        $('.inv-checkbox').prop('checked', $(this).prop('checked'));
        recalculateTotal();
    });

    $(document).on('change', '.inv-checkbox', function() {
        recalculateTotal();
    });

    // Show/hide conditional fields based on payment method
    $('#paymentMethodSelect').on('change', function() {
        var text = $(this).find('option:selected').text().toLowerCase();
        $('.payment-conditional').hide();
        if (text.indexOf('upi') >= 0 || text.indexOf('qr') >= 0 || text.indexOf('online') >= 0 || text.indexOf('bank') >= 0) {
            $('#upiRefContainer').slideDown();
        } else if (text.indexOf('cheque') >= 0 || text.indexOf('draft') >= 0) {
            $('#chequeContainer').slideDown();
        }
    }).trigger('change');

    // POS Collection Submission
    $('#posCollectionForm').on('submit', function(e) {
        e.preventDefault();
        var $btn = $('#btnSubmitPayment');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Processing Payment...');

        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: $(this).serialize(),
            success: function(res) {
                if (res.success) {
                    if (window.toastr) toastr.success(res.message);
                    // Open Receipt Print View in new tab and refresh desk
                    if (res.paymentId) {
                        window.open('/Fees/Receipt/' + res.paymentId, '_blank');
                    }
                    setTimeout(function() {
                        window.location.href = '/Fees/CollectFee?studentId=@(Model.StudentId)';
                    }, 1000);
                } else {
                    if (window.toastr) toastr.error(res.message);
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-print me-2"></i> Receive & Print Receipt');
                }
            },
            error: function() {
                if (window.toastr) toastr.error('Payment processing failed.');
                $btn.prop('disabled', false).html('<i class="fa-solid fa-print me-2"></i> Receive & Print Receipt');
            }
        });
    });

    // Quick Charge Form
    $('#quickChargeForm').on('submit', function(e) {
        e.preventDefault();
        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: $(this).serialize(),
            success: function(res) {
                if (res.success) {
                    if (window.toastr) toastr.success(res.message);
                    window.location.reload();
                } else {
                    if (window.toastr) toastr.error(res.message);
                }
            }
        });
    });

    recalculateTotal();
});
</script>
}
