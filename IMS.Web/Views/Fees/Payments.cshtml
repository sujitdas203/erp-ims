@model IMS.Models.ViewModels.PaymentIndexViewModel
@{ ViewData["Title"] = "Fee Payments & Receipts"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-money-bill-wave me-2 text-primary"></i>Fee Collections & Money Receipts</h4>
        <p class="text-muted small mb-0">Record incoming student fee payments, print official receipts, and audit transactions.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Fees" asp-action="CollectFee" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-cash-register me-1"></i> POS Collection Desk
        </a>
        <a asp-controller="Fees" asp-action="DailyScroll" class="btn btn-outline-primary shadow-sm">
            <i class="fa-solid fa-calendar-day me-1"></i> Day-End Cash Scroll
        </a>
        <a asp-controller="Fees" asp-action="CreatePayment" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Record Single Payment
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Payments", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                @Html.Label("searchTerm", "Search Payment / Student", new { @class = "form-label fw-semibold text-secondary small" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Receipt # or student code/name" })
            </div>
            <div class="col-md-3">
                @Html.Label("status", "Payment Status", new { @class = "form-label fw-semibold text-secondary small" })
                <select name="status" id="filterStatus" class="form-select" data-selected-value="@(Model.StatusFilter)"></select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
            <div class="col-md-3 text-end">
                <a asp-controller="Fees" asp-action="Invoices" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-file-invoice me-1"></i> View Invoices
                </a>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Receipt #</th>
                    <th>Student</th>
                    <th>Date</th>
                    <th class="text-end">Amount (₹)</th>
                    <th>Method</th>
                    <th>Ref / Cheque</th>
                    <th>Cashier</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Payments.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i class="fa-solid fa-receipt fs-2 mb-2 d-block text-secondary"></i>
                            No fee collections or receipts found matching criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model.Payments)
                    {
                        <tr id="pay-row-@p.PAY_Id">
                            <td>
                                <strong class="text-primary">@p.PAY_PaymentNumber</strong>
                            </td>
                            <td>
                                <div class="fw-semibold">@p.StudentName</div>
                                <small class="text-muted">@p.StudentCode</small>
                            </td>
                            <td>@p.PAY_PaymentDate.ToString("dd-MMM-yyyy")</td>
                            <td class="text-end fw-bold text-success fs-6">₹@p.PAY_Amount.ToString("N2")</td>
                            <td>
                                <span class="badge bg-light text-dark border">@p.PaymentMethodName</span>
                            </td>
                            <td>
                                <small class="text-muted">@(p.TransactionRef ?? "-")</small>
                            </td>
                            <td>
                                <small class="text-muted">@(p.CashierName ?? "Admin")</small>
                            </td>
                            <td class="text-center">
                                <span class="badge @PaymentStatusBadge(p.PAY_Status)">@p.PAY_Status</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Fees" asp-action="Receipt" asp-route-id="@p.PAY_Id" target="_blank" class="btn btn-outline-primary" title="Print Official Money Receipt (মানি রসিদ)">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                    @if (p.StudentId != Guid.Empty)
                                    {
                                        <a asp-controller="Fees" asp-action="StudentLedger" asp-route-studentId="@p.StudentId" class="btn btn-outline-info" title="Student Ledger Passbook">
                                            <i class="fa-solid fa-book-bookmark"></i>
                                        </a>
                                    }
                                    @if (p.PAY_Status != "Cancelled" && p.PAY_Status != "Refunded")
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@p.PAY_Id" title="Cancel / Reverse Payment">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Cancellation Modal -->
                                <div class="modal fade text-start" id="cancelModal-@p.PAY_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reverse / Cancel Payment</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="alert alert-warning small">
                                                    <strong>Audit Warning:</strong> Reversing receipt <strong>@p.PAY_PaymentNumber</strong> (₹@p.PAY_Amount.ToString("N2")) will roll back all invoice allocations, restore unpaid balances, and cancel any unspent advance wallet credit.
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold text-secondary small">Reason for Reversal <span class="text-danger">*</span></label>
                                                    <input type="text" id="cancelReason-@p.PAY_Id" class="form-control" placeholder="e.g. Cheque bounced, entry mistake, duplicate receipt" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="button" class="btn btn-danger btn-do-cancel" data-id="@p.PAY_Id">Confirm Reversal</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Payments", "Fees", new { searchTerm = Model.SearchTerm, status = Model.StatusFilter, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@functions {
    string PaymentStatusBadge(string s) => s switch {
        "Completed" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Failed" => "bg-danger",
        "Refunded" => "bg-danger",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

@section Scripts {
    <script src="~/js/fees.js"></script>
    <script>
    $(function(){
        Dropdown.load({ element: '#filterStatus', entityType: 'PaymentStatus', defaultText: 'All Statuses', includeDefault: true, selectedValue: $('#filterStatus').data('selected-value') });

        // Payment cancellation handler
        $(document).on('click', '.btn-do-cancel', function(){
            var paymentId = $(this).data('id');
            var reason = $('#cancelReason-' + paymentId).val();
            if (!reason || reason.trim() === '') {
                alert('Please provide a reason for cancelling this payment.');
                return;
            }

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Reversing...');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("CancelPayment", "Fees")',
                type: 'POST',
                data: {
                    PaymentId: paymentId,
                    Reason: reason,
                    __RequestVerificationToken: token
                },
                success: function(res){
                    if (res.success) {
                        $('#cancelModal-' + paymentId).modal('hide');
                        location.reload();
                    } else {
                        $btn.prop('disabled', false).text('Confirm Reversal');
                        alert(res.message || 'Error reversing payment.');
                    }
                },
                error: function(){
                    $btn.prop('disabled', false).text('Confirm Reversal');
                    alert('Server error while reversing payment.');
                }
            });
        });
    });
    </script>
}
