@model IMS.Models.Announcement.AnnouncementFormViewModel
@{
    ViewData["Title"] = "New Announcement";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-megaphone-fill me-2"></i>New Announcement</h3>
    <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm("CreateAjax", "Announcements", FormMethod.Post, new { id = "announcementForm" }))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/announcements.js"></script>
}
