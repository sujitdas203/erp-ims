@model IMS.Models.Announcement.AnnouncementFormViewModel

@if (Model.ANN_Id.HasValue)
{
    @Html.HiddenFor(m => m.ANN_Id)
}

<div class="row g-3">
    <div class="col-md-6">
        @Html.LabelFor(m => m.Title, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        <div class="text-danger small field-error" data-for="Title"></div>
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.BranchId, "Branch (leave blank for all branches)", new { @class = "form-label" })
        <select id="BranchId" name="BranchId" class="form-select" data-selected-value="@(Model.BranchId?.ToString() ?? "")">
            <option value="">All Branches (tenant-wide)</option>
        </select>
        <div class="text-danger small field-error" data-for="BranchId"></div>
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.Content, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = 6 })
        <div class="text-danger small field-error" data-for="Content"></div>
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.PublishedAt, "Publish At (leave blank to save as Draft)", new { @class = "form-label" })
        <input type="text" id="PublishedAt" name="PublishedAt" class="form-control ims-datepicker-input"
               placeholder="DD/MM/YYYY HH:mm"
               value="@(Model.PublishedAt?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
               data-format="dd/MM/yyyy HH:mm"
               data-value-format="yyyy-MM-ddTHH:mm"
               data-placeholder="DD/MM/YYYY HH:mm"
               data-show-time="true" />
        <div class="text-danger small field-error" data-for="PublishedAt"></div>
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.ExpiresAt, "Expires At (leave blank to never expire)", new { @class = "form-label" })
        <input type="text" id="ExpiresAt" name="ExpiresAt" class="form-control ims-datepicker-input"
               placeholder="DD/MM/YYYY HH:mm"
               value="@(Model.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
               data-format="dd/MM/yyyy HH:mm"
               data-value-format="yyyy-MM-ddTHH:mm"
               data-placeholder="DD/MM/YYYY HH:mm"
               data-show-time="true" />
        <div class="text-danger small field-error" data-for="ExpiresAt"></div>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check form-switch mt-4">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Save Announcement
    </button>
</div>
