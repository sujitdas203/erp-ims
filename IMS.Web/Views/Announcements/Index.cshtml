@model IMS.Models.Announcement.AnnouncementIndexViewModel
@{
    ViewData["Title"] = "Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-megaphone me-2"></i>Announcements</h3>
    <a asp-controller="Announcements" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Announcement
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Announcements", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                @Html.Label("search", "Search", new { @class = "form-label" })
                @Html.TextBox("search", Model.Search, new { @class = "form-control", placeholder = "Search by title" })
            </div>
            <div class="col-md-3">
                @Html.Label("branchId", "Branch", new { @class = "form-label" })
                @Html.DropDownList("branchId", Model.BranchOptions, "All Branches", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th><th>Branch</th><th>Status</th><th>Published</th><th>Expires</th><th>Active</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="announcementsTableBody">
                @if (!Model.Announcements.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No announcements found.</td></tr>
                }
                else
                {
                    foreach (var a in Model.Announcements)
                    {
                        <tr id="ann-row-@a.ANN_Id">
                            <td>@a.Title</td>
                            <td>@a.BranchName</td>
                            <td>
                                <span class="badge @(a.Status switch {
                                    "Active" => "bg-success", "Scheduled" => "bg-info text-dark",
                                    "Expired" => "bg-secondary", "Inactive" => "bg-dark", _ => "bg-warning text-dark" })">@a.Status</span>
                            </td>
                            <td>@(a.PublishedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                            <td>@(a.ExpiresAt?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")</td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input toggle-active-switch"
                                           data-id="@a.ANN_Id" @(a.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Announcements" asp-action="Edit" asp-route-id="@a.ANN_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@a.ANN_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@a.ANN_Id" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <div class="modal fade" id="deleteModal-@a.ANN_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Announcement</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">Are you sure you want to permanently delete "<strong>@a.Title</strong>"?</div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { branchId = Model.BranchFilter, status = Model.StatusFilter, search = Model.Search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/students.css" />
    <script src="~/js/announcements.js"></script>
}
