@model IMS.Models.ViewModels.AdmissionApplicationFormViewModel

@if (Model.AA_Id.HasValue) { @Html.HiddenFor(m => m.AA_Id) }

<!-- Section 1: Academic & Branch Details -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-graduation-cap text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">1. Academic &amp; Institution Preferences</h6>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Branch / Campus <span class="text-danger">*</span></label>
                <select id="AA_BranchId" name="AA_BranchId" class="form-select" data-selected-value="@(Model.AA_BranchId?.ToString())" required></select>
                <span asp-validation-for="AA_BranchId" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Academic Year <span class="text-danger">*</span></label>
                <select id="AA_AcademicYearId" name="AA_AcademicYearId" class="form-select" data-selected-value="@(Model.AA_AcademicYearId?.ToString())" required></select>
                <span asp-validation-for="AA_AcademicYearId" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Applying For Class / Grade</label>
                <select id="AA_ClassId" name="AA_ClassId" class="form-select" data-selected-value="@(Model.AA_ClassId?.ToString())"></select>
                <span asp-validation-for="AA_ClassId" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Course / Stream</label>
                <select id="AA_CourseId" name="AA_CourseId" class="form-select" data-selected-value="@(Model.AA_CourseId?.ToString())"></select>
                <span asp-validation-for="AA_CourseId" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Application Number</label>
                @Html.TextBoxFor(m => m.AA_ApplicationNumber, new { @class = "form-control", placeholder = "Auto-generated (e.g. APP-26-0001) if blank" })
                <small class="text-muted">Leave blank for automatic numbering sequence.</small>
                <span asp-validation-for="AA_ApplicationNumber" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Application Status</label>
                <select id="AA_Status" name="AA_Status" class="form-select" data-selected-value="@(Model.AA_Status)"></select>
                <span asp-validation-for="AA_Status" class="text-danger small d-block"></span>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: Student Personal Information -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-user text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">2. Student Personal Information</h6>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold">First Name <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.AA_FirstName, new { @class = "form-control", placeholder = "First Name", required = "required" })
                <span asp-validation-for="AA_FirstName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Middle Name</label>
                @Html.TextBoxFor(m => m.AA_MiddleName, new { @class = "form-control", placeholder = "Middle Name" })
                <span asp-validation-for="AA_MiddleName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Last Name <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.AA_LastName, new { @class = "form-control", placeholder = "Last Name", required = "required" })
                <span asp-validation-for="AA_LastName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Date of Birth</label>
                @Html.TextBoxFor(m => m.AA_DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "AA_DateOfBirth" })
                <span asp-validation-for="AA_DateOfBirth" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Gender</label>
                <select id="AA_Gender" name="AA_Gender" class="form-select" data-selected-value="@(Model.AA_Gender)"></select>
                <span asp-validation-for="AA_Gender" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Blood Group</label>
                <select id="AA_BloodGroup" name="AA_BloodGroup" class="form-select" data-selected-value="@(Model.AA_BloodGroup)"></select>
                <span asp-validation-for="AA_BloodGroup" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Category / Quota</label>
                <select id="AA_Category" name="AA_Category" class="form-select" data-selected-value="@(Model.AA_Category)"></select>
                <span asp-validation-for="AA_Category" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Nationality</label>
                @Html.TextBoxFor(m => m.AA_Nationality, new { @class = "form-control", placeholder = "e.g. Indian" })
                <span asp-validation-for="AA_Nationality" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Religion</label>
                @Html.TextBoxFor(m => m.AA_Religion, new { @class = "form-control", placeholder = "e.g. Hindu / Muslim / Christian" })
                <span asp-validation-for="AA_Religion" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Aadhaar / National ID</label>
                @Html.TextBoxFor(m => m.AA_AadhaarNumber, new { @class = "form-control", placeholder = "12-digit Aadhaar / ID #" })
                <span asp-validation-for="AA_AadhaarNumber" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Student Phone <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.AA_Phone, new { @class = "form-control", placeholder = "Mobile Number", required = "required" })
                <span asp-validation-for="AA_Phone" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Student Email</label>
                @Html.TextBoxFor(m => m.AA_Email, new { @class = "form-control", type = "email", placeholder = "student@example.com" })
                <span asp-validation-for="AA_Email" class="text-danger small d-block"></span>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Parent & Guardian Details -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-users text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">3. Parents &amp; Guardian Information</h6>
    </div>
    <div class="card-body p-3">
        <!-- Father Details -->
        <h6 class="text-primary fw-bold mb-2 pb-1 border-bottom small"><i class="fa-solid fa-user-tie me-1"></i> Father's Information</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Father's Full Name</label>
                @Html.TextBoxFor(m => m.AA_FatherName, new { @class = "form-control", placeholder = "Father's Name" })
                <span asp-validation-for="AA_FatherName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Father's Mobile</label>
                @Html.TextBoxFor(m => m.AA_FatherPhone, new { @class = "form-control", placeholder = "+91 9876543210" })
                <span asp-validation-for="AA_FatherPhone" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Father's Occupation</label>
                @Html.TextBoxFor(m => m.AA_FatherOccupation, new { @class = "form-control", placeholder = "e.g. Business / Service" })
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Father's Email</label>
                @Html.TextBoxFor(m => m.AA_FatherEmail, new { @class = "form-control", type = "email", placeholder = "father@example.com" })
                <span asp-validation-for="AA_FatherEmail" class="text-danger small d-block"></span>
            </div>
        </div>

        <!-- Mother Details -->
        <h6 class="text-primary fw-bold mb-2 pb-1 border-bottom small"><i class="fa-solid fa-person-dress me-1"></i> Mother's Information</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mother's Full Name</label>
                @Html.TextBoxFor(m => m.AA_MotherName, new { @class = "form-control", placeholder = "Mother's Name" })
                <span asp-validation-for="AA_MotherName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mother's Mobile</label>
                @Html.TextBoxFor(m => m.AA_MotherPhone, new { @class = "form-control", placeholder = "+91 9876543210" })
                <span asp-validation-for="AA_MotherPhone" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mother's Occupation</label>
                @Html.TextBoxFor(m => m.AA_MotherOccupation, new { @class = "form-control", placeholder = "e.g. Homemaker / Teacher" })
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mother's Email</label>
                @Html.TextBoxFor(m => m.AA_MotherEmail, new { @class = "form-control", type = "email", placeholder = "mother@example.com" })
                <span asp-validation-for="AA_MotherEmail" class="text-danger small d-block"></span>
            </div>
        </div>

        <!-- Other Legal Guardian Details -->
        <h6 class="text-secondary fw-bold mb-2 pb-1 border-bottom small"><i class="fa-solid fa-shield-heart me-1"></i> Other Legal Guardian (if applicable)</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Guardian Name</label>
                @Html.TextBoxFor(m => m.AA_GuardianName, new { @class = "form-control", placeholder = "Guardian Name" })
                <span asp-validation-for="AA_GuardianName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Relation</label>
                @Html.TextBoxFor(m => m.AA_GuardianRelation, new { @class = "form-control", placeholder = "e.g. Uncle / Aunt" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Guardian Mobile</label>
                @Html.TextBoxFor(m => m.AA_GuardianPhone, new { @class = "form-control", placeholder = "Guardian Mobile" })
                <span asp-validation-for="AA_GuardianPhone" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Guardian Occupation</label>
                @Html.TextBoxFor(m => m.AA_GuardianOccupation, new { @class = "form-control", placeholder = "Occupation" })
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Guardian Email</label>
                @Html.TextBoxFor(m => m.AA_GuardianEmail, new { @class = "form-control", type = "email", placeholder = "guardian@example.com" })
                <span asp-validation-for="AA_GuardianEmail" class="text-danger small d-block"></span>
            </div>
        </div>
    </div>
</div>

<!-- Section 4: Address & Emergency Contact -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-location-dot text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">4. Residential Address &amp; Emergency Contact</h6>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small fw-bold">Address Line 1 (Street / House No)</label>
                @Html.TextBoxFor(m => m.AA_AddressLine1, new { @class = "form-control", placeholder = "House / Flat No., Street, Landmark" })
                <span asp-validation-for="AA_AddressLine1" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">Address Line 2 (Area / Locality)</label>
                @Html.TextBoxFor(m => m.AA_AddressLine2, new { @class = "form-control", placeholder = "Area, Locality / Colony" })
                <span asp-validation-for="AA_AddressLine2" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">City / District</label>
                @Html.TextBoxFor(m => m.AA_City, new { @class = "form-control", placeholder = "City / Town" })
                <span asp-validation-for="AA_City" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">State / Province</label>
                @Html.TextBoxFor(m => m.AA_State, new { @class = "form-control", placeholder = "State" })
                <span asp-validation-for="AA_State" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Postal / PIN Code</label>
                @Html.TextBoxFor(m => m.AA_PostalCode, new { @class = "form-control", placeholder = "PIN Code" })
                <span asp-validation-for="AA_PostalCode" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Country</label>
                @Html.TextBoxFor(m => m.AA_Country, new { @class = "form-control", placeholder = "Country" })
                <span asp-validation-for="AA_Country" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold"><i class="fa-solid fa-user-shield text-muted me-1"></i> Emergency Contact Name</label>
                @Html.TextBoxFor(m => m.AA_EmergencyContactName, new { @class = "form-control", placeholder = "Name of person to contact in emergency" })
                <span asp-validation-for="AA_EmergencyContactName" class="text-danger small d-block"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold"><i class="fa-solid fa-phone text-muted me-1"></i> Emergency Contact Mobile</label>
                @Html.TextBoxFor(m => m.AA_EmergencyContactPhone, new { @class = "form-control", placeholder = "Emergency contact phone number" })
                <span asp-validation-for="AA_EmergencyContactPhone" class="text-danger small d-block"></span>
            </div>
        </div>
    </div>
</div>

<!-- Section 5: Previous Academic Background -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-school text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">5. Previous Academic History</h6>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Previous School / Institute</label>
                @Html.TextBoxFor(m => m.AA_PreviousSchool, new { @class = "form-control", placeholder = "Previous School Name" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Board / University</label>
                @Html.TextBoxFor(m => m.AA_PreviousBoard, new { @class = "form-control", placeholder = "e.g. CBSE / ICSE / State" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Last Class Passed</label>
                @Html.TextBoxFor(m => m.AA_PreviousGrade, new { @class = "form-control", placeholder = "e.g. Class 9 / Grade X" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Marks / % / CGPA</label>
                @Html.TextBoxFor(m => m.AA_PreviousMarks, new { @class = "form-control", placeholder = "e.g. 88.5% or 9.2 CGPA" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">TC / Migration No.</label>
                @Html.TextBoxFor(m => m.AA_TransferCertificateNumber, new { @class = "form-control", placeholder = "TC Certificate #" })
            </div>
        </div>
    </div>
</div>

<!-- Section 6: Additional Information & Notes -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <i class="fa-solid fa-note-sticky text-primary me-2"></i>
        <h6 class="mb-0 fw-semibold">6. Administrative Notes &amp; Special Remarks</h6>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label small fw-bold">Remarks / Internal Notes</label>
                @Html.TextAreaFor(m => m.AA_Notes, new { @class = "form-control", rows = "3", placeholder = "Enter any applicant remarks, medical flags, fee concessions, or administrative comments..." })
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 my-4">
    <a asp-controller="AdmissionApplication" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left me-1"></i> Cancel
    </a>
    <button type="submit" class="btn btn-primary px-4 shadow-sm">
        <i class="fa-solid fa-check me-1"></i> Save Application
    </button>
</div>
