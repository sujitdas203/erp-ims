@model IMS.Models.ViewModels.AdmissionApplicationIndexViewModel
@{ ViewData["Title"] = "Admission Applications"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-file-signature text-primary me-2"></i>Admission Applications</h4>
        <p class="text-muted small mb-0">Manage incoming admissions, review applicant profiles, and enroll students.</p>
    </div>
    <a asp-controller="AdmissionApplication" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> New Application
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "AdmissionApplication", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Search Keyword</label>
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control form-control-sm", placeholder = "App #, name, phone, parent..." })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Branch / Campus</label>
                <select name="branchId" id="filterBranch" class="form-select form-select-sm" data-selected-value="@(Model.BranchFilter?.ToString())"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Class / Grade</label>
                <select name="classId" id="filterClass" class="form-select form-select-sm" data-selected-value="@(Model.ClassFilter?.ToString())"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Academic Year</label>
                <select name="academicYearId" id="filterYear" class="form-select form-select-sm" data-selected-value="@(Model.AcademicYearFilter?.ToString())"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Status</label>
                <select name="status" id="filterStatus" class="form-select form-select-sm" data-selected-value="@(Model.StatusFilter)"></select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Application #</th>
                    <th>Applicant Name</th>
                    <th>Grade / Stream</th>
                    <th>Campus</th>
                    <th>Parent / Contact</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Applications)
                {
                    <tr id="aa-row-@a.AA_Id">
                        <td class="fw-bold">
                            <a asp-action="Details" asp-route-id="@a.AA_Id" class="text-primary text-decoration-none">
                                @a.AA_ApplicationNumber
                            </a>
                        </td>
                        <td>
                            <span class="fw-semibold d-block">@a.FullName</span>
                            <small class="text-muted"><i class="fa-solid fa-venus-mars me-1"></i>@(a.AA_Gender ?? "-")</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@(a.ClassName != "-" ? a.ClassName : a.CourseName)</span>
                            <small class="text-muted d-block">@a.AcademicYearName</small>
                        </td>
                        <td>@a.BranchName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(a.ParentName))
                            {
                                <span class="d-block small"><i class="fa-solid fa-user-tie me-1 text-muted"></i>@a.ParentName</span>
                            }
                            <small class="text-muted"><i class="fa-solid fa-phone me-1"></i>@(a.AA_Phone ?? "-")</small>
                        </td>
                        <td>
                            <span class="small">@(a.AA_SubmittedAt?.ToString("dd-MMM-yyyy") ?? "-")</span>
                        </td>
                        <td>
                            <span class="badge @StatusBadge(a.AA_Status) px-2 py-1">@a.AA_Status</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@a.AA_Id" class="btn btn-outline-info" title="View Application Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@a.AA_Id" class="btn btn-outline-primary" title="Edit Application">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <button class="btn btn-outline-danger aa-delete-btn" data-id="@a.AA_Id" title="Delete Application">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@functions { 
    string StatusBadge(string s) => s switch { 
        "Submitted" => "bg-info text-dark", 
        "UnderReview" => "bg-warning text-dark", 
        "Approved" => "bg-success text-white", 
        "Enrolled" => "bg-primary text-white",
        "Rejected" => "bg-danger text-white", 
        "Waitlisted" => "bg-secondary text-white", 
        _ => "bg-light text-dark" 
    }; 
}

@section Scripts {
<script>
$(function () {
    Dropdown.load({ element: '#filterBranch', entityType: 'Branch', defaultText: 'All Branches', includeDefault: true, selectedValue: $('#filterBranch').data('selected-value') });
    Dropdown.load({ element: '#filterClass', entityType: 'Class', defaultText: 'All Classes', includeDefault: true, selectedValue: $('#filterClass').data('selected-value') });
    Dropdown.load({ element: '#filterYear', entityType: 'AcademicYear', defaultText: 'All Years', includeDefault: true, selectedValue: $('#filterYear').data('selected-value') });
    Dropdown.load({ element: '#filterStatus', entityType: 'AdmissionStatus', defaultText: 'All Statuses', includeDefault: true, selectedValue: $('#filterStatus').data('selected-value') });

    $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [] });

    $(document).on("click", ".aa-delete-btn", function () {
        var id = $(this).data("id");
        var row = $(this).closest("tr");
        var applicantName = row.find("td:nth-child(2) span").text().trim();
        var label = applicantName ? `admission application for <strong>${applicantName}</strong>` : "this admission application";

        IMSConfirm.delete(`Are you sure you want to delete ${label}? This action cannot be undone.`, function (done) {
            $.ajax({ 
                url: "/AdmissionApplication/DeleteApplication/" + id, 
                type: "POST",
                data: { __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val() },
                success: function (r) { 
                    if (r.success) { 
                        if (window.toastr) toastr.success(r.message || "Application deleted."); 
                        $("#aa-row-" + id).fadeOut(300, function(){ $(this).remove(); }); 
                    } else { 
                        if (window.toastr) toastr.error(r.message || "Delete failed."); 
                    } 
                },
                error: function () { 
                    if (window.toastr) toastr.error("Request failed."); 
                },
                complete: function () {
                    done();
                }
            });
        });
    });
});
</script>
}
