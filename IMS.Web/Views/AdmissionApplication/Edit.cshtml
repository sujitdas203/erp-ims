@model IMS.Models.ViewModels.AdmissionApplicationFormViewModel
@{ ViewData["Title"] = "Edit Admission Application"; }

<style>
    .form-control.is-invalid, .form-select.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Admission Application</h4>
        <p class="text-muted small mb-0">Update application details for <strong>@Model.AA_ApplicationNumber</strong> (@Model.AA_FirstName @Model.AA_LastName)</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.AA_Id" class="btn btn-outline-info btn-sm me-1">
            <i class="fa-solid fa-eye me-1"></i> View Details
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form id="aaEditForm" asp-controller="AdmissionApplication" asp-action="EditApplication" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/common/datepicker.js"></script>
<script>
$(function () {
    IMSDatePicker.init({ input: '#AA_DateOfBirth', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY', allowFutureDates: false });

    Dropdown.load({ element: '#AA_BranchId', entityType: 'Branch', defaultText: '-- Select Branch --', includeDefault: true, selectedValue: $('#AA_BranchId').data('selected-value') });
    Dropdown.load({ element: '#AA_AcademicYearId', entityType: 'AcademicYear', defaultText: '-- Select Year --', includeDefault: true, selectedValue: $('#AA_AcademicYearId').data('selected-value') });
    Dropdown.load({ element: '#AA_ClassId', entityType: 'Class', defaultText: '-- Select Class --', includeDefault: true, selectedValue: $('#AA_ClassId').data('selected-value') });
    Dropdown.load({ element: '#AA_CourseId', entityType: 'Course', defaultText: '-- Select Course --', includeDefault: true, selectedValue: $('#AA_CourseId').data('selected-value') });
    Dropdown.load({ element: '#AA_FeeStructureId', entityType: 'FeeStructure', defaultText: '-- Select Fee Plan --', includeDefault: true, selectedValue: $('#AA_FeeStructureId').data('selected-value') });
    Dropdown.load({ element: '#AA_Gender', entityType: 'Gender', defaultText: '-- Select Gender --', includeDefault: true, selectedValue: $('#AA_Gender').data('selected-value') });
    Dropdown.load({ element: '#AA_BloodGroup', entityType: 'BloodGroup', defaultText: 'Not Known', includeDefault: true, selectedValue: $('#AA_BloodGroup').data('selected-value') });
    Dropdown.load({ element: '#AA_Category', entityType: 'Category', defaultText: '-- Select Category --', includeDefault: true, selectedValue: $('#AA_Category').data('selected-value') });
    Dropdown.load({ element: '#AA_Religion', entityType: 'Religion', defaultText: '-- Select Religion --', includeDefault: true, selectedValue: $('#AA_Religion').data('selected-value') });
    Dropdown.load({ element: '#AA_GuardianRelation', entityType: 'Relation', defaultText: '-- Select Relation --', includeDefault: true, selectedValue: $('#AA_GuardianRelation').data('selected-value') });
    Dropdown.load({ element: '#AA_Status', entityType: 'AdmissionStatus', defaultText: '-- Select Status --', includeDefault: false, selectedValue: $('#AA_Status').data('selected-value') });

    function clearValidationErrors($form) {
        $form.find(".is-invalid").removeClass("is-invalid");
        $form.find("span[asp-validation-for]").empty();
    }

    function applyFieldErrors($form, errors, defaultMsg) {
        clearValidationErrors($form);
        var firstEl = null;
        if (errors && typeof errors === "object") {
            $.each(errors, function (fieldKey, msgs) {
                var msg = Array.isArray(msgs) ? msgs.join(" ") : msgs;
                var $el = $form.find("[name='" + fieldKey + "'], #" + fieldKey + ", [name='AA_" + fieldKey + "'], [name$='." + fieldKey + "']").first();
                if ($el.length) {
                    $el.addClass("is-invalid");
                    var $valSpan = $form.find("span[asp-validation-for='" + fieldKey + "'], span[asp-validation-for='AA_" + fieldKey + "']").first();
                    if ($valSpan.length) {
                        $valSpan.text(msg).show();
                    }
                    if (!firstEl) firstEl = $el;
                }
            });
        }
        if (firstEl) {
            firstEl[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstEl.focus();
        }
    }

    $("#aaEditForm").on("input change", ".is-invalid", function () {
        $(this).removeClass("is-invalid");
        var name = $(this).attr("name") || $(this).attr("id");
        if (name) {
            $("span[asp-validation-for='" + name + "']").empty();
        }
    });

    $("#aaEditForm").on("submit", function (e) {
        e.preventDefault();
        var form = this;
        var $form = $(form);
        clearValidationErrors($form);

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        var formData = new FormData(form);
        var $btn = $form.find("button[type='submit']");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
        $.ajax({ 
            url: $form.attr("action"), 
            type: "POST", 
            data: formData,
            processData: false,
            contentType: false,
            success: function (r) { 
                if (r.success) { 
                    if (window.toastr) toastr.success(r.message || "Application updated successfully!"); 
                    else alert(r.message || "Application updated successfully!");
                    var redirectUrl = window.location.pathname.toLowerCase().indexOf("/admissionapplication") !== -1 ? "/AdmissionApplication" : "/Admission";
                    setTimeout(function(){ window.location.href = redirectUrl; }, 600); 
                } else { 
                    applyFieldErrors($form, r.errors, r.message);
                    if (window.toastr) toastr.error(r.message || "Please correct the highlighted fields."); 
                    else alert(r.message || "Please correct the highlighted fields.");
                    $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Application'); 
                } 
            },
            error: function (xhr) { 
                var resp = xhr.responseJSON;
                if (resp && resp.errors) {
                    applyFieldErrors($form, resp.errors, resp.message);
                }
                var msg = (resp && resp.message) ? resp.message : "Request failed. Please try again.";
                if (window.toastr) toastr.error(msg); 
                else alert(msg);
                $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Application'); 
            }
        });
    });
});
</script>
}
