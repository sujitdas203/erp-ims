                    <div class="mb-3">
                        <label class="form-label small fw-bold" id="uploadDocPrompt">Select File to Upload</label>
                        <input type="file" name="file" id="uploadDocFileInput" class="form-control" accept=".jpg,.jpeg,.png,.webp,.avif,.pdf" required />
                        <small class="text-muted d-block mt-1">Allowed formats: JPG, PNG, WEBP, AVIF, PDF (Max 5MB)</small>
                    </div>

                    <!-- Client Preview Area in Modal -->
                    <div id="uploadModalPreviewArea" class="rounded border p-2 text-center bg-light" style="display: none;">
                        <img id="uploadModalImgPreview" src="" alt="Preview" class="img-fluid rounded" style="max-height: 160px; object-fit: contain; display: none;" />
                        <div id="uploadModalFilePreview" class="py-3 text-muted small" style="display: none;">
                            <i class="fa-solid fa-file-pdf text-danger fs-1 d-block mb-1"></i>
                            <span id="uploadModalFileName" class="fw-bold text-dark"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4" id="btnConfirmUpload">
                        <i class="fa-solid fa-upload me-1"></i> Upload File
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@functions { 
    bool IsImgUrl(string url) {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var clean = url.Split('?')[0].ToLowerInvariant();
        return clean.EndsWith(".jpg") || clean.EndsWith(".jpeg") || clean.EndsWith(".png") || clean.EndsWith(".webp") || clean.EndsWith(".avif") || clean.EndsWith(".gif");
    }
    bool IsPdfUrl(string url) {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var clean = url.Split('?')[0].ToLowerInvariant();
        return clean.EndsWith(".pdf");
    }
    string StatusBadge(string s) => s switch { 
        "Submitted" => "bg-info text-dark", 
        "UnderReview" => "bg-warning text-dark", 
        "Approved" => "bg-success text-white", 
        "Enrolled" => "bg-primary text-white",
        "Rejected" => "bg-danger text-white", 
        "Waitlisted" => "bg-secondary text-white", 
        _ => "bg-light text-dark" 
    }; 
}

@section Scripts {
<script>
function openDocPreview(url, title, type) {
    if (!url) return;
    $("#docPreviewModalLabel").text(title || "Document Preview");
    $("#btnDocDownload").attr("href", url);

    if (type === "pdf" || url.toLowerCase().indexOf(".pdf") !== -1) {
        $("#docPreviewIcon").attr("class", "fa-solid fa-file-pdf text-danger fs-5");
        $("#imgPreviewContainer").hide();
        $("#pdfPreviewFrame").attr("src", url);
        $("#pdfPreviewContainer").show();
    } else {
        $("#docPreviewIcon").attr("class", "fa-solid fa-image text-primary fs-5");
        $("#pdfPreviewContainer").hide();
        $("#pdfPreviewFrame").attr("src", "");
        $("#imgPreviewSrc").attr("src", url);
        $("#imgPreviewContainer").show();
    }

    var modal = new bootstrap.Modal(document.getElementById("docPreviewModal"));
    modal.show();
}

function openUploadModal(docType, docTitle) {
    $("#uploadDocType").val(docType);
    $("#uploadDocModalLabel").html('<i class="fa-solid fa-cloud-arrow-up me-2"></i>Upload ' + docTitle);
    $("#uploadDocPrompt").text('Select ' + docTitle + ' to Upload');
    $("#uploadDocFileInput").val('');
    $("#uploadModalPreviewArea").hide();
    $("#uploadModalImgPreview").hide().attr("src", "");
    $("#uploadModalFilePreview").hide();
    
    if (docType === "photo") {
        $("#uploadDocFileInput").attr("accept", "image/*");
    } else {
        $("#uploadDocFileInput").attr("accept", ".jpg,.jpeg,.png,.webp,.avif,.pdf");
    }

    var modal = new bootstrap.Modal(document.getElementById("uploadDocModal"));
    modal.show();
}

$(function () {
    Dropdown.load({ element: '#review_AA_Status', entityType: 'AdmissionReviewDecision', defaultText: '-- Select Decision --', includeDefault: false, selectedValue: $('#review_AA_Status').data('selected-value') });
    
    // Enroll Modal Dropdowns
    Dropdown.load({ element: '#enroll_ClassId', entityType: 'Class', defaultText: '-- Select Class --', includeDefault: true, selectedValue: $('#enroll_ClassId').data('selected-value') });
    Dropdown.load({ element: '#enroll_SectionId', entityType: 'Section', defaultText: '-- Select Section --', includeDefault: true });
    Dropdown.load({ element: '#enroll_BatchId', entityType: 'Batch', defaultText: '-- Select Batch --', includeDefault: true });
    Dropdown.load({ element: '#enroll_FeeStructureId', entityType: 'FeeStructure', defaultText: '-- Select Fee Plan --', includeDefault: true, selectedValue: $('#enroll_FeeStructureId').data('selected-value') });

    // File input preview inside Upload Modal
    $("#uploadDocFileInput").on("change", function () {
        var file = this.files && this.files[0];
        if (!file) {
            $("#uploadModalPreviewArea").hide();
            return;
        }

        $("#uploadModalPreviewArea").show();
        if (file.type && file.type.startsWith("image/")) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#uploadModalFilePreview").hide();
                $("#uploadModalImgPreview").attr("src", e.target.result).show();
            };
            reader.readAsDataURL(file);
        } else {
            $("#uploadModalImgPreview").hide();
            $("#uploadModalFileName").text(file.name + " (" + (file.size / 1024).toFixed(1) + " KB)");
            $("#uploadModalFilePreview").show();
        }
    });

    // Upload Document Form Submit
    $("#uploadDocForm").on("submit", function (e) {
        e.preventDefault();
        var form = this;
        var formData = new FormData(form);
        var $btn = $("#btnConfirmUpload");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Uploading...');

        $.ajax({
            url: "/AdmissionApplication/UploadAttachment",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                "RequestVerificationToken": $("input[name='__RequestVerificationToken']").val()
            },
            success: function (r) {
                if (r.success) {
                    if (window.toastr) toastr.success(r.message || "Document uploaded successfully!");
                    else alert(r.message || "Document uploaded successfully!");
                    setTimeout(function () { location.reload(); }, 600);
                } else {
                    if (window.toastr) toastr.error(r.message || "Upload failed.");
                    else alert(r.message || "Upload failed.");
                    $btn.prop("disabled", false).html('<i class="fa-solid fa-upload me-1"></i> Upload File');
                }
            },
            error: function (xhr) {
                var resp = xhr.responseJSON;
                var msg = (resp && resp.message) ? resp.message : "Upload request failed.";
                if (window.toastr) toastr.error(msg);
                else alert(msg);
                $btn.prop("disabled", false).html('<i class="fa-solid fa-upload me-1"></i> Upload File');
            }
        });
    });

    $("#reviewForm").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this), $btn = $form.find("button[type='submit']");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Updating...');
        $.ajax({ 
            url: "/AdmissionApplication/Review", 
            type: "POST", 
            data: $form.serialize() + "&__RequestVerificationToken=" + $("input[name='__RequestVerificationToken']").val(),
            success: function (r) { 
                if (r.success) { 
                    if (window.toastr) toastr.success(r.message); 
                    setTimeout(function(){ location.reload(); }, 800); 
                } else { 
                    if (window.toastr) toastr.error(r.message); 
                    $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Review Decision'); 
                } 
            },
            error: function () { 
                if (window.toastr) toastr.error("Review update failed."); 
                $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Review Decision'); 
            }
        });
    });

    $("#enrollForm").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this), $btn = $("#btnConfirmEnroll");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Enrolling...');
        $.ajax({
            url: "/AdmissionApplication/Enroll",
            type: "POST",
            data: $form.serialize() + "&__RequestVerificationToken=" + $("input[name='__RequestVerificationToken']").val(),
            success: function (r) {
                if (r.success) {
                    if (window.toastr) toastr.success(r.message); 
                    setTimeout(function () { location.reload(); }, 900);
                } else {
                    if (window.toastr) toastr.error(r.message); 
                    $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Confirm & Enroll');
                }
            },
            error: function () {
                if (window.toastr) toastr.error("Enrollment failed. Please try again.");
                $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Confirm & Enroll');
            }
        });
    });
});
</script>
}
