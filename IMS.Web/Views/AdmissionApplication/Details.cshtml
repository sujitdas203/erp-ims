<!-- Document & Photo Preview Modal (Universal Lightbox & Embedded PDF Viewer) -->
<div class="modal fade" id="docPreviewModal" tabindex="-1" aria-labelledby="docPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-lines text-primary fs-5" id="docPreviewIcon"></i>
                    <h5 class="modal-title fw-bold mb-0 text-white" id="docPreviewModalLabel">Document Preview</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a id="btnDocDownload" href="#" download target="_blank" class="btn btn-outline-light btn-sm">
                        <i class="fa-solid fa-download me-1"></i> Download / Open Full
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
