@model IMS.Models.ViewModels.AdmissionApplicationFormViewModel
@{
    ViewData["Title"] = "Online Admission Application";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

@section Styles {
    <!-- Transfer Certificate Design Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        .admission-page {
            background: var(--parchment-dim, #f8fafc);
            min-height: 85vh;
            padding: 2.5rem 0 4rem 0;
        }

        /* Stepper Navigation */
        .stepper-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            margin-bottom: 2rem;
            padding: 0.5rem 0;
            gap: 0.5rem;
        }

        .stepper-nav::before {
            content: '';
            position: absolute;
            top: 28px;
            left: 5%;
            right: 5%;
            height: 3px;
            background: #e2e8f0;
            z-index: 1;
        }

        .step-item {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            cursor: pointer;
            text-align: center;
            transition: all 0.3s ease;
            min-width: 90px;
        }

        .step-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #ffffff;
            border: 2px solid #cbd5e1;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .step-label {
            margin-top: 0.5rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: #64748b;
            transition: all 0.3s ease;
            line-height: 1.2;
        }

        /* Stepper Active State */
        .step-item.active .step-icon {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border-color: #2563eb;
            color: #ffffff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.2);
            transform: scale(1.08);
        }

        .step-item.active .step-label {
            color: #1e293b;
            font-weight: 700;
        }

        /* Stepper Completed State */
        .step-item.completed .step-icon {
            background: #10b981;
            border-color: #10b981;
            color: #ffffff;
        }

        .step-item.completed .step-label {
            color: #059669;
        }

        /* Form Steps Animation */
        .form-step {
            display: none;
        }

        .form-step.active-step {
            display: block;
            animation: fadeInStep 0.35s ease-in-out forwards;
        }

        @@keyframes fadeInStep {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Custom Input Validation Styling */
        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #ef4444 !important;
            background-image: none !important;
            box-shadow: 0 0 0 0.2rem rgba(239, 68, 68, 0.15) !important;
        }

        .form-control.is-valid, .form-select.is-valid {
            border-color: #10b981 !important;
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.12) !important;
        }

        .invalid-feedback-custom {
            color: #dc2626;
            font-size: 0.8rem;
            font-weight: 500;
            margin-top: 0.3rem;
            display: none;
        }

        .invalid-feedback-custom.d-block {
            display: block;
        }

        /* Step Banners */
        .step-banner {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border-left: 4px solid #2563eb;
            padding: 1rem 1.25rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
        }

        /* Section-Wise Admission Form Preview Design System */
        .form-preview-sheet {
            width: 100%;
            background: #ffffff;
            padding: 24px 28px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            position: relative;
            border: 2px solid #1e3a8a;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #1e293b;
        }

        .prev-header-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 12px;
            margin-bottom: 14px;
        }

        .prev-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .prev-logo-icon {
            width: 52px;
            height: 52px;
            background: #eff6ff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #1e3a8a;
            color: #1e3a8a;
            font-size: 24px;
        }

        .prev-org-name {
            font-size: 18px;
            font-weight: 800;
            color: #1e3a8a;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            line-height: 1.2;
        }

        .prev-org-sub {
            font-size: 11px;
            color: #64748b;
            font-weight: 500;
        }

        .prev-badge-title {
            background: #1e3a8a;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Top Applicant Summary Card */
        .prev-applicant-card {
            background: linear-gradient(135deg, #f8fafc, #eff6ff);
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .prev-applicant-info {
            flex: 1;
        }

        .prev-applicant-name {
            font-size: 16px;
            font-weight: 800;
            color: #1e3a8a;
            text-transform: uppercase;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }

        .prev-applicant-meta {
            font-size: 11.5px;
            color: #475569;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .prev-applicant-photo-box {
            width: 75px;
            height: 90px;
            border: 2px solid #cbd5e1;
            border-radius: 6px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            flex-shrink: 0;
            margin-left: 16px;
        }

        .prev-applicant-photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Section Boxes */
        .prev-section {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            margin-bottom: 12px;
            overflow: hidden;
            background: #ffffff;
        }

        .prev-section-header {
            background: linear-gradient(135deg, #1e3a8a, #1d4ed8);
            color: #ffffff;
            padding: 6px 12px;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .prev-section-header i {
            font-size: 13px;
        }

        .prev-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
        }

        .prev-table tr {
            border-bottom: 1px solid #f1f5f9;
        }

        .prev-table tr:last-child {
            border-bottom: none;
        }

        .prev-table td {
            padding: 6px 10px;
            vertical-align: middle;
        }

        .prev-table td.lbl {
            width: 25%;
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-right: 1px solid #f1f5f9;
        }

        .prev-table td.val {
            width: 25%;
            color: #0f172a;
            font-weight: 600;
        }

        .prev-table td.lbl-wide {
            width: 20%;
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-right: 1px solid #f1f5f9;
        }

        .prev-table td.val-wide {
            width: 80%;
            color: #0f172a;
            font-weight: 600;
        }

        /* Declaration & Signatures */
        .prev-declaration {
            font-size: 10.5px;
            color: #475569;
            line-height: 1.4;
            padding: 8px 12px;
            background: #f8fafc;
            border-left: 3px solid #1e3a8a;
            border-radius: 0 4px 4px 0;
            margin: 10px 0;
        }

        .prev-signatures {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding-top: 14px;
            margin-top: 6px;
        }

        .prev-sig-box {
            text-align: center;
            width: 160px;
        }

        .prev-sig-line {
            border-top: 1.5px solid #334155;
            margin-bottom: 4px;
        }

        .prev-sig-title {
            font-size: 10.5px;
            font-weight: 700;
            color: #1e3a8a;
            text-transform: uppercase;
        }

        .prev-sig-sub {
            font-size: 9.5px;
            color: #64748b;
        }

        .prev-seal-box {
            width: 90px;
            height: 50px;
            border: 1.5px dashed #94a3b8;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            font-size: 8.5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Print Media Formatting */
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 5mm 8mm;
            }
            html, body {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
                font-size: 8pt !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            header, footer, nav, .site-header, .site-footer, .admission-page > .container > div:not(#previewAppModal), .modal-header, .modal-footer, .btn, .btn-close, .modal-backdrop, .invalid-feedback-custom {
                display: none !important;
            }
            .modal {
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                height: auto !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: visible !important;
                display: block !important;
                background: none !important;
                border: none !important;
            }
            .modal-dialog {
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                display: block !important;
                min-height: 0 !important;
                height: auto !important;
                transform: none !important;
            }
            .modal-content, .modal-body {
                position: static !important;
                border: none !important;
                box-shadow: none !important;
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
                height: auto !important;
                display: block !important;
            }
            #printableDraftApplication {
                max-width: 100% !important;
                width: 100% !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 10px 14px !important;
                border: 2px solid #1e3a8a !important;
                background: #ffffff !important;
            }
            .prev-section {
                margin-bottom: 8px !important;
                page-break-inside: avoid !important;
            }
            .prev-section-header {
                padding: 4px 8px !important;
                font-size: 8.5pt !important;
                background: #1e3a8a !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .prev-table {
                font-size: 7.5pt !important;
            }
            .prev-table td {
                padding: 2.5px 6px !important;
            }
            .prev-applicant-card {
                padding: 8px 12px !important;
                margin-bottom: 10px !important;
                border: 1px solid #bfdbfe !important;
                background: #eff6ff !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .prev-applicant-photo-box {
                width: 65px !important;
                height: 80px !important;
            }
            .prev-declaration {
                font-size: 7.5pt !important;
                margin: 6px 0 !important;
                padding: 4px 8px !important;
            }
            .prev-signatures {
                padding-top: 6px !important;
                margin-top: 4px !important;
                page-break-inside: avoid !important;
            }
        }

        /* Mobile Adjustments */
        @@media (max-width: 768px) {
            .stepper-nav {
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 0.75rem;
            }
            .stepper-nav::before {
                display: none;
            }
            .step-item {
                min-width: 80px;
            }
            .step-icon {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
            .step-label {
                font-size: 0.7rem;
            }
        }
    </style>
}

<div class="admission-page">
    <div class="container-fluid">

        <!-- Header Banner -->
        <div class="text-center mb-4">
            <span class="badge rounded-pill px-3 py-2 text-uppercase mb-2 shadow-sm" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color:#ffffff; font-size:0.75rem; letter-spacing:1px;">
                <i class="bi bi-stars me-1"></i> Academic Session 2026-2027
            </span>
            <h1 class="fw-bold text-dark mb-2" style="font-family: 'Fraunces', serif;">Online Admission Application</h1>
            <p class="text-muted mx-auto mb-0" style="max-width: 650px;">
                Complete the step-by-step application form below. Your application reference number will be generated immediately for live tracking.
            </p>
        </div>

        @if (TempData["AdmissionSuccess"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 mb-4 text-center">
                <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                <h4 class="fw-bold">Application Submitted Successfully!</h4>
                <p class="mb-0">@TempData["AdmissionSuccess"]</p>
                <div class="mt-3">
                    <a href="/" class="btn btn-primary rounded-pill px-4">Back to Home</a>
                </div>
            </div>
        }

        <!-- Stepper Navigation Wrapper -->
        <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4" style="background:#ffffff; border:1px solid #e2e8f0;">
            <!-- Progress Bar & Indicator -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-bold rounded-pill px-3 py-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    Step <span id="currentStepNum">1</span> of 6
                </span>
                <span class="small fw-semibold text-muted" id="stepProgressPercent">17% Completed</span>
            </div>
            <div class="progress rounded-pill mb-3" style="height: 8px; background-color: #f1f5f9;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary rounded-pill" id="admissionProgressBar" role="progressbar" style="width: 16.66%;"></div>
            </div>

            <!-- Stepper Items -->
            <div class="stepper-nav">
                <div class="step-item active" data-step="1" onclick="handleStepNavClick(1)">
                    <div class="step-icon" id="step-icon-1"><i class="bi bi-mortarboard-fill"></i></div>
                    <div class="step-label">1. Campus</div>
                </div>
                <div class="step-item" data-step="2" onclick="handleStepNavClick(2)">
                    <div class="step-icon" id="step-icon-2"><i class="bi bi-person-badge-fill"></i></div>
                    <div class="step-label">2. Student</div>
                </div>
                <div class="step-item" data-step="3" onclick="handleStepNavClick(3)">
                    <div class="step-icon" id="step-icon-3"><i class="bi bi-people-fill"></i></div>
                    <div class="step-label">3. Parents</div>
                </div>
                <div class="step-item" data-step="4" onclick="handleStepNavClick(4)">
                    <div class="step-icon" id="step-icon-4"><i class="bi bi-geo-alt-fill"></i></div>
                    <div class="step-label">4. Address</div>
                </div>
                <div class="step-item" data-step="5" onclick="handleStepNavClick(5)">
                    <div class="step-icon" id="step-icon-5"><i class="bi bi-file-earmark-arrow-up-fill"></i></div>
                    <div class="step-label">5. Documents</div>
                </div>
                <div class="step-item" data-step="6" onclick="handleStepNavClick(6)">
                    <div class="step-icon" id="step-icon-6"><i class="bi bi-check2-circle"></i></div>
                    <div class="step-label">6. Review</div>
                </div>
            </div>
        </div>

        <!-- Application Main Form Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background:#ffffff; border:1px solid #e2e8f0;">
            <div class="card-header border-0 py-3 px-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); color:#ffffff;">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-semibold" id="formHeaderTitle"><i class="bi bi-mortarboard me-2"></i>Academic &amp; Campus Preference</span>
                    <span class="badge bg-light text-dark fw-bold">Online Admission Portal</span>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-controller="Home" asp-action="ApplyAdmission" method="post" enctype="multipart/form-data" id="admissionForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                    <!-- ========================================== -->
                    <!-- STEP 1: Academic & Campus Preference -->
                    <!-- ========================================== -->
                    <div class="form-step active-step" id="step-1">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle-fill text-primary me-2"></i>Campus &amp; Program Selection</h6>
                            <small class="text-muted">Select your target campus branch and academic year to begin your application process.</small>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AA_BranchId" class="form-label fw-semibold small text-dark">Preferred Campus / Branch <span class="text-danger">*</span></label>
                                <select asp-for="AA_BranchId" id="AA_BranchId" class="form-select rounded-3 py-2" required>
                                </select>
                                <div class="invalid-feedback-custom" id="err_AA_BranchId">Please select a preferred campus branch.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_AcademicYearId" class="form-label fw-semibold small text-dark">Academic Session / Year <span class="text-danger">*</span></label>
                                <select asp-for="AA_AcademicYearId" id="AA_AcademicYearId" class="form-select rounded-3 py-2" required>
                                </select>
                                <div class="invalid-feedback-custom" id="err_AA_AcademicYearId">Please select an academic session.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_ClassId" class="form-label fw-semibold small text-dark">Applying For Grade / Class</label>
                                <select asp-for="AA_ClassId" id="AA_ClassId" class="form-select rounded-3 py-2">
                                </select>
                                <span class="text-muted small">Select class for school level admissions</span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_CourseId" class="form-label fw-semibold small text-dark">Stream / Course</label>
                                <select asp-for="AA_CourseId" id="AA_CourseId" class="form-select rounded-3 py-2">
                                </select>
                                <span class="text-muted small">Select stream/course for higher education</span>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEP 2: Student Personal Details & Photo -->
                    <!-- ========================================== -->
                    <div class="form-step" id="step-2">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-person-badge-fill text-primary me-2"></i>Student Information &amp; Photograph</h6>
                            <small class="text-muted">Enter student's legal personal details as recorded in official identification documents.</small>
                        </div>

                        <div class="row g-4">
                            <!-- Photo Preview Box -->
                            <div class="col-md-3 text-center border-end pe-md-4">
                                <label class="form-label fw-semibold small text-dark d-block text-start mb-2">Passport Size Photo</label>
                                <div class="position-relative d-inline-block mb-2">
                                    <img id="pubPhotoPreview" 
                                         src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='130' height='150' viewBox='0 0 24 24' fill='%2394a3b8'><path d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>" 
                                         alt="Student Photo" 
                                         class="rounded-3 shadow-sm border img-thumbnail" 
                                         style="width: 130px; height: 150px; object-fit: cover; background: #f8fafc;" />
                                </div>
                                <input type="file" name="StudentPhoto" id="StudentPhoto" class="form-control form-control-sm" accept="image/jpeg,image/png,image/jpg" onchange="previewPublicPhoto(this)" />
                                <small class="text-muted d-block mt-1">JPG/PNG max 2MB</small>
                                <div class="invalid-feedback-custom" id="err_StudentPhoto">Photo size must be less than 2MB.</div>
                            </div>

                            <!-- Personal Details Fields -->
                            <div class="col-md-9">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="AA_FirstName" class="form-label fw-semibold small text-dark">First Name <span class="text-danger">*</span></label>
                                        <input asp-for="AA_FirstName" id="AA_FirstName" class="form-control rounded-3 py-2" placeholder="e.g. Rahul" required />
                                        <div class="invalid-feedback-custom" id="err_AA_FirstName">First name is required.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_MiddleName" class="form-label fw-semibold small text-dark">Middle Name</label>
                                        <input asp-for="AA_MiddleName" id="AA_MiddleName" class="form-control rounded-3 py-2" placeholder="e.g. Kumar" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_LastName" class="form-label fw-semibold small text-dark">Last Name <span class="text-danger">*</span></label>
                                        <input asp-for="AA_LastName" id="AA_LastName" class="form-control rounded-3 py-2" placeholder="e.g. Sharma" required />
                                        <div class="invalid-feedback-custom" id="err_AA_LastName">Last name is required.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_DateOfBirth" class="form-label fw-semibold small text-dark">Date of Birth</label>
                                        <input asp-for="AA_DateOfBirth" id="AA_DateOfBirth" type="date" class="form-control rounded-3 py-2" />
                                        <div class="invalid-feedback-custom" id="err_AA_DateOfBirth">Please enter a valid date of birth.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Gender" class="form-label fw-semibold small text-dark">Gender</label>
                                        <select asp-for="AA_Gender" id="AA_Gender" class="form-select rounded-3 py-2">
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_BloodGroup" class="form-label fw-semibold small text-dark">Blood Group</label>
                                        <select asp-for="AA_BloodGroup" id="AA_BloodGroup" class="form-select rounded-3 py-2">
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Category" class="form-label fw-semibold small text-dark">Category / Quota</label>
                                        <select asp-for="AA_Category" id="AA_Category" class="form-select rounded-3 py-2">
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Nationality" class="form-label fw-semibold small text-dark">Nationality</label>
                                        <input asp-for="AA_Nationality" id="AA_Nationality" class="form-control rounded-3 py-2" placeholder="e.g. Indian" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Religion" class="form-label fw-semibold small text-dark">Religion</label>
                                        <input asp-for="AA_Religion" id="AA_Religion" class="form-control rounded-3 py-2" placeholder="e.g. Hindu / Muslim / Christian" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Phone" class="form-label fw-semibold small text-dark">Student Mobile Number <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted fw-semibold">+91</span>
                                            <input asp-for="AA_Phone" id="AA_Phone" class="form-control rounded-end-3 py-2" placeholder="10-digit mobile number" maxlength="10" required />
                                        </div>
                                        <div class="invalid-feedback-custom" id="err_AA_Phone">Valid 10-digit mobile number is required (starting with 6-9).</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Email" class="form-label fw-semibold small text-dark">Student Email Address</label>
                                        <input asp-for="AA_Email" id="AA_Email" type="email" class="form-control rounded-3 py-2" placeholder="student@example.com" />
                                        <div class="invalid-feedback-custom" id="err_AA_Email">Please enter a valid email address.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_AadhaarNumber" class="form-label fw-semibold small text-dark">Aadhaar / National ID</label>
                                        <input asp-for="AA_AadhaarNumber" id="AA_AadhaarNumber" class="form-control rounded-3 py-2" placeholder="12-digit Aadhaar number" maxlength="12" />
                                        <div class="invalid-feedback-custom" id="err_AA_AadhaarNumber">Aadhaar number must be exactly 12 digits.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEP 3: Parents & Guardian Information -->
                    <!-- ========================================== -->
                    <div class="form-step" id="step-3">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Parents &amp; Guardian Information</h6>
                            <small class="text-muted">Provide contact details of parents or legal guardians for official communication.</small>
                        </div>

                        <!-- Father's Details Card -->
                        <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-fill me-1"></i>Father's Details</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="AA_FatherName" class="form-label fw-semibold small text-dark">Father's Full Name</label>
                                    <input asp-for="AA_FatherName" id="AA_FatherName" class="form-control rounded-3 py-2" placeholder="Father's full name" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_FatherPhone" class="form-label fw-semibold small text-dark">Father's Mobile</label>
                                    <input asp-for="AA_FatherPhone" id="AA_FatherPhone" class="form-control rounded-3 py-2" placeholder="10-digit mobile number" maxlength="10" />
                                    <div class="invalid-feedback-custom" id="err_AA_FatherPhone">Enter a valid 10-digit mobile number.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_FatherEmail" class="form-label fw-semibold small text-dark">Father's Email</label>
                                    <input asp-for="AA_FatherEmail" id="AA_FatherEmail" type="email" class="form-control rounded-3 py-2" placeholder="father@example.com" />
                                    <div class="invalid-feedback-custom" id="err_AA_FatherEmail">Enter a valid email address.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_FatherOccupation" class="form-label fw-semibold small text-dark">Occupation</label>
                                    <input asp-for="AA_FatherOccupation" id="AA_FatherOccupation" class="form-control rounded-3 py-2" placeholder="e.g. Business / Service" />
                                </div>
                            </div>
                        </div>

                        <!-- Mother's Details Card -->
                        <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-fill me-1"></i>Mother's Details</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="AA_MotherName" class="form-label fw-semibold small text-dark">Mother's Full Name</label>
                                    <input asp-for="AA_MotherName" id="AA_MotherName" class="form-control rounded-3 py-2" placeholder="Mother's full name" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_MotherPhone" class="form-label fw-semibold small text-dark">Mother's Mobile</label>
                                    <input asp-for="AA_MotherPhone" id="AA_MotherPhone" class="form-control rounded-3 py-2" placeholder="10-digit mobile number" maxlength="10" />
                                    <div class="invalid-feedback-custom" id="err_AA_MotherPhone">Enter a valid 10-digit mobile number.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_MotherEmail" class="form-label fw-semibold small text-dark">Mother's Email</label>
                                    <input asp-for="AA_MotherEmail" id="AA_MotherEmail" type="email" class="form-control rounded-3 py-2" placeholder="mother@example.com" />
                                    <div class="invalid-feedback-custom" id="err_AA_MotherEmail">Enter a valid email address.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_MotherOccupation" class="form-label fw-semibold small text-dark">Occupation</label>
                                    <input asp-for="AA_MotherOccupation" id="AA_MotherOccupation" class="form-control rounded-3 py-2" placeholder="e.g. Homemaker / Teacher" />
                                </div>
                            </div>
                        </div>

                        <!-- Guardian Details Card (Optional) -->
                        <div class="card border rounded-3 p-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-shield-person me-1"></i>Legal Guardian Details (Optional)</h6>
                                <small class="text-muted">Fill if applicant lives with a legal guardian</small>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="AA_GuardianName" class="form-label fw-semibold small text-dark">Guardian Name</label>
                                    <input asp-for="AA_GuardianName" id="AA_GuardianName" class="form-control rounded-3 py-2" placeholder="Guardian's name" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_GuardianRelation" class="form-label fw-semibold small text-dark">Relation with Student</label>
                                    <input asp-for="AA_GuardianRelation" id="AA_GuardianRelation" class="form-control rounded-3 py-2" placeholder="e.g. Uncle / Grandfather" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_GuardianPhone" class="form-label fw-semibold small text-dark">Guardian Mobile</label>
                                    <input asp-for="AA_GuardianPhone" id="AA_GuardianPhone" class="form-control rounded-3 py-2" placeholder="10-digit mobile number" maxlength="10" />
                                    <div class="invalid-feedback-custom" id="err_AA_GuardianPhone">Enter a valid 10-digit mobile number.</div>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AA_GuardianEmail" class="form-label fw-semibold small text-dark">Guardian Email</label>
                                    <input asp-for="AA_GuardianEmail" id="AA_GuardianEmail" type="email" class="form-control rounded-3 py-2" placeholder="guardian@example.com" />
                                    <div class="invalid-feedback-custom" id="err_AA_GuardianEmail">Enter a valid email address.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEP 4: Residential Address & Emergency -->
                    <!-- ========================================== -->
                    <div class="form-step" id="step-4">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Residential Address &amp; Emergency Contact</h6>
                            <small class="text-muted">Enter current postal residential address and emergency contact person details.</small>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="AA_AddressLine1" class="form-label fw-semibold small text-dark">Address Line 1 (House / Flat No, Street)</label>
                                <input asp-for="AA_AddressLine1" id="AA_AddressLine1" class="form-control rounded-3 py-2" placeholder="Flat / House No, Street name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_AddressLine2" class="form-label fw-semibold small text-dark">Address Line 2 (Locality / Landmark)</label>
                                <input asp-for="AA_AddressLine2" id="AA_AddressLine2" class="form-control rounded-3 py-2" placeholder="Area, Landmark" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_City" class="form-label fw-semibold small text-dark">City / District</label>
                                <input asp-for="AA_City" id="AA_City" class="form-control rounded-3 py-2" placeholder="City name" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_State" class="form-label fw-semibold small text-dark">State</label>
                                <input asp-for="AA_State" id="AA_State" class="form-control rounded-3 py-2" placeholder="State name" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_PostalCode" class="form-label fw-semibold small text-dark">PIN Code / Postal Code</label>
                                <input asp-for="AA_PostalCode" id="AA_PostalCode" class="form-control rounded-3 py-2" placeholder="6-digit PIN code" maxlength="6" />
                                <div class="invalid-feedback-custom" id="err_AA_PostalCode">PIN code must be exactly 6 digits.</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_Country" class="form-label fw-semibold small text-dark">Country</label>
                                <input asp-for="AA_Country" id="AA_Country" class="form-control rounded-3 py-2" placeholder="India" />
                            </div>
                        </div>

                        <!-- Emergency Contact -->
                        <div class="card border rounded-3 p-3 bg-light-subtle">
                            <h6 class="fw-bold text-danger mb-3"><i class="bi bi-telephone-plus-fill me-2"></i>Emergency Contact Person</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="AA_EmergencyContactName" class="form-label fw-semibold small text-dark">Emergency Contact Name</label>
                                    <input asp-for="AA_EmergencyContactName" id="AA_EmergencyContactName" class="form-control rounded-3 py-2" placeholder="Person to contact in emergency" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AA_EmergencyContactPhone" class="form-label fw-semibold small text-dark">Emergency Phone Number</label>
                                    <input asp-for="AA_EmergencyContactPhone" id="AA_EmergencyContactPhone" class="form-control rounded-3 py-2" placeholder="10-digit emergency contact phone" maxlength="10" />
                                    <div class="invalid-feedback-custom" id="err_AA_EmergencyContactPhone">Enter a valid 10-digit phone number.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEP 5: Academic Record & Documents Upload -->
                    <!-- ========================================== -->
                    <div class="form-step" id="step-5">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-building-fill-add text-primary me-2"></i>Previous Academic Record &amp; Documents</h6>
                            <small class="text-muted">Enter details of previous school/institute and upload scanned copies of certificates.</small>
                        </div>

                        <!-- Previous School -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousSchool" class="form-label fw-semibold small text-dark">Previous School / Institute</label>
                                <input asp-for="AA_PreviousSchool" id="AA_PreviousSchool" class="form-control rounded-3 py-2" placeholder="Name of previous school" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousBoard" class="form-label fw-semibold small text-dark">Board (CBSE / ICSE / State)</label>
                                <input asp-for="AA_PreviousBoard" id="AA_PreviousBoard" class="form-control rounded-3 py-2" placeholder="e.g. CBSE / State Board" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousMarks" class="form-label fw-semibold small text-dark">Previous Grade / Marks (%)</label>
                                <input asp-for="AA_PreviousMarks" id="AA_PreviousMarks" class="form-control rounded-3 py-2" placeholder="e.g. 88.5% or Grade A" />
                            </div>
                        </div>

                        <!-- Document Upload Grid -->
                        <div class="card border rounded-3 p-3 bg-light-subtle">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-paperclip text-primary me-2"></i>Upload Supporting Certificates &amp; Documents</h6>
                            <small class="text-muted d-block mb-3">Allowed formats: PDF, JPG, PNG (Max 5MB per document)</small>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 bg-white">
                                        <label class="form-label fw-semibold small text-dark mb-1"><i class="bi bi-file-earmark-pdf text-danger me-1"></i>Birth Certificate</label>
                                        <input type="file" name="BirthCertificateDoc" id="BirthCertificateDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/jpeg,image/png,image/jpg" onchange="validateFileSize(this, 5)" />
                                        <div class="invalid-feedback-custom" id="err_BirthCertificateDoc">File size must be under 5MB (PDF/JPG/PNG).</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 bg-white">
                                        <label class="form-label fw-semibold small text-dark mb-1"><i class="bi bi-file-earmark-text text-primary me-1"></i>Previous Marksheet / Transcript</label>
                                        <input type="file" name="MarksheetDoc" id="MarksheetDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/jpeg,image/png,image/jpg" onchange="validateFileSize(this, 5)" />
                                        <div class="invalid-feedback-custom" id="err_MarksheetDoc">File size must be under 5MB (PDF/JPG/PNG).</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 bg-white">
                                        <label class="form-label fw-semibold small text-dark mb-1"><i class="bi bi-journal-check text-success me-1"></i>Transfer Certificate (TC) / Migration</label>
                                        <input type="file" name="TransferCertificateDoc" id="TransferCertificateDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/jpeg,image/png,image/jpg" onchange="validateFileSize(this, 5)" />
                                        <div class="invalid-feedback-custom" id="err_TransferCertificateDoc">File size must be under 5MB (PDF/JPG/PNG).</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 bg-white">
                                        <label class="form-label fw-semibold small text-dark mb-1"><i class="bi bi-card-heading text-warning me-1"></i>Aadhaar / National ID Proof</label>
                                        <input type="file" name="NationalIdDoc" id="NationalIdDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/jpeg,image/png,image/jpg" onchange="validateFileSize(this, 5)" />
                                        <div class="invalid-feedback-custom" id="err_NationalIdDoc">File size must be under 5MB (PDF/JPG/PNG).</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEP 6: Facilities, Preferences & Review -->
                    <!-- ========================================== -->
                    <div class="form-step" id="step-6">
                        <div class="step-banner">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-sliders2 text-primary me-2"></i>Facilities &amp; Final Application Review</h6>
                            <small class="text-muted">Select optional campus facilities and double-check your application details before final submission.</small>
                        </div>

                        <!-- Facilities Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="AA_SecondLanguage" class="form-label fw-semibold small text-dark">Second Language Preference</label>
                                <input asp-for="AA_SecondLanguage" id="AA_SecondLanguage" class="form-control rounded-3 py-2" placeholder="e.g. Hindi / Sanskrit / French" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_MotherTongue" class="form-label fw-semibold small text-dark">Mother Tongue</label>
                                <input asp-for="AA_MotherTongue" id="AA_MotherTongue" class="form-control rounded-3 py-2" placeholder="e.g. Hindi / Bengali / English" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_MedicalConditions" class="form-label fw-semibold small text-dark">Medical Conditions / Allergies</label>
                                <input asp-for="AA_MedicalConditions" id="AA_MedicalConditions" class="form-control rounded-3 py-2" placeholder="e.g. Asthma, Spectacles, None" />
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                    <div>
                                        <strong class="d-block text-dark small"><i class="bi bi-bus-front text-primary me-1"></i>School Transport Required?</strong>
                                        <small class="text-muted">Check if you require campus bus service</small>
                                    </div>
                                    <div class="form-check form-switch m-0 fs-5">
                                        <input class="form-check-input" type="checkbox" id="pub_RequiresTransport" name="AA_RequiresTransport" value="true" onchange="$('#pubTransportPoint').toggle(this.checked)" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                    <div>
                                        <strong class="d-block text-dark small"><i class="bi bi-building text-primary me-1"></i>Hostel Facility Required?</strong>
                                        <small class="text-muted">Check if you require residential hostel stay</small>
                                    </div>
                                    <div class="form-check form-switch m-0 fs-5">
                                        <input class="form-check-input" type="checkbox" id="pub_RequiresHostel" name="AA_RequiresHostel" value="true" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12" id="pubTransportPoint" style="display:none;">
                                <label asp-for="AA_TransportPickupPoint" class="form-label fw-semibold small text-dark">Preferred Bus Pickup Point / Stop</label>
                                <input asp-for="AA_TransportPickupPoint" id="AA_TransportPickupPoint" class="form-control rounded-3 py-2" placeholder="Enter landmark or bus stop location" />
                            </div>

                            <div class="col-12">
                                <label asp-for="AA_Notes" class="form-label fw-semibold small text-dark">Additional Remarks / Inquiries</label>
                                <textarea asp-for="AA_Notes" id="AA_Notes" class="form-control rounded-3" rows="2" placeholder="Enter any extra details, scholarship requests or queries..."></textarea>
                            </div>
                        </div>

                        <!-- Dynamic Application Review Box -->
                        <div class="card border rounded-3 p-4 mb-4 bg-light">
                            <h6 class="fw-bold text-dark pb-2 border-bottom mb-3"><i class="bi bi-eye-fill text-primary me-2"></i>Application Summary Review</h6>
                            
                            <div class="row g-3 small">
                                <div class="col-md-6 border-end">
                                    <p class="mb-1"><span class="text-muted">Target Campus:</span> <strong id="sum_Branch" class="text-primary">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Academic Session:</span> <strong id="sum_Year">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Applying For:</span> <strong id="sum_ClassCourse">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Student Name:</span> <strong id="sum_StudentName" class="text-dark">-</strong></p>
                                    <p class="mb-0"><span class="text-muted">Mobile &amp; Email:</span> <strong id="sum_Contact">-</strong></p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><span class="text-muted">Parents:</span> <strong id="sum_Parents">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Residential City:</span> <strong id="sum_CityState">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Previous School:</span> <strong id="sum_PrevSchool">-</strong></p>
                                    <p class="mb-1"><span class="text-muted">Facilities:</span> <strong id="sum_Facilities">-</strong></p>
                                    <p class="mb-0"><span class="text-muted">Attached Documents:</span> <strong id="sum_Docs" class="text-success">-</strong></p>
                                </div>
                            </div>
                        </div>

                        <!-- Terms & Declaration Checkbox -->
                        <div class="form-check p-3 bg-light border rounded-3 mb-3">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="agreeTerms" required>
                            <label class="form-check-label small text-dark fw-semibold" for="agreeTerms">
                                I hereby declare that all details furnished in this online admission application are true, accurate and complete to the best of my knowledge.
                            </label>
                            <div class="invalid-feedback-custom" id="err_agreeTerms">You must accept the declaration to submit your application.</div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- STEPPER NAVIGATION BUTTONS -->
                    <!-- ========================================== -->
                    <div class="d-flex align-items-center justify-content-between pt-4 border-top mt-4">
                        <!-- Back Button -->
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="btnPrevStep" onclick="navigateStep(-1)" style="display:none;">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </button>
                        <a href="/" class="btn btn-link text-muted rounded-pill text-decoration-none" id="btnCancelForm">
                            Cancel
                        </a>

                        <!-- Next / Submit Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold shadow-sm" id="btnNextStep" onclick="navigateStep(1)">
                                Next Step <i class="bi bi-arrow-right ms-1"></i>
                            </button>

                            <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold" id="btnPreviewApp" style="display:none;">
                                <i class="bi bi-printer me-1"></i> Preview &amp; Print Slip
                            </button>

                            <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow" id="btnDirectSubmit" style="display:none;">
                                <i class="bi bi-send-fill me-2"></i> Submit Application
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </div>

