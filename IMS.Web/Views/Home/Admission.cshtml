@section Scripts {
    <script>
        var currentStep = 1;
        var maxStepReached = 1;
        var totalSteps = 6;

        var stepTitles = {
            1: '<i class="bi bi-mortarboard me-2"></i>Academic & Campus Preference',
            2: '<i class="bi bi-person-badge me-2"></i>Student Personal Details & Photograph',
            3: '<i class="bi bi-people me-2"></i>Parents & Guardian Information',
            4: '<i class="bi bi-geo-alt me-2"></i>Residential Address & Emergency Contact',
            5: '<i class="bi bi-file-earmark-arrow-up me-2"></i>Previous Academic Record & Documents Upload',
            6: '<i class="bi bi-sliders2 me-2"></i>Facilities, Preferences & Final Review'
        };

        function printPreviewSlip() {
            window.print();
        }

        // File validation helpers
        function previewPublicPhoto(input) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                if (file.size > 2 * 1024 * 1024) {
                    showFieldError("#StudentPhoto", "err_StudentPhoto", "Photo file size exceeds 2MB limit.");
                    input.value = "";
                    return;
                }
                clearFieldError("#StudentPhoto", "err_StudentPhoto");
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#pubPhotoPreview').attr('src', e.target.result);
                };
                reader.readAsDataURL(file);
            }
        }

        function validateFileSize(input, maxMb) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var inputId = $(input).attr("id");
                var errId = "err_" + inputId;
                if (file.size > maxMb * 1024 * 1024) {
                    showFieldError("#" + inputId, errId, "File size exceeds " + maxMb + "MB limit.");
                    input.value = "";
                    return false;
                } else {
                    clearFieldError("#" + inputId, errId);
                    return true;
                }
            }
            return true;
        }

        // Inline Field Error Functions
        function showFieldError(selector, errorElemId, msg) {
            var $el = $(selector);
            $el.addClass("is-invalid").removeClass("is-valid");
            $("#" + errorElemId).text(msg).addClass("d-block");
        }

        function clearFieldError(selector, errorElemId) {
            var $el = $(selector);
            $el.removeClass("is-invalid");
            $("#" + errorElemId).text("").removeClass("d-block");
        }

        // Per-Step Validation Logic
        function validateStep(step) {
            var isValid = true;
            var firstErrEl = null;

            if (step === 1) {
                var branchVal = $("#AA_BranchId").val();
                if (!branchVal) {
                    showFieldError("#AA_BranchId", "err_AA_BranchId", "Please select a preferred campus branch.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_BranchId";
                } else {
                    clearFieldError("#AA_BranchId", "err_AA_BranchId");
                }

                var yearVal = $("#AA_AcademicYearId").val();
                if (!yearVal) {
                    showFieldError("#AA_AcademicYearId", "err_AA_AcademicYearId", "Please select an academic session.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_AcademicYearId";
                } else {
                    clearFieldError("#AA_AcademicYearId", "err_AA_AcademicYearId");
                }
            }
            else if (step === 2) {
                var fName = $.trim($("#AA_FirstName").val());
                if (!fName) {
                    showFieldError("#AA_FirstName", "err_AA_FirstName", "First Name is required.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_FirstName";
                } else {
                    clearFieldError("#AA_FirstName", "err_AA_FirstName");
                }

                var lName = $.trim($("#AA_LastName").val());
                if (!lName) {
                    showFieldError("#AA_LastName", "err_AA_LastName", "Last Name is required.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_LastName";
                } else {
                    clearFieldError("#AA_LastName", "err_AA_LastName");
                }

                var phone = $.trim($("#AA_Phone").val());
                var phoneRegex = /^[6-9]\d{9}$/;
                if (!phone || !phoneRegex.test(phone)) {
                    showFieldError("#AA_Phone", "err_AA_Phone", "Enter a valid 10-digit mobile number starting with 6-9.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_Phone";
                } else {
                    clearFieldError("#AA_Phone", "err_AA_Phone");
                }

                var email = $.trim($("#AA_Email").val());
                if (email) {
                    var emailRegex = /^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/;
                    if (!emailRegex.test(email)) {
                        showFieldError("#AA_Email", "err_AA_Email", "Please enter a valid email address.");
                        isValid = false;
                        if (!firstErrEl) firstErrEl = "#AA_Email";
                    } else {
                        clearFieldError("#AA_Email", "err_AA_Email");
                    }
                } else {
                    clearFieldError("#AA_Email", "err_AA_Email");
                }

                var aadhaar = $.trim($("#AA_AadhaarNumber").val());
                if (aadhaar) {
                    if (!/^\d{12}$/.test(aadhaar)) {
                        showFieldError("#AA_AadhaarNumber", "err_AA_AadhaarNumber", "Aadhaar number must be exactly 12 digits.");
                        isValid = false;
                        if (!firstErrEl) firstErrEl = "#AA_AadhaarNumber";
                    } else {
                        clearFieldError("#AA_AadhaarNumber", "err_AA_AadhaarNumber");
                    }
                } else {
                    clearFieldError("#AA_AadhaarNumber", "err_AA_AadhaarNumber");
                }
            }
            else if (step === 3) {
                var fPhone = $.trim($("#AA_FatherPhone").val());
                if (fPhone && !/^[6-9]\d{9}$/.test(fPhone)) {
                    showFieldError("#AA_FatherPhone", "err_AA_FatherPhone", "Enter a valid 10-digit mobile number.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_FatherPhone";
                } else {
                    clearFieldError("#AA_FatherPhone", "err_AA_FatherPhone");
                }

                var fEmail = $.trim($("#AA_FatherEmail").val());
                if (fEmail && !/^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/.test(fEmail)) {
                    showFieldError("#AA_FatherEmail", "err_AA_FatherEmail", "Enter a valid email address.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_FatherEmail";
                } else {
                    clearFieldError("#AA_FatherEmail", "err_AA_FatherEmail");
                }

                var mPhone = $.trim($("#AA_MotherPhone").val());
                if (mPhone && !/^[6-9]\d{9}$/.test(mPhone)) {
                    showFieldError("#AA_MotherPhone", "err_AA_MotherPhone", "Enter a valid 10-digit mobile number.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_MotherPhone";
                } else {
                    clearFieldError("#AA_MotherPhone", "err_AA_MotherPhone");
                }

                var mEmail = $.trim($("#AA_MotherEmail").val());
                if (mEmail && !/^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/.test(mEmail)) {
                    showFieldError("#AA_MotherEmail", "err_AA_MotherEmail", "Enter a valid email address.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_MotherEmail";
                } else {
                    clearFieldError("#AA_MotherEmail", "err_AA_MotherEmail");
                }

                var gPhone = $.trim($("#AA_GuardianPhone").val());
                if (gPhone && !/^[6-9]\d{9}$/.test(gPhone)) {
                    showFieldError("#AA_GuardianPhone", "err_AA_GuardianPhone", "Enter a valid 10-digit mobile number.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_GuardianPhone";
                } else {
                    clearFieldError("#AA_GuardianPhone", "err_AA_GuardianPhone");
                }

                var gEmail = $.trim($("#AA_GuardianEmail").val());
                if (gEmail && !/^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/.test(gEmail)) {
                    showFieldError("#AA_GuardianEmail", "err_AA_GuardianEmail", "Enter a valid email address.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_GuardianEmail";
                } else {
                    clearFieldError("#AA_GuardianEmail", "err_AA_GuardianEmail");
                }
            }
            else if (step === 4) {
                var pin = $.trim($("#AA_PostalCode").val());
                if (pin && !/^\d{6}$/.test(pin)) {
                    showFieldError("#AA_PostalCode", "err_AA_PostalCode", "PIN code must be exactly 6 digits.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_PostalCode";
                } else {
                    clearFieldError("#AA_PostalCode", "err_AA_PostalCode");
                }

                var ePhone = $.trim($("#AA_EmergencyContactPhone").val());
                if (ePhone && !/^[6-9]\d{9}$/.test(ePhone)) {
                    showFieldError("#AA_EmergencyContactPhone", "err_AA_EmergencyContactPhone", "Enter a valid 10-digit mobile number.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#AA_EmergencyContactPhone";
                } else {
                    clearFieldError("#AA_EmergencyContactPhone", "err_AA_EmergencyContactPhone");
                }
            }
            else if (step === 6) {
                if (!$("#agreeTerms").is(":checked")) {
                    showFieldError("#agreeTerms", "err_agreeTerms", "You must accept the declaration to submit your application.");
                    isValid = false;
                    if (!firstErrEl) firstErrEl = "#agreeTerms";
                } else {
                    clearFieldError("#agreeTerms", "err_agreeTerms");
                }
            }

            if (!isValid && firstErrEl) {
                $(firstErrEl).focus();
                var el = document.querySelector(firstErrEl);
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            return isValid;
        }

        // Stepper Navigation Function
        function navigateStep(direction) {
            var target = currentStep + direction;

            if (direction > 0) {
                // Moving forward: validate current step
                if (!validateStep(currentStep)) return;
            }

            if (target >= 1 && target <= totalSteps) {
                goToStep(target);
            }
        }

        function handleStepNavClick(targetStep) {
            if (targetStep === currentStep) return;

            if (targetStep > currentStep) {
                // Check all intermediate steps up to targetStep
                for (var s = currentStep; s < targetStep; s++) {
                    if (!validateStep(s)) {
                        return;
                    }
                }
            }
            goToStep(targetStep);
        }

        function goToStep(stepNum) {
            // Update Stepper Icon status
            if (stepNum > maxStepReached) {
                maxStepReached = stepNum;
            }

            // Mark previous step as completed if valid
            for (var i = 1; i <= totalSteps; i++) {
                var $item = $('.step-item[data-step="' + i + '"]');
                var $icon = $('#step-icon-' + i);

                if (i < stepNum) {
                    $item.removeClass('active').addClass('completed');
                    $icon.html('<i class="bi bi-check-lg"></i>');
                } else if (i === stepNum) {
                    $item.removeClass('completed').addClass('active');
                    $icon.html(getStepIconHtml(i));
                } else {
                    $item.removeClass('active completed');
                    $icon.html(getStepIconHtml(i));
                }
            }

            // Hide all steps, show target step
            $('.form-step').removeClass('active-step');
            $('#step-' + stepNum).addClass('active-step');

            // Update Progress Bar
            currentStep = stepNum;
            var pct = Math.round((stepNum / totalSteps) * 100);
            $('#currentStepNum').text(stepNum);
            $('#stepProgressPercent').text(pct + '% Completed');
            $('#admissionProgressBar').css('width', pct + '%');

            // Update Header Title
            if (stepTitles[stepNum]) {
                $('#formHeaderTitle').html(stepTitles[stepNum]);
            }

            // Update Buttons
            if (currentStep === 1) {
                $('#btnPrevStep').hide();
                $('#btnCancelForm').show();
            } else {
                $('#btnPrevStep').show();
                $('#btnCancelForm').hide();
            }

            if (currentStep === totalSteps) {
                $('#btnNextStep').hide();
                $('#btnPreviewApp').show();
                $('#btnDirectSubmit').show();
                updateSummaryReviewCard();
            } else {
                $('#btnNextStep').show();
                $('#btnPreviewApp').hide();
                $('#btnDirectSubmit').hide();
            }

            window.scrollTo({ top: 180, behavior: 'smooth' });
        }

        function getStepIconHtml(step) {
            switch(step) {
                case 1: return '<i class="bi bi-mortarboard-fill"></i>';
                case 2: return '<i class="bi bi-person-badge-fill"></i>';
                case 3: return '<i class="bi bi-people-fill"></i>';
                case 4: return '<i class="bi bi-geo-alt-fill"></i>';
                case 5: return '<i class="bi bi-file-earmark-arrow-up-fill"></i>';
                case 6: return '<i class="bi bi-check2-circle"></i>';
                default: return step;
            }
        }

        function getSelectedText(selector, defaultFallback) {
            var $opt = $(selector + " option:selected");
            var val = $(selector).val();
            if (!val || val === "" || val === "0") return defaultFallback || "-";
            var txt = $.trim($opt.text());
            if (!txt || txt.indexOf("-- Select") === 0 || txt.indexOf("--Select") === 0) {
                return defaultFallback || "-";
            }
            return txt;
        }

        function updateSummaryReviewCard() {
            var fName = $.trim($("#AA_FirstName").val());
            var mName = $.trim($("#AA_MiddleName").val());
            var lName = $.trim($("#AA_LastName").val());
            var fullName = [fName, mName, lName].filter(Boolean).join(" ");
            
            $("#sum_Branch").text(getSelectedText("#AA_BranchId", "-"));
            $("#sum_Year").text(getSelectedText("#AA_AcademicYearId", "-"));

            var cls = getSelectedText("#AA_ClassId", "");
            var crs = getSelectedText("#AA_CourseId", "");
            var clsCrs = [cls, crs].filter(Boolean).join(" / ");
            $("#sum_ClassCourse").text(clsCrs || "-");

            $("#sum_StudentName").text(fullName || "Not Entered");
            var ph = $.trim($("#AA_Phone").val());
            var em = $.trim($("#AA_Email").val());
            $("#sum_Contact").text([ph ? "+91 " + ph : "", em].filter(Boolean).join(" | ") || "-");

            var fN = $.trim($("#AA_FatherName").val());
            var mN = $.trim($("#AA_MotherName").val());
            $("#sum_Parents").text([fN ? "Father: " + fN : "", mN ? "Mother: " + mN : ""].filter(Boolean).join(" / ") || "Not Specified");

            var city = $.trim($("#AA_City").val());
            var state = $.trim($("#AA_State").val());
            $("#sum_CityState").text([city, state].filter(Boolean).join(", ") || "-");

            $("#sum_PrevSchool").text($.trim($("#AA_PreviousSchool").val()) || "-");

            var tr = $("#pub_RequiresTransport").is(":checked") ? "Bus Transport" : "";
            var ho = $("#pub_RequiresHostel").is(":checked") ? "Hostel" : "";
            $("#sum_Facilities").text([tr, ho].filter(Boolean).join(" & ") || "Standard (No Host/Trans)");

            var docs = [];
            if ($("#BirthCertificateDoc").val()) docs.push("Birth Cert");
            if ($("#MarksheetDoc").val()) docs.push("Marksheet");
            if ($("#TransferCertificateDoc").val()) docs.push("TC");
            if ($("#NationalIdDoc").val()) docs.push("Aadhaar");
            $("#sum_Docs").text(docs.length > 0 ? docs.join(", ") : "None attached");
        }

        function populatePreviewModal() {
            var fName = $.trim($("#AA_FirstName").val());
            var mName = $.trim($("#AA_MiddleName").val());
            var lName = $.trim($("#AA_LastName").val());
            var fullName = [fName, mName, lName].filter(Boolean).join(" ");
            
            $("#prev_FullName").text(fullName ? fullName.toUpperCase() : "APPLICANT NAME");
            
            var branchTxt = getSelectedText("#AA_BranchId", "-");
            $("#prev_Branch, #prev_BranchSec").text(branchTxt);
            $("#prev_BranchMeta").text("Target Campus: " + (branchTxt !== "-" ? branchTxt : "Main Branch"));
            
            var yearTxt = getSelectedText("#AA_AcademicYearId", "-");
            $("#prev_Year, #prev_YearSec").text(yearTxt);
            $("#prev_YearMeta").text("Academic Session: " + (yearTxt !== "-" ? yearTxt : "2026-2027"));

            var classTxt = getSelectedText("#AA_ClassId", "-");
            $("#prev_Class, #prev_ClassSec").text(classTxt);

            var courseTxt = getSelectedText("#AA_CourseId", "-");
            $("#prev_Course, #prev_CourseSec").text(courseTxt);
            
            $("#prev_DOB").text($.trim($("#AA_DateOfBirth").val()) || "-");
            $("#prev_Gender").text(getSelectedText("#AA_Gender", "-"));
            $("#prev_BloodGroup").text(getSelectedText("#AA_BloodGroup", "-"));
            $("#prev_Category").text(getSelectedText("#AA_Category", "-"));
            $("#prev_Nationality").text($.trim($("#AA_Nationality").val()) || "Indian");
            $("#prev_Religion").text($.trim($("#AA_Religion").val()) || "-");
            $("#prev_Phone").text($.trim($("#AA_Phone").val()) ? "+91 " + $.trim($("#AA_Phone").val()) : "-");
            $("#prev_Email").text($.trim($("#AA_Email").val()) || "-");
            $("#prev_Aadhaar").text($.trim($("#AA_AadhaarNumber").val()) || "Not Specified");

            var fNameVal = $.trim($("#AA_FatherName").val());
            $("#prev_FatherName").text(fNameVal ? fNameVal.toUpperCase() : "-");
            $("#prev_FatherPhone").text($.trim($("#AA_FatherPhone").val()) ? "+91 " + $.trim($("#AA_FatherPhone").val()) : "-");
            $("#prev_FatherEmail").text($.trim($("#AA_FatherEmail").val()) || "-");
            $("#prev_FatherOccupation").text($.trim($("#AA_FatherOccupation").val()) || "-");

            var mNameVal = $.trim($("#AA_MotherName").val());
            $("#prev_MotherName").text(mNameVal ? mNameVal.toUpperCase() : "-");
            $("#prev_MotherPhone").text($.trim($("#AA_MotherPhone").val()) ? "+91 " + $.trim($("#AA_MotherPhone").val()) : "-");
            $("#prev_MotherEmail").text($.trim($("#AA_MotherEmail").val()) || "-");
            $("#prev_MotherOccupation").text($.trim($("#AA_MotherOccupation").val()) || "-");

            var gName = $.trim($("#AA_GuardianName").val());
            var gRel = $.trim($("#AA_GuardianRelation").val());
            var gPhone = $.trim($("#AA_GuardianPhone").val());
            var gEmail = $.trim($("#AA_GuardianEmail").val());
            if (gName) {
                $("#prev_GuardianDetails").text(gName.toUpperCase() + (gRel ? " (" + gRel + ")" : "") + (gPhone ? " - Mob: +91 " + gPhone : "") + (gEmail ? " | Email: " + gEmail : ""));
            } else {
                $("#prev_GuardianDetails").text("Not Applicable");
            }

            var addr1 = $.trim($("#AA_AddressLine1").val());
            var addr2 = $.trim($("#AA_AddressLine2").val());
            var city = $.trim($("#AA_City").val());
            var state = $.trim($("#AA_State").val());
            var pin = $.trim($("#AA_PostalCode").val());
            var country = $.trim($("#AA_Country").val()) || "India";
            var fullAddr = [addr1, addr2, city, state, pin, country].filter(Boolean).join(", ");
            $("#prev_Address").text(fullAddr || "-");

            var emerName = $.trim($("#AA_EmergencyContactName").val());
            var emerPhone = $.trim($("#AA_EmergencyContactPhone").val());
            $("#prev_Emergency").text(emerName ? (emerName + (emerPhone ? " (+91 " + emerPhone + ")" : "")) : "-");

            $("#prev_PrevSchool").text($.trim($("#AA_PreviousSchool").val()) || "-");
            var board = $.trim($("#AA_PreviousBoard").val());
            var marks = $.trim($("#AA_PreviousMarks").val());
            $("#prev_PrevMarks").text([board, marks].filter(Boolean).join(" - ") || "-");

            var secLang = $.trim($("#AA_SecondLanguage").val());
            var mothTongue = $.trim($("#AA_MotherTongue").val());
            $("#prev_Languages").text("Second Language: " + (secLang || "None") + " | Mother Tongue: " + (mothTongue || "-"));

            var transport = $("#pub_RequiresTransport").is(":checked") ? ("Bus Transport (" + ($.trim($("#AA_TransportPickupPoint").val()) || "Standard Pickup") + ")") : "No Transport";
            var hostel = $("#pub_RequiresHostel").is(":checked") ? "Hostel Requested" : "No Hostel";
            $("#prev_Facilities").text(transport + " | " + hostel);

            var docs = [];
            if ($("#BirthCertificateDoc").val()) docs.push("Birth Certificate");
            if ($("#MarksheetDoc").val()) docs.push("Previous Marksheet");
            if ($("#TransferCertificateDoc").val()) docs.push("Transfer Certificate (TC)");
            if ($("#NationalIdDoc").val()) docs.push("Aadhaar / ID Card");
            $("#prev_Docs").text(docs.length > 0 ? docs.join(", ") : "None attached in draft");

            var photoSrc = $('#pubPhotoPreview').attr('src');
            $("#prev_Photo").attr('src', photoSrc);

            var now = new Date();
            var dateStr = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            $("#prev_GeneratedAt").text(dateStr);
        }

        $(function () {
            // Load Dropdown Options
            Dropdown.load({ element: '#AA_BranchId', entityType: 'Branch', defaultText: '-- Select Branch / Campus --', includeDefault: true });
            Dropdown.load({ element: '#AA_AcademicYearId', entityType: 'AcademicYear', defaultText: '-- Select Academic Year --', includeDefault: true });
            Dropdown.load({ element: '#AA_ClassId', entityType: 'Class', defaultText: '-- Select Class --', includeDefault: true });
            Dropdown.load({ element: '#AA_CourseId', entityType: 'Course', defaultText: '-- Select Course --', includeDefault: true });
            Dropdown.load({ element: '#AA_Gender', entityType: 'Gender', defaultText: '-- Select Gender --', includeDefault: true });
            Dropdown.load({ element: '#AA_BloodGroup', entityType: 'BloodGroup', defaultText: '-- Select Blood Group --', includeDefault: true });
            Dropdown.load({ element: '#AA_Category', entityType: 'Category', defaultText: '-- Select Category --', includeDefault: true });

            // Clear invalid status on typing / changing
            $("#admissionForm").on("input change", "input, select, textarea", function () {
                var id = $(this).attr("id");
                if (id) {
                    clearFieldError("#" + id, "err_" + id);
                }
            });

            // Preview & Print Modal Handler
            $("#btnPreviewApp").on("click", function () {
                if (!validateStep(1) || !validateStep(2) || !validateStep(3) || !validateStep(4)) {
                    return;
                }
                populatePreviewModal();
                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("previewAppModal"));
                modal.show();
            });

            // Confirm & Final Submit from inside Modal
            $("#btnConfirmFinalSubmit").on("click", function () {
                var modalEl = document.getElementById("previewAppModal");
                var modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                $("#admissionForm").trigger("submit");
            });

            // AJAX Submission Handler
            $("#admissionForm").on("submit", function (e) {
                e.preventDefault();

                // Validate all steps before submitting
                for (var s = 1; s <= totalSteps; s++) {
                    if (!validateStep(s)) {
                        goToStep(s);
                        return;
                    }
                }

                var form = this;
                var $form = $(form);
                var formData = new FormData(form);
                var $btn = $("#btnDirectSubmit");
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Submitting Application...');

                $.ajax({
                    url: $form.attr("action"),
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (r) {
                        if (r.success) {
                            var appNo = r.applicationNumber || "APP-2026";

                            $form.closest(".card-body").html(
                                '<div class="text-center py-5 px-3">' +
                                    '<div class="display-1 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>' +
                                    '<h2 class="fw-bold text-dark mb-2">Application Submitted Successfully!</h2>' +
                                    '<p class="text-muted fs-6 mb-4">Your admission application has been registered in our system. An email notification with tracking details has been sent to your registered email address.</p>' +
                                    
                                    '<div class="card border border-2 border-primary-subtle bg-light mx-auto p-4 rounded-4 mb-4" style="max-width: 580px;">' +
                                        '<span class="text-muted small text-uppercase fw-bold letter-spacing-1 d-block mb-1">Your Application Reference Number</span>' +
                                        '<div class="d-flex align-items-center justify-content-center gap-2 mb-2">' +
                                            '<span class="fs-1 fw-bold text-primary font-monospace" id="confAppNum">' + appNo + '</span>' +
                                            '<button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-1 px-3" onclick="navigator.clipboard.writeText(\'' + appNo + '\'); alert(\'Reference copied: ' + appNo + '\');">' +
                                                '<i class="bi bi-clipboard me-1"></i> Copy' +
                                            '</button>' +
                                        '</div>' +
                                        '<small class="text-muted d-block">Please save this reference number to check real-time updates on your admission status.</small>' +
                                    '</div>' +

                                    '<div class="d-flex justify-content-center gap-3 flex-wrap">' +
                                        '<a href="/Home/TrackAdmission?appNumber=' + encodeURIComponent(appNo) + '" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">' +
                                            '<i class="bi bi-search me-1"></i> Track Application Status Live' +
                                        '</a>' +
                                        '<button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" onclick="printPreviewSlip()">' +
                                            '<i class="bi bi-printer me-1"></i> Print Official Slip' +
                                        '</button>' +
                                        '<a href="/" class="btn btn-link text-muted rounded-pill px-3 py-2">' +
                                            'Back to Home' +
                                        '</a>' +
                                    '</div>' +
                                '</div>'
                            );
                            window.scrollTo({ top: 100, behavior: 'smooth' });
                        } else {
                            if (r.errors && typeof r.errors === "object") {
                                $.each(r.errors, function(key, msgs) {
                                    var msg = Array.isArray(msgs) ? msgs.join(" ") : msgs;
                                    showFieldError("[name='" + key + "'], #" + key, "err_" + key, msg);
                                });
                            }
                            alert(r.message || "Please check the highlighted fields.");
                            $btn.prop("disabled", false).html('<i class="bi bi-send-fill me-2"></i> Submit Application');
                        }
                    },
                    error: function (xhr) {
                        var resp = xhr.responseJSON;
                        var msg = (resp && resp.message) ? resp.message : "Submission failed. Please check your network connection and try again.";
                        alert(msg);
                        $btn.prop("disabled", false).html('<i class="bi bi-send-fill me-2"></i> Submit Application');
                    }
                });
            });
        });
    </script>
}
