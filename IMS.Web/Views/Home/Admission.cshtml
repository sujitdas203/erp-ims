@model IMS.Models.ViewModels.AdmissionApplicationFormViewModel
@{
    ViewData["Title"] = "Online Admission Application";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="admission-page" style="background: var(--parchment-dim, #fbfaf7); min-height: 85vh; padding: 3rem 0;">
    <div class="container" style="max-width: 960px;">
        
        <!-- Header Banner -->
        <div class="text-center mb-5">
            <span class="badge rounded-pill px-3 py-2 text-uppercase mb-2 shadow-sm" style="background:#2563eb; color:#ffffff; font-size:0.75rem; letter-spacing:1px;">
                Admissions Open 2026-2027
            </span>
            <h1 class="fw-bold text-dark mb-2">Apply for Online Admission</h1>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Take the first step towards academic excellence. Complete the application form below. Our admissions office will verify your credentials and guide you through the enrollment process.
            </p>
        </div>

        @if (TempData["AdmissionSuccess"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 mb-4 text-center">
                <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                <h4 class="fw-bold">Application Submitted Successfully!</h4>
                <p class="mb-0">@TempData["AdmissionSuccess"]</p>
                <div class="mt-3">
                    <a href="/" class="btn btn-primary rounded-pill px-4">Back to Home</a>
                </div>
            </div>
        }

        <!-- Application Form Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background:#ffffff; border:1px solid #e2e8f0;">
            <div class="card-header border-0 py-3 px-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); color:#ffffff;">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-semibold"><i class="bi bi-person-lines-fill me-2"></i>New Student Application Form</span>
                    <span class="badge bg-light text-dark fw-bold">Online Portal</span>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-controller="Home" asp-action="ApplyAdmission" method="post" enctype="multipart/form-data" id="admissionForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                    <!-- 1. Academic & Campus Preference -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-mortarboard text-primary me-2"></i>1. Academic &amp; Campus Preference
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="AA_BranchId" class="form-label fw-semibold small text-muted">Preferred Campus / Branch <span class="text-danger">*</span></label>
                                <select asp-for="AA_BranchId" id="AA_BranchId" class="form-select rounded-3 py-2" required>
                                </select>
                                <span asp-validation-for="AA_BranchId" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_AcademicYearId" class="form-label fw-semibold small text-muted">Academic Session / Year <span class="text-danger">*</span></label>
                                <select asp-for="AA_AcademicYearId" id="AA_AcademicYearId" class="form-select rounded-3 py-2" required>
                                </select>
                                <span asp-validation-for="AA_AcademicYearId" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_ClassId" class="form-label fw-semibold small text-muted">Applying For Grade / Class</label>
                                <select asp-for="AA_ClassId" id="AA_ClassId" class="form-select rounded-3 py-2">
                                </select>
                                <span asp-validation-for="AA_ClassId" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_CourseId" class="form-label fw-semibold small text-muted">Stream / Course</label>
                                <select asp-for="AA_CourseId" id="AA_CourseId" class="form-select rounded-3 py-2">
                                </select>
                                <span asp-validation-for="AA_CourseId" class="text-danger small d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Student Personal Details & Photo Upload -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-person-badge text-primary me-2"></i>2. Student Information &amp; Photograph
                        </h5>
                        <div class="row g-3">
                            <!-- Student Photo Box -->
                            <div class="col-md-3 text-center border-end pe-md-4">
                                <label class="form-label fw-semibold small text-muted d-block text-start mb-2">Student Photo (Passport size)</label>
                                <div class="position-relative d-inline-block mb-2">
                                    <img id="pubPhotoPreview" 
                                         src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='130' height='150' viewBox='0 0 24 24' fill='%2394a3b8'><path d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>" 
                                         alt="Student Photo" 
                                         class="rounded-3 shadow-sm border img-thumbnail" 
                                         style="width: 130px; height: 150px; object-fit: cover; background: #f8fafc;"
                                         onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'130\' height=\'150\' viewBox=\'0 0 24 24\' fill=\'%2394a3b8\'><path d=\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\'/></svg>'" />
                                </div>
                                <input type="file" name="StudentPhoto" id="StudentPhoto" class="form-control form-control-sm" accept="image/*" onchange="previewPublicPhoto(this)" />
                                <small class="text-muted d-block mt-1">JPG/PNG max 2MB</small>
                            </div>

                            <!-- Personal Details Fields -->
                            <div class="col-md-9">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="AA_FirstName" class="form-label fw-semibold small text-muted">First Name <span class="text-danger">*</span></label>
                                        <input asp-for="AA_FirstName" class="form-control rounded-3 py-2" placeholder="e.g. John" required />
                                        <span asp-validation-for="AA_FirstName" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_MiddleName" class="form-label fw-semibold small text-muted">Middle Name</label>
                                        <input asp-for="AA_MiddleName" class="form-control rounded-3 py-2" placeholder="e.g. William" />
                                        <span asp-validation-for="AA_MiddleName" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_LastName" class="form-label fw-semibold small text-muted">Last Name <span class="text-danger">*</span></label>
                                        <input asp-for="AA_LastName" class="form-control rounded-3 py-2" placeholder="e.g. Doe" required />
                                        <span asp-validation-for="AA_LastName" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AA_DateOfBirth" class="form-label fw-semibold small text-muted">Date of Birth</label>
                                        <input asp-for="AA_DateOfBirth" type="date" class="form-control rounded-3 py-2" />
                                        <span asp-validation-for="AA_DateOfBirth" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AA_Gender" class="form-label fw-semibold small text-muted">Gender</label>
                                        <select asp-for="AA_Gender" id="AA_Gender" class="form-select rounded-3 py-2">
                                        </select>
                                        <span asp-validation-for="AA_Gender" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AA_BloodGroup" class="form-label fw-semibold small text-muted">Blood Group</label>
                                        <select asp-for="AA_BloodGroup" id="AA_BloodGroup" class="form-select rounded-3 py-2">
                                        </select>
                                        <span asp-validation-for="AA_BloodGroup" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="AA_Category" class="form-label fw-semibold small text-muted">Category / Quota</label>
                                        <select asp-for="AA_Category" id="AA_Category" class="form-select rounded-3 py-2">
                                        </select>
                                        <span asp-validation-for="AA_Category" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_AadhaarNumber" class="form-label fw-semibold small text-muted">Aadhaar / National ID</label>
                                        <input asp-for="AA_AadhaarNumber" class="form-control rounded-3 py-2" placeholder="12-digit Aadhaar / ID" />
                                        <span asp-validation-for="AA_AadhaarNumber" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Phone" class="form-label fw-semibold small text-muted">Student Mobile Number <span class="text-danger">*</span></label>
                                        <input asp-for="AA_Phone" class="form-control rounded-3 py-2" placeholder="+91 9876543210" required />
                                        <span asp-validation-for="AA_Phone" class="text-danger small d-block"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AA_Email" class="form-label fw-semibold small text-muted">Student Email Address</label>
                                        <input asp-for="AA_Email" type="email" class="form-control rounded-3 py-2" placeholder="student@example.com" />
                                        <span asp-validation-for="AA_Email" class="text-danger small d-block"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Parent & Guardian Information -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-people text-primary me-2"></i>3. Parents &amp; Guardian Information
                        </h5>
                        
                        <!-- Father -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="AA_FatherName" class="form-label fw-semibold small text-muted">Father's Full Name</label>
                                <input asp-for="AA_FatherName" class="form-control rounded-3 py-2" placeholder="Father's Name" />
                                <span asp-validation-for="AA_FatherName" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_FatherPhone" class="form-label fw-semibold small text-muted">Father's Mobile</label>
                                <input asp-for="AA_FatherPhone" class="form-control rounded-3 py-2" placeholder="+91 9876543210" />
                                <span asp-validation-for="AA_FatherPhone" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_FatherOccupation" class="form-label fw-semibold small text-muted">Father's Occupation</label>
                                <input asp-for="AA_FatherOccupation" class="form-control rounded-3 py-2" placeholder="e.g. Business / Service" />
                            </div>
                        </div>

                        <!-- Mother -->
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="AA_MotherName" class="form-label fw-semibold small text-muted">Mother's Full Name</label>
                                <input asp-for="AA_MotherName" class="form-control rounded-3 py-2" placeholder="Mother's Name" />
                                <span asp-validation-for="AA_MotherName" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_MotherPhone" class="form-label fw-semibold small text-muted">Mother's Mobile</label>
                                <input asp-for="AA_MotherPhone" class="form-control rounded-3 py-2" placeholder="+91 9876543210" />
                                <span asp-validation-for="AA_MotherPhone" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_MotherOccupation" class="form-label fw-semibold small text-muted">Mother's Occupation</label>
                                <input asp-for="AA_MotherOccupation" class="form-control rounded-3 py-2" placeholder="e.g. Homemaker / Teacher" />
                            </div>
                        </div>
                    </div>

                    <!-- 4. Residential Address & Emergency Contact -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-geo-alt text-primary me-2"></i>4. Residential Address &amp; Emergency Contact
                        </h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AA_AddressLine1" class="form-label fw-semibold small text-muted">Address Line 1 (House No, Street)</label>
                                <input asp-for="AA_AddressLine1" class="form-control rounded-3 py-2" placeholder="Flat / House No, Street name" />
                                <span asp-validation-for="AA_AddressLine1" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_AddressLine2" class="form-label fw-semibold small text-muted">Address Line 2 (Area / Landmark)</label>
                                <input asp-for="AA_AddressLine2" class="form-control rounded-3 py-2" placeholder="Area, Landmark" />
                                <span asp-validation-for="AA_AddressLine2" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_City" class="form-label fw-semibold small text-muted">City / District</label>
                                <input asp-for="AA_City" class="form-control rounded-3 py-2" placeholder="City" />
                                <span asp-validation-for="AA_City" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_State" class="form-label fw-semibold small text-muted">State</label>
                                <input asp-for="AA_State" class="form-control rounded-3 py-2" placeholder="State" />
                                <span asp-validation-for="AA_State" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_PostalCode" class="form-label fw-semibold small text-muted">PIN Code</label>
                                <input asp-for="AA_PostalCode" class="form-control rounded-3 py-2" placeholder="Postal / PIN Code" />
                                <span asp-validation-for="AA_PostalCode" class="text-danger small d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AA_EmergencyContactName" class="form-label fw-semibold small text-muted"><i class="bi bi-shield-check text-primary me-1"></i> Emergency Contact Name</label>
                                <input asp-for="AA_EmergencyContactName" class="form-control rounded-3 py-2" placeholder="Name of emergency contact person" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_EmergencyContactPhone" class="form-label fw-semibold small text-muted"><i class="bi bi-telephone text-primary me-1"></i> Emergency Contact Phone</label>
                                <input asp-for="AA_EmergencyContactPhone" class="form-control rounded-3 py-2" placeholder="Emergency phone number" />
                            </div>
                        </div>
                    </div>

                    <!-- 5. Previous Academic Background & Document Uploads -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-building text-primary me-2"></i>5. Previous Academic Record &amp; Documents
                        </h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousSchool" class="form-label fw-semibold small text-muted">Previous School / Institute</label>
                                <input asp-for="AA_PreviousSchool" class="form-control rounded-3 py-2" placeholder="Previous School Name" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousBoard" class="form-label fw-semibold small text-muted">Board (CBSE / ICSE / State)</label>
                                <input asp-for="AA_PreviousBoard" class="form-control rounded-3 py-2" placeholder="e.g. CBSE / State" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AA_PreviousMarks" class="form-label fw-semibold small text-muted">Previous Grade / Marks (%)</label>
                                <input asp-for="AA_PreviousMarks" class="form-control rounded-3 py-2" placeholder="e.g. 88.5% or Grade A" />
                            </div>
                        </div>

                        <!-- Documents Upload -->
                        <h6 class="text-primary fw-bold small pb-1 border-top pt-2 mb-2"><i class="bi bi-paperclip me-1"></i> Upload Supporting Documents (PDF / JPG / PNG max 5MB)</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small text-muted">Birth Certificate</label>
                                <input type="file" name="BirthCertificateDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small text-muted">Previous Marksheet</label>
                                <input type="file" name="MarksheetDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small text-muted">Transfer Certificate (TC)</label>
                                <input type="file" name="TransferCertificateDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small text-muted">Aadhaar / National ID</label>
                                <input type="file" name="NationalIdDoc" class="form-control form-control-sm rounded-3" accept=".pdf,image/*" />
                            </div>
                        </div>
                    </div>

                    <!-- 6. Facilities & Preferences -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark pb-2 border-bottom mb-3" style="color:#1e3a8a;">
                            <i class="bi bi-bus-front text-primary me-2"></i>6. Facilities &amp; Health Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="AA_SecondLanguage" class="form-label fw-semibold small text-muted">Second Language Preference</label>
                                <input asp-for="AA_SecondLanguage" class="form-control rounded-3 py-2" placeholder="e.g. Hindi / Sanskrit" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="AA_MotherTongue" class="form-label fw-semibold small text-muted">Mother Tongue</label>
                                <input asp-for="AA_MotherTongue" class="form-control rounded-3 py-2" placeholder="e.g. Bengali / Hindi / English" />
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" type="checkbox" id="pub_RequiresTransport" name="AA_RequiresTransport" value="true" onchange="$('#pubTransportPoint').toggle(this.checked)" />
                                    <label class="form-check-label fw-semibold small text-muted" for="pub_RequiresTransport">School Transport</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" type="checkbox" id="pub_RequiresHostel" name="AA_RequiresHostel" value="true" />
                                    <label class="form-check-label fw-semibold small text-muted" for="pub_RequiresHostel">Hostel Facility</label>
                                </div>
                            </div>
                            <div class="col-md-6" id="pubTransportPoint" style="display:none;">
                                <label asp-for="AA_TransportPickupPoint" class="form-label fw-semibold small text-muted">Preferred Bus Pickup / Stop Point</label>
                                <input asp-for="AA_TransportPickupPoint" class="form-control rounded-3 py-2" placeholder="Enter landmark or stop" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AA_MedicalConditions" class="form-label fw-semibold small text-muted">Medical Conditions / Allergies (if any)</label>
                                <input asp-for="AA_MedicalConditions" class="form-control rounded-3 py-2" placeholder="e.g. Asthma, allergies, spectacles, None" />
                            </div>
                            <div class="col-12">
                                <label asp-for="AA_Notes" class="form-label fw-semibold small text-muted">Additional Information / Remarks</label>
                                <textarea asp-for="AA_Notes" class="form-control rounded-3" rows="2" placeholder="Enter any extra details or inquiries..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Submission Agreement -->
                    <div class="form-check mb-4 p-3 bg-light rounded-3">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label small text-muted" for="agreeTerms">
                            I declare that all information provided in this admission application form is accurate and true to the best of my knowledge.
                        </label>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" id="btnPreviewApp">
                                <i class="bi bi-eye me-1"></i> Preview &amp; Print Form
                            </button>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold shadow" id="btnDirectSubmit">
                                <i class="bi bi-send-fill me-2"></i> Submit Application
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<!-- Draft Application Form Preview & Print Modal -->
<div class="modal fade" id="previewAppModal" tabindex="-1" aria-labelledby="previewAppModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="previewAppModalLabel">Application Form Preview</h5>
                        <small class="text-white-50">Please review your filled information carefully before final submission</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 bg-light" id="previewAppModalBody">
                <div class="bg-white p-4 rounded-3 border shadow-sm" id="printableDraftApplication">
                    <!-- Institutional Header for Print -->
                    <div class="text-center pb-3 mb-3 border-bottom">
                        <h4 class="fw-bold text-dark mb-1">IMS ERP &bull; ADMISSION APPLICATION</h4>
                        <span class="badge bg-primary px-3 py-1 text-uppercase">Draft Application Slip</span>
                    </div>

                    <div class="row g-3 align-items-start mb-3">
                        <!-- Photo -->
                        <div class="col-sm-3 text-center">
                            <img id="prev_Photo" src="" alt="Student Photo" class="img-thumbnail rounded-3 shadow-sm border" style="width: 120px; height: 140px; object-fit: cover; background: #f8fafc;" />
                        </div>
                        <!-- Key Summary -->
                        <div class="col-sm-9">
                            <h5 class="fw-bold text-primary mb-1" id="prev_FullName">Student Name</h5>
                            <div class="row g-2 small text-dark">
                                <div class="col-6"><span class="text-muted">Campus / Branch:</span> <strong id="prev_Branch">-</strong></div>
                                <div class="col-6"><span class="text-muted">Academic Session:</span> <strong id="prev_Year">-</strong></div>
                                <div class="col-6"><span class="text-muted">Applied Class/Grade:</span> <strong id="prev_Class">-</strong></div>
                                <div class="col-6"><span class="text-muted">Course / Stream:</span> <strong id="prev_Course">-</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Information Table -->
                    <h6 class="fw-bold text-dark pb-1 border-bottom mt-3 small"><i class="bi bi-person me-1 text-primary"></i> Personal Details</h6>
                    <table class="table table-sm table-bordered small mb-3">
                        <tbody>
                            <tr>
                                <th class="bg-light text-muted w-25">Date of Birth</th><td id="prev_DOB" class="w-25">-</td>
                                <th class="bg-light text-muted w-25">Gender</th><td id="prev_Gender" class="w-25">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Blood Group</th><td id="prev_BloodGroup">-</td>
                                <th class="bg-light text-muted">Category / Quota</th><td id="prev_Category">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Mobile Number</th><td id="prev_Phone">-</td>
                                <th class="bg-light text-muted">Email Address</th><td id="prev_Email">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Aadhaar / ID</th><td colspan="3" id="prev_Aadhaar">-</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Parent & Address -->
                    <h6 class="fw-bold text-dark pb-1 border-bottom mt-3 small"><i class="bi bi-people me-1 text-primary"></i> Parents &amp; Residence</h6>
                    <table class="table table-sm table-bordered small mb-3">
                        <tbody>
                            <tr>
                                <th class="bg-light text-muted w-25">Father's Name</th><td id="prev_FatherName" class="w-25">-</td>
                                <th class="bg-light text-muted w-25">Father's Phone</th><td id="prev_FatherPhone" class="w-25">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Mother's Name</th><td id="prev_MotherName">-</td>
                                <th class="bg-light text-muted">Mother's Phone</th><td id="prev_MotherPhone">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Residential Address</th><td colspan="3" id="prev_Address">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Emergency Contact</th><td colspan="3" id="prev_Emergency">-</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Academic History & Facilities -->
                    <h6 class="fw-bold text-dark pb-1 border-bottom mt-3 small"><i class="bi bi-building me-1 text-primary"></i> Previous School &amp; Preferences</h6>
                    <table class="table table-sm table-bordered small mb-0">
                        <tbody>
                            <tr>
                                <th class="bg-light text-muted w-25">Previous School</th><td id="prev_PrevSchool" class="w-25">-</td>
                                <th class="bg-light text-muted w-25">Board &amp; Marks</th><td id="prev_PrevMarks" class="w-25">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Languages</th><td id="prev_Languages">-</td>
                                <th class="bg-light text-muted">Transport &amp; Hostel</th><td id="prev_Facilities">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-muted">Attached Files</th><td colspan="3" id="prev_Docs">-</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer bg-white border-top d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-pencil me-1"></i> Edit Details
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-dark rounded-pill px-3" onclick="printDraftApplication()">
                        <i class="bi bi-printer me-1"></i> Print Form
                    </button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" id="btnConfirmFinalSubmit">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirm &amp; Final Submit
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        }
        @@media print {
            body * { visibility: hidden; }
            #printableDraftApplication, #printableDraftApplication * { visibility: visible; }
            #printableDraftApplication { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
    <script>
        function previewPublicPhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#pubPhotoPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function printDraftApplication() {
            window.print();
        }

        function populatePreviewModal() {
            var fName = $("input[name='AA_FirstName']").val() || "";
            var mName = $("input[name='AA_MiddleName']").val() || "";
            var lName = $("input[name='AA_LastName']").val() || "";
            var fullName = [fName, mName, lName].filter(Boolean).join(" ");
            
            $("#prev_FullName").text(fullName || "Applicant Name");
            $("#prev_Branch").text($("#AA_BranchId option:selected").text() || "-");
            $("#prev_Year").text($("#AA_AcademicYearId option:selected").text() || "-");
            $("#prev_Class").text($("#AA_ClassId option:selected").text() || "-");
            $("#prev_Course").text($("#AA_CourseId option:selected").text() || "-");
            
            $("#prev_DOB").text($("input[name='AA_DateOfBirth']").val() || "-");
            $("#prev_Gender").text($("#AA_Gender option:selected").text() || "-");
            $("#prev_BloodGroup").text($("#AA_BloodGroup option:selected").text() || "-");
            $("#prev_Category").text($("#AA_Category option:selected").text() || "-");
            $("#prev_Phone").text($("input[name='AA_Phone']").val() || "-");
            $("#prev_Email").text($("input[name='AA_Email']").val() || "-");
            $("#prev_Aadhaar").text($("input[name='AA_AadhaarNumber']").val() || "Not Specified");

            $("#prev_FatherName").text($("input[name='AA_FatherName']").val() || "-");
            $("#prev_FatherPhone").text($("input[name='AA_FatherPhone']").val() || "-");
            $("#prev_MotherName").text($("input[name='AA_MotherName']").val() || "-");
            $("#prev_MotherPhone").text($("input[name='AA_MotherPhone']").val() || "-");

            var addr1 = $("input[name='AA_AddressLine1']").val() || "";
            var addr2 = $("input[name='AA_AddressLine2']").val() || "";
            var city = $("input[name='AA_City']").val() || "";
            var state = $("input[name='AA_State']").val() || "";
            var pin = $("input[name='AA_PostalCode']").val() || "";
            var fullAddr = [addr1, addr2, city, state, pin].filter(Boolean).join(", ");
            $("#prev_Address").text(fullAddr || "-");

            var emerName = $("input[name='AA_EmergencyContactName']").val() || "";
            var emerPhone = $("input[name='AA_EmergencyContactPhone']").val() || "";
            $("#prev_Emergency").text(emerName ? (emerName + " (" + emerPhone + ")") : "-");

            $("#prev_PrevSchool").text($("input[name='AA_PreviousSchool']").val() || "-");
            var board = $("input[name='AA_PreviousBoard']").val() || "";
            var marks = $("input[name='AA_PreviousMarks']").val() || "";
            $("#prev_PrevMarks").text([board, marks].filter(Boolean).join(" - ") || "-");

            var secLang = $("input[name='AA_SecondLanguage']").val() || "";
            var mothTongue = $("input[name='AA_MotherTongue']").val() || "";
            $("#prev_Languages").text("Second: " + (secLang || "None") + " | Mother: " + (mothTongue || "-"));

            var transport = $("#pub_RequiresTransport").is(":checked") ? "Bus Transport Requested" : "No Transport";
            var hostel = $("#pub_RequiresHostel").is(":checked") ? "Hostel Requested" : "No Hostel";
            $("#prev_Facilities").text(transport + " | " + hostel);

            var docs = [];
            if ($("input[name='BirthCertificateDoc']").val()) docs.push("Birth Certificate");
            if ($("input[name='MarksheetDoc']").val()) docs.push("Marksheet");
            if ($("input[name='TransferCertificateDoc']").val()) docs.push("TC");
            if ($("input[name='NationalIdDoc']").val()) docs.push("ID Card");
            $("#prev_Docs").text(docs.length > 0 ? docs.join(", ") : "None attached in draft");

            var photoSrc = $('#pubPhotoPreview').attr('src');
            $("#prev_Photo").attr('src', photoSrc);
        }

        $(function () {
            Dropdown.load({ element: '#AA_BranchId', entityType: 'Branch', defaultText: '-- Select Branch --', includeDefault: true });
            Dropdown.load({ element: '#AA_AcademicYearId', entityType: 'AcademicYear', defaultText: '-- Select Academic Year --', includeDefault: true });
            Dropdown.load({ element: '#AA_ClassId', entityType: 'Class', defaultText: '-- Select Class --', includeDefault: true });
            Dropdown.load({ element: '#AA_CourseId', entityType: 'Course', defaultText: '-- Select Course --', includeDefault: true });
            Dropdown.load({ element: '#AA_Gender', entityType: 'Gender', defaultText: '-- Select Gender --', includeDefault: true });
            Dropdown.load({ element: '#AA_BloodGroup', entityType: 'BloodGroup', defaultText: '-- Select Blood Group --', includeDefault: true });
            Dropdown.load({ element: '#AA_Category', entityType: 'Category', defaultText: '-- Select Category --', includeDefault: true });

            function clearValidationErrors($form) {
                $form.find(".is-invalid").removeClass("is-invalid");
                $form.find("span[asp-validation-for]").empty();
            }

            function applyFieldErrors($form, errors, defaultMsg) {
                clearValidationErrors($form);
                var firstEl = null;
                if (errors && typeof errors === "object") {
                    $.each(errors, function (fieldKey, msgs) {
                        var msg = Array.isArray(msgs) ? msgs.join(" ") : msgs;
                        var $el = $form.find("[name='" + fieldKey + "'], #" + fieldKey + ", [name='AA_" + fieldKey + "'], [name$='." + fieldKey + "']").first();
                        if ($el.length) {
                            $el.addClass("is-invalid");
                            var $valSpan = $form.find("span[asp-validation-for='" + fieldKey + "'], span[asp-validation-for='AA_" + fieldKey + "']").first();
                            if ($valSpan.length) {
                                $valSpan.text(msg).show();
                            }
                            if (!firstEl) firstEl = $el;
                        }
                    });
                }
                if (firstEl) {
                    firstEl[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstEl.focus();
                }
            }

            $("#admissionForm").on("input change", ".is-invalid", function () {
                $(this).removeClass("is-invalid");
                var name = $(this).attr("name") || $(this).attr("id");
                if (name) {
                    $("span[asp-validation-for='" + name + "']").empty();
                }
            });

            // Preview & Print Button Click Handler
            $("#btnPreviewApp").on("click", function () {
                var form = document.getElementById("admissionForm");
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                populatePreviewModal();
                var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("previewAppModal"));
                modal.show();
            });

            // Confirm & Final Submit from inside Modal
            $("#btnConfirmFinalSubmit").on("click", function () {
                var modalEl = document.getElementById("previewAppModal");
                var modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                $("#admissionForm").trigger("submit");
            });

            // AJAX Submission Handler
            $("#admissionForm").on("submit", function (e) {
                e.preventDefault();
                var form = this;
                var $form = $(form);
                clearValidationErrors($form);

                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                var formData = new FormData(form);
                var $btn = $("#btnDirectSubmit");
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Submitting...');

                $.ajax({
                    url: $form.attr("action"),
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (r) {
                        if (r.success) {
                            var appNo = r.applicationNumber || "APP-2026";
                            var fullName = $("input[name='AA_FirstName']").val() + " " + $("input[name='AA_LastName']").val();
                            var branch = $("#AA_BranchId option:selected").text();

                            $form.closest(".card-body").html(
                                '<div class="text-center py-4 px-2">' +
                                    '<div class="display-2 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>' +
                                    '<h3 class="fw-bold text-dark mb-1">Application Submitted Successfully!</h3>' +
                                    '<p class="text-muted fs-6 mb-4">Your application has been received and registered in our admissions system.</p>' +
                                    
                                    '<div class="card border border-2 border-primary-subtle bg-light mx-auto p-4 rounded-4 mb-4" style="max-width: 550px;">' +
                                        '<span class="text-muted small text-uppercase fw-bold letter-spacing-1 d-block mb-1">Your Application Reference Number</span>' +
                                        '<div class="d-flex align-items-center justify-content-center gap-2 mb-2">' +
                                            '<span class="fs-2 fw-bold text-primary font-monospace" id="confAppNum">' + appNo + '</span>' +
                                            '<button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-1 px-2" onclick="navigator.clipboard.writeText(\'' + appNo + '\'); if(window.toastr) toastr.success(\'Reference copied!\'); else alert(\'Copied: ' + appNo + '\');">' +
                                                '<i class="bi bi-clipboard me-1"></i> Copy' +
                                            '</button>' +
                                        '</div>' +
                                        '<small class="text-muted d-block">Please save this reference number to track your application status online.</small>' +
                                    '</div>' +

                                    '<div class="d-flex justify-content-center gap-3 flex-wrap">' +
                                        '<a href="/Home/TrackAdmission?appNumber=' + encodeURIComponent(appNo) + '" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">' +
                                            '<i class="bi bi-search me-1"></i> Track Live Application Status' +
                                        '</a>' +
                                        '<button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" onclick="window.print()">' +
                                            '<i class="bi bi-printer me-1"></i> Print Official Slip' +
                                        '</button>' +
                                        '<a href="/" class="btn btn-link text-muted rounded-pill px-3 py-2">' +
                                            'Back to Home' +
                                        '</a>' +
                                    '</div>' +
                                '</div>'
                            );
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        } else {
                            applyFieldErrors($form, r.errors, r.message);
                            if (window.toastr) toastr.error(r.message || "Please check the highlighted fields.");
                            else alert(r.message || "Please check the highlighted fields.");
                            $btn.prop("disabled", false).html('<i class="bi bi-send-fill me-2"></i> Submit Application');
                        }
                    },
                    error: function (xhr) {
                        var resp = xhr.responseJSON;
                        if (resp && resp.errors) {
                            applyFieldErrors($form, resp.errors, resp.message);
                        }
                        var msg = (resp && resp.message) ? resp.message : "Submission failed. Please try again.";
                        if (window.toastr) toastr.error(msg);
                        else alert(msg);
                        $btn.prop("disabled", false).html('<i class="bi bi-send-fill me-2"></i> Submit Application');
                    }
                });
            });
        });
    </script>
}
