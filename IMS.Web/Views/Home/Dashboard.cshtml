@section Scripts {
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initTrendChart();
        initStreamChart();
    });

    let trendChartInstance = null;

    const chartDatasets = {
        revenue: {
            label: "Fee Collection (₹ in Lakhs)",
            data: [12.4, 14.8, 16.2, 15.0, 18.4, 21.0, 19.5, 22.8, 20.4, 23.5, 24.8, 26.2],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.12)',
            fill: true,
            unit: '₹'
        },
        admissions: {
            label: "Student Admissions",
            data: [45, 62, 85, 120, 180, 240, 195, 110, 75, 90, 130, 160],
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.12)',
            fill: true,
            unit: ''
        },
        attendance: {
            label: "Average Attendance (%)",
            data: [92.1, 93.4, 94.0, 91.8, 95.2, 94.6, 93.8, 96.1, 94.8, 95.5, 96.0, 94.8],
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245, 158, 11, 0.12)',
            fill: true,
            unit: '%'
        }
    };

    const monthsLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    function initTrendChart() {
        const ctx = document.getElementById('trendChart').getContext('2d');
        const initial = chartDatasets.revenue;

        trendChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: monthsLabels,
                datasets: [{
                    label: initial.label,
                    data: initial.data,
                    borderColor: initial.borderColor,
                    backgroundColor: initial.backgroundColor,
                    tension: 0.4,
                    borderWidth: 2.5,
                    fill: initial.fill,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: initial.borderColor,
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#e2e8f0',
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 11 }, color: '#64748b' }
                    },
                    y: {
                        grid: { color: '#f1f5f9' },
                        ticks: { font: { size: 11 }, color: '#64748b' }
                    }
                }
            }
        });
    }

    function switchChartData(type) {
        document.querySelectorAll('.btn-chart-toggle').forEach(btn => btn.classList.remove('active'));
        if (type === 'revenue') document.getElementById('btnChartRevenue').classList.add('active');
        if (type === 'admissions') document.getElementById('btnChartAdmissions').classList.add('active');
        if (type === 'attendance') document.getElementById('btnChartAttendance').classList.add('active');

        const selected = chartDatasets[type];
        if (trendChartInstance && selected) {
            trendChartInstance.data.datasets[0].label = selected.label;
            trendChartInstance.data.datasets[0].data = selected.data;
            trendChartInstance.data.datasets[0].borderColor = selected.borderColor;
            trendChartInstance.data.datasets[0].backgroundColor = selected.backgroundColor;
            trendChartInstance.data.datasets[0].pointBorderColor = selected.borderColor;
            trendChartInstance.update();
        }
    }

    function initStreamChart() {
        const ctx = document.getElementById('streamChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Science', 'Commerce', 'Arts & Hum.', 'Tech / Voc.'],
                datasets: [{
                    data: [520, 350, 224, 154],
                    backgroundColor: ['#3b82f6', '#10b981', '#8b5cf6', '#f59e0b'],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#e2e8f0',
                        cornerRadius: 8,
                        padding: 10
                    }
                }
            }
        });
    }
</script>
