@model IMS.Models.ViewModels.TeacherAttendanceMarkTodayViewModel
@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-clipboard-user text-primary me-2"></i>Teacher Attendance</h4>
        <p class="text-muted small mb-0">Record and monitor daily faculty attendance and duty status.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label text-muted small mb-0 fw-semibold">Date</label>
        <input type="text" id="attendanceDatePicker" class="form-control form-control-sm d-inline-block w-auto ims-datepicker-input"
               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Teacher</th><th style="width:180px">Status</th><th>Remarks</th><th class="text-end" style="width:80px">Save</th></tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No active teachers found.</td></tr>
                }
                else
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr data-teacher-id="@row.TeacherId">
                            <td>
                                @row.TeacherName
                                @if (row.IsOnLeaveToday)
                                {
                                    <span class="badge bg-info text-dark ms-2">On Leave</span>
                                }
                            </td>
                            <td>
                                <select class="form-select form-select-sm attendance-status-select" data-selected-value="@(row.CurrentStatus)" @(row.IsOnLeaveToday ? "disabled" : "")></select>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm attendance-remarks-input" value="@row.Remarks" @(row.IsOnLeaveToday ? "disabled" : "") />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary mark-attendance-btn" @(row.IsOnLeaveToday ? "disabled" : "")>
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/teacherHr.css" />
    <script src="~/js/teacherAttendance.js"></script>
    <script>
        $(function () {
            IMSDatePicker.init('#attendanceDatePicker');
            $('.attendance-status-select').each(function () {
                Dropdown.load({ element: this, entityType: 'TeacherAttendanceStatus', defaultText: '-- Select --', includeDefault: false, selectedValue: $(this).data('selected-value') });
            });
        });
    </script>
}
