@model IMS.Models.ViewModels.EnrollmentIndexViewModel
@{
    ViewData["Title"] = "Student Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-user-plus text-primary me-2"></i>Student Enrollments</h4>
        <p class="text-muted mb-0 small">Manage school (Nursery to 12th grade) & higher education stream admissions and class allocations.</p>
    </div>
    <a asp-controller="Enrollment" asp-action="Create" class="btn btn-primary px-3 shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> New Enrollment
    </a>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Enrollment", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-lg-3 col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control form-control-sm", @placeholder = "Enrollment #, Roll #, Student..." })
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold">Academic Year</label>
                <select name="academicYearId" class="form-select form-select-sm" asp-items="Model.AcademicYearOptions">
                    <option value="">All Academic Years</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold">Class (K-12)</label>
                <select name="classId" class="form-select form-select-sm" asp-items="Model.ClassOptions">
                    <option value="">All Classes (Nursery-12)</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-2">
                <label class="form-label small fw-semibold">Section</label>
                <select name="sectionId" class="form-select form-select-sm" asp-items="Model.SectionOptions">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold">Stream / Course</label>
                <select name="courseId" class="form-select form-select-sm" asp-items="Model.CourseOptions">
                    <option value="">All Courses / Streams</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="Model.StatusOptions">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-3 d-grid">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<!-- Enrollments Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th>Enrollment #</th>
                    <th>Student Name</th>
                    <th>Class & Section</th>
                    <th>Stream / Course</th>
                    <th>Roll #</th>
                    <th>Academic Year</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Enrollments.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-folder-open fa-2x mb-2 d-block text-secondary opacity-50"></i>
                            No enrollment records found matching the criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var e in Model.Enrollments)
                    {
                        <tr id="enrollment-row-@e.E_Id">
                            <td>
                                <a asp-action="Details" asp-route-id="@e.E_Id" class="fw-bold text-decoration-none">
                                    @e.E_EnrollmentNumber
                                </a>
                                @if (!string.IsNullOrEmpty(e.E_EnrollmentType))
                                {
                                    <div class="text-muted extra-small" style="font-size: 0.75rem;">@e.E_EnrollmentType</div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@e.StudentName</div>
                                @if (!string.IsNullOrEmpty(e.StudentCode))
                                {
                                    <small class="text-muted">Code: @e.StudentCode</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.ClassName) && e.ClassName != "-")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">
                                        @e.ClassName
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(e.SectionName) && e.SectionName != "-")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        Sec: @e.SectionName
                                    </span>
                                }
                                @if (string.IsNullOrEmpty(e.ClassName) && string.IsNullOrEmpty(e.SectionName))
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div>@(e.CourseName != "-" ? e.CourseName : "-")</div>
                                @if (e.BatchName != "-")
                                {
                                    <small class="text-muted">Batch: @e.BatchName</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.E_RollNumber) && e.E_RollNumber != "-")
                                {
                                    <span class="badge bg-light text-dark border">@e.E_RollNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@e.AcademicYearName</td>
                            <td>@e.E_EnrollmentDate.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <span class="badge @StatusBadge(e.E_Status)">@e.E_Status</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@e.E_Id" class="btn btn-outline-secondary" title="View Details"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@e.E_Id" class="btn btn-outline-primary" title="Edit Enrollment"><i class="fa-solid fa-pen"></i></a>
                                    <button type="button" class="btn btn-outline-danger enroll-delete-btn" data-id="@e.E_Id" title="Delete Enrollment"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@functions {
    string StatusBadge(string? s) => s switch
    {
        "Active" => "bg-success",
        "Completed" => "bg-info text-dark",
        "Withdrawn" => "bg-warning text-dark",
        "Transferred" => "bg-primary",
        "Suspended" => "bg-danger",
        _ => "bg-secondary"
    };
}

@section Scripts {
<script>
$(function () {
    if ($.fn.DataTable && $('#dataTable tbody tr td').length > 1) {
        $('#dataTable').DataTable({
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            order: [[0, 'desc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search table..."
            }
        });
    }

    $(document).on("click", ".enroll-delete-btn", function () {
        var id = $(this).data("id");
        if (!confirm("Are you sure you want to delete this student enrollment record?")) return;

        $.ajax({
            url: "/Enrollment/DeleteEnrollment/" + id,
            type: "POST",
            data: { __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val() },
            success: function (r) {
                if (r.success) {
                    if (window.toastr) toastr.success(r.message || "Enrollment deleted.");
                    $("#enrollment-row-" + id).fadeOut(300, function () { $(this).remove(); });
                } else {
                    if (window.toastr) toastr.error(r.message || "Delete failed.");
                }
            },
            error: function () {
                if (window.toastr) toastr.error("Server communication error.");
            }
        });
    });
});
</script>
}
