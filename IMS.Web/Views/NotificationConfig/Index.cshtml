@model IMS.Models.Notification.NotificationConfigModel
@{
    ViewData["Title"] = "Notification Settings";
}

@section Styles {
<style>
    .config-card {
        border-radius: 12px;
        border: 1px solid var(--IMS-border, #e2e8f0);
        box-shadow: var(--IMS-card-shadow, 0 1px 3px rgba(0, 0, 0, 0.05));
        background-color: var(--IMS-surface, #ffffff);
        transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    .config-card-header {
        background-color: var(--IMS-surface-hover, #f8fafc);
        border-bottom: 1px solid var(--IMS-border, #e2e8f0);
    }

    .config-table th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--IMS-table-header-text, #64748b);
        background-color: var(--IMS-table-header-bg, #f8fafc);
        border-bottom: 1px solid var(--IMS-table-border, #e2e8f0);
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
    }

    .config-table td {
        padding-top: 0.95rem;
        padding-bottom: 0.95rem;
        border-bottom: 1px solid var(--IMS-table-border, #f1f5f9);
        vertical-align: middle;
        color: var(--IMS-text, #0f172a);
    }

    .config-table tbody tr:hover {
        background-color: var(--IMS-table-row-hover, #f8fafc);
    }

    .form-switch .form-check-input {
        cursor: pointer;
        width: 2.5rem;
        height: 1.3rem;
        background-color: var(--IMS-input-border, #cbd5e1);
        border-color: var(--IMS-input-border, #cbd5e1);
    }

    .form-switch .form-check-input:checked {
        background-color: var(--IMS-primary, #3b82f6);
        border-color: var(--IMS-primary, #3b82f6);
    }

    .nav-tabs {
        border-bottom: 1px solid var(--IMS-border, #e2e8f0);
    }

    .nav-tabs .nav-link {
        color: var(--IMS-text-muted, #64748b);
        font-size: 0.9rem;
        font-weight: 500;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.65rem 1.25rem;
        background: transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .nav-tabs .nav-link:hover {
        color: var(--IMS-text, #0f172a);
        border-bottom-color: var(--IMS-border, #cbd5e1);
    }

    .nav-tabs .nav-link.active {
        color: var(--IMS-primary, #3b82f6);
        font-weight: 600;
        border-bottom: 2px solid var(--IMS-primary, #3b82f6);
        background: transparent;
    }

    .btn-test-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        color: var(--IMS-text-muted, #64748b);
        border: 1px solid var(--IMS-border, #cbd5e1);
        background-color: var(--IMS-surface, #ffffff);
        transition: all 0.2s ease;
    }

    .btn-test-action:hover {
        color: var(--IMS-primary, #3b82f6);
        border-color: var(--IMS-primary, #3b82f6);
        background-color: var(--IMS-primary-soft, rgba(59, 130, 246, 0.1));
    }

    .config-badge {
        background-color: var(--IMS-surface-hover, #f1f5f9);
        color: var(--IMS-text-muted, #64748b);
        border: 1px solid var(--IMS-border, #e2e8f0);
        font-weight: 500;
    }

    .config-divider {
        border-right: 1px solid var(--IMS-border, #e2e8f0);
    }
    @@media (max-width: 767.98px) {
        .config-divider {
            border-right: none;
            border-bottom: 1px solid var(--IMS-border, #e2e8f0);
            padding-bottom: 1rem;
        }
    }
</style>
}

<div class="container-fluid p-3 p-lg-4">

    <!-- Page Title & Actions -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="mb-0 fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i>Notification Settings</h4>
            <p class="text-muted small mb-0">Manage system-wide event triggers, in-app alerts, and SMTP transactional mail delivery.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="triggerSampleEvent('ADMISSION_SUBMITTED')">
                <i class="fa-solid fa-play me-1"></i> Quick Test
            </button>
            <button type="button" class="btn btn-primary btn-sm px-4" onclick="document.getElementById('configForm').submit()">
                <i class="fa-solid fa-check me-1"></i> Save Settings
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="configForm" asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TenantId" />

        <!-- Master Global Switches -->
        <div class="config-card mb-4">
            <div class="p-3 p-md-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6 config-divider">
                        <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0 pe-md-4 mb-0">
                            <div>
                                <label class="form-check-label fw-semibold mb-0" for="InAppEnabled">
                                    Enable In-App Notifications
                                </label>
                                <div class="text-muted small">Header bell icon unread alerts</div>
                            </div>
                            <input class="form-check-input m-0" type="checkbox" asp-for="InAppEnabled" role="switch" id="InAppEnabled">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0 ps-md-4 mb-0">
                            <div>
                                <label class="form-check-label fw-semibold mb-0" for="EmailEnabled">
                                    Enable Email Notifications
                                </label>
                                <div class="text-muted small">Outbound transactional SMTP alerts</div>
                            </div>
                            <input class="form-check-input m-0" type="checkbox" asp-for="EmailEnabled" role="switch" id="EmailEnabled">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="events-tab" data-bs-toggle="tab" data-bs-target="#eventsPane" type="button" role="tab">
                    <i class="fa-regular fa-bell me-1"></i> Event Triggers
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtpPane" type="button" role="tab">
                    <i class="fa-regular fa-envelope me-1"></i> Email (SMTP) Configuration
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- Tab 1: Event Triggers Grid -->
            <div class="tab-pane fade show active" id="eventsPane" role="tabpanel">
                <div class="config-card overflow-hidden">
                    <div class="table-responsive">
                        <table class="table config-table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 48%;">Event & Description</th>
                                    <th style="width: 16%;">Category</th>
                                    <th class="text-center" style="width: 14%;">In-App Alert</th>
                                    <th class="text-center" style="width: 14%;">Email Alert</th>
                                    <th class="text-center pe-4" style="width: 8%;">Test</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Events != null && Model.Events.Count > 0)
                                {
                                    for (int i = 0; i < Model.Events.Count; i++)
                                    {
                                        var ev = Model.Events[i];
                                        <tr>
                                             <td class="ps-4">
                                                <input type="hidden" name="Events[@i].EventCode" value="@ev.EventCode" />
                                                <input type="hidden" name="Events[@i].EventName" value="@ev.EventName" />
                                                <input type="hidden" name="Events[@i].Category" value="@ev.Category" />
                                                <input type="hidden" name="Events[@i].Description" value="@ev.Description" />
                                                <input type="hidden" name="Events[@i].IconClass" value="@ev.IconClass" />
                                                <input type="hidden" name="Events[@i].ColorClass" value="@ev.ColorClass" />

                                                <div class="fw-semibold mb-1">@ev.EventName</div>
                                                <div class="text-muted small text-truncate" style="max-width: 450px;">@ev.Description</div>
                                            </td>
                                            <td>
                                                <span class="badge config-badge px-2 py-1">@ev.Category</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-inline-block mb-0">
                                                    <input class="form-check-input" type="checkbox" name="Events[@i].InAppEnabled" value="true" @(ev.InAppEnabled ? "checked" : "") role="switch" />
                                                    <input type="hidden" name="Events[@i].InAppEnabled" value="false" />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-inline-block mb-0">
                                                    <input class="form-check-input" type="checkbox" name="Events[@i].EmailEnabled" value="true" @(ev.EmailEnabled ? "checked" : "") role="switch" />
                                                    <input type="hidden" name="Events[@i].EmailEnabled" value="false" />
                                                </div>
                                            </td>
                                            <td class="text-center pe-4">
                                                <button type="button" class="btn btn-sm btn-test-action" onclick="triggerSampleEvent('@ev.EventCode')" title="Trigger test notification">
                                                    <i class="fa-solid fa-play small"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No events found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tab 2: SMTP Configuration -->
            <div class="tab-pane fade" id="smtpPane" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="config-card">
                            <div class="p-3 p-md-4 config-card-header">
                                <h6 class="mb-0 fw-bold">SMTP Server Settings</h6>
                            </div>
                            <div class="p-3 p-md-4">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label class="form-label small fw-semibold">SMTP Host</label>
                                        <input type="text" class="form-control" asp-for="SmtpHost" placeholder="smtp.gmail.com" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold">Port</label>
                                        <input type="number" class="form-control" asp-for="SmtpPort" placeholder="587" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Username / Email</label>
                                        <input type="text" class="form-control" asp-for="SmtpUsername" placeholder="user@domain.com" autocomplete="off" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Password / App Password</label>
                                        <input type="password" class="form-control" asp-for="SmtpPassword" placeholder="••••••••" autocomplete="new-password" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">From Email</label>
                                        <input type="email" class="form-control" asp-for="FromEmail" placeholder="noreply@domain.com" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">From Name</label>
                                        <input type="text" class="form-control" asp-for="FromName" placeholder="IMS ERP" />
                                    </div>

                                    <div class="col-12 mt-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="EnableSsl" id="EnableSsl" role="switch" />
                                            <label class="form-check-label small fw-semibold" for="EnableSsl">Enable SSL / TLS encryption</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="config-card">
                            <div class="p-3 p-md-4 config-card-header">
                                <h6 class="mb-0 fw-bold">Test Email Delivery</h6>
                            </div>
                            <div class="p-3 p-md-4">
                                <p class="text-muted small mb-3">Send a real-time verification email to ensure your SMTP server and credentials authenticate properly.</p>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Recipient Email Address</label>
                                    <input type="email" id="testRecipientEmail" class="form-control" placeholder="admin@domain.com" />
                                </div>
                                <button type="button" class="btn btn-outline-primary w-100" id="btnSendTestEmail" onclick="sendTestEmail()">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Send Test Email
                                </button>
                                <div id="testEmailResult" class="d-none alert mt-3 mb-0 py-2 small"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>

</div>

@section Scripts {
<script>
    async function sendTestEmail() {
        const toEmail = document.getElementById('testRecipientEmail').value;
        const resultDiv = document.getElementById('testEmailResult');
        const btn = document.getElementById('btnSendTestEmail');

        if (!toEmail) {
            resultDiv.className = 'alert alert-warning mt-3 mb-0 py-2 small';
            resultDiv.textContent = 'Please enter a recipient email address.';
            resultDiv.classList.remove('d-none');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Sending...';
        resultDiv.className = 'alert alert-info mt-3 mb-0 py-2 small';
        resultDiv.textContent = 'Connecting to mail server...';
        resultDiv.classList.remove('d-none');

        const payload = {
            toEmail: toEmail,
            smtpHost: document.getElementById('SmtpHost').value,
            smtpPort: parseInt(document.getElementById('SmtpPort').value) || 587,
            smtpUsername: document.getElementById('SmtpUsername').value,
            smtpPassword: document.getElementById('SmtpPassword').value,
            fromEmail: document.getElementById('FromEmail').value,
            fromName: document.getElementById('FromName').value,
            enableSsl: document.getElementById('EnableSsl').checked
        };

        try {
            const response = await fetch('/NotificationConfig/SendTestEmail', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Send Test Email';

            if (data.success) {
                resultDiv.className = 'alert alert-success mt-3 mb-0 py-2 small';
                resultDiv.textContent = data.message;
            } else {
                resultDiv.className = 'alert alert-danger mt-3 mb-0 py-2 small';
                resultDiv.textContent = data.message;
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Send Test Email';
            resultDiv.className = 'alert alert-danger mt-3 mb-0 py-2 small';
            resultDiv.textContent = 'Network or server error while executing test.';
        }
    }

    async function triggerSampleEvent(eventCode) {
        try {
            const response = await fetch('/NotificationConfig/TriggerSample?eventCode=' + encodeURIComponent(eventCode), {
                method: 'POST'
            });
            const data = await response.json();
            if (data.success) {
                if (window.toastr) toastr.success(data.message);
                else alert(data.message);
                if (window.refreshHeaderNotifications) {
                    window.refreshHeaderNotifications();
                }
            } else {
                if (window.toastr) toastr.error(data.message);
                else alert(data.message);
            }
        } catch (e) {
            if (window.toastr) toastr.error('Error triggering notification');
        }
    }
</script>
}
