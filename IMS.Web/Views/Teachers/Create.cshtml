@model IMS.Models.Teacher.TeacherFormViewModel
@{
    ViewData["Title"] = "Add Teacher";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Add Teacher</h3>
    <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="teacherCreateForm">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/teacher.js"></script>
    <script>
        $(function () {
            Dropdown.load({ element: '#T_BranchId', entityType: 'Branch', defaultText: 'Select Branch', includeDefault: true });
            Dropdown.load({ element: '#T_Designation', entityType: 'Designation', defaultText: 'Select Designation', includeDefault: true });
            Dropdown.load({ element: '#CustomRoleId', entityType: 'TeacherRole', defaultText: 'Select Role', includeDefault: true });
            Dropdown.load({ element: '#T_Status', entityType: 'TeacherStatus', defaultText: '-- Select --', includeDefault: false });
            Dropdown.load({ element: '#T_BloodGroup', entityType: 'BloodGroup', defaultText: 'Select Blood Group', includeDefault: true });
            IMSDatePicker.init('#T_JoiningDate');
        });
    </script>
}