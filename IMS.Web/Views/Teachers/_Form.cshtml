@model IMS.Models.Teacher.TeacherFormViewModel

@if (Model.T_Id.HasValue)
{
    @Html.HiddenFor(m => m.T_Id)
}

<h6 class="text-muted mb-3">Account</h6>
<div class="row g-3">
    <div class="col-md-4">
        <label for="Email" class="form-label">Email</label>
        @if (Model.T_Id.HasValue)
        {
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light text-muted", @readonly = "readonly", tabindex = "-1" })
        }
        else
        {
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        }
        <div class="text-danger small field-error" data-for="Email"></div>
    </div>
    @if (!Model.T_Id.HasValue)
    {
        <div class="col-md-4">
            <label for="Password" class="form-label">Password</label>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            <div id="passwordHint" class="form-text small text-muted">
                Min 8 characters, with uppercase, lowercase, a number and a symbol.
            </div>
        </div>
    }
    <div class="col-md-4">
        <label for="CustomRoleId" class="form-label">Role</label>
        <select id="CustomRoleId" name="CustomRoleId" class="form-select" data-selected-value="@(Model.CustomRoleId)"></select>
        <div class="text-danger small field-error" data-for="CustomRoleId"></div>
    </div>

    <div class="col-md-4">
        <label for="FirstName" class="form-label">First Name</label>
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
        <div class="text-danger small field-error" data-for="FirstName"></div>
    </div>
    <div class="col-md-4">
        <label for="LastName" class="form-label">Last Name</label>
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
        <div class="text-danger small field-error" data-for="LastName"></div>
    </div>
    <div class="col-md-4">
        <label for="Phone" class="form-label">Phone</label>
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
        <div class="text-danger small field-error" data-for="Phone"></div>
    </div>
</div>

<hr class="my-4" />
<h6 class="text-muted mb-3">Employment</h6>
<div class="row g-3">
    <div class="col-md-4">
        <label for="T_BranchId" class="form-label">Branch</label>
        <select id="T_BranchId" name="T_BranchId" class="form-select" data-selected-value="@(Model.T_BranchId.ToString())"></select>
        <div class="text-danger small field-error" data-for="T_BranchId"></div>
    </div>
    <div class="col-md-4">
        <label for="T_EmployeeCode" class="form-label">Employee Code</label>
        @Html.TextBoxFor(m => m.T_EmployeeCode, new { @class = "form-control bg-light text-muted", @readonly = "readonly", tabindex = "-1", placeholder = "Auto-generated" })
    </div>
    <div class="col-md-4">
        <label for="T_JoiningDate" class="form-label">Joining Date</label>
        @Html.TextBoxFor(m => m.T_JoiningDate, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input" })
    </div>

    <div class="col-md-4">
        <label for="T_Designation" class="form-label">Designation</label>
        <select id="T_Designation" name="T_Designation" class="form-select" data-selected-value="@Model.T_Designation"></select>
    </div>
    <div class="col-md-4">
        <label for="T_Department" class="form-label">Department</label>
        @Html.TextBoxFor(m => m.T_Department, new { @class = "form-control" })
    </div>
    <div class="col-md-4">
        <label for="T_Status" class="form-label">Status</label>
        <select id="T_Status" name="T_Status" class="form-select" data-selected-value="@(Model.T_Status)"></select>
        <div class="text-danger small field-error" data-for="T_Status"></div>
    </div>

    <div class="col-md-4">
        <label for="T_Qualification" class="form-label">Qualification</label>
        @Html.TextBoxFor(m => m.T_Qualification, new { @class = "form-control" })
    </div>
    <div class="col-md-4">
        <label for="T_ExperienceYears" class="form-label">Experience (Years)</label>
        @Html.TextBoxFor(m => m.T_ExperienceYears, new { @class = "form-control", type = "number", min = "0" })
    </div>
    <div class="col-md-4">
        <label for="T_BloodGroup" class="form-label">Blood Group</label>
        <select id="T_BloodGroup" name="T_BloodGroup" class="form-select" data-selected-value="@(Model.T_BloodGroup)"></select>
    </div>
</div>

<hr class="my-4" />
<h6 class="text-muted mb-3">Address</h6>
<div class="row g-3">
    <div class="col-md-6">
        <label for="AddressLine1" class="form-label">Address Line 1</label>
        @Html.TextBoxFor(m => m.AddressLine1, new { @class = "form-control" })
    </div>
    <div class="col-md-6">
        <label for="AddressLine2" class="form-label">Address Line 2</label>
        @Html.TextBoxFor(m => m.AddressLine2, new { @class = "form-control" })
    </div>
    <div class="col-md-3">
        <label for="City" class="form-label">City</label>
        @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
    </div>
    <div class="col-md-3">
        <label for="State" class="form-label">State</label>
        @Html.TextBoxFor(m => m.State, new { @class = "form-control" })
    </div>
    <div class="col-md-3">
        <label for="PostalCode" class="form-label">Postal Code</label>
        @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control" })
    </div>
    <div class="col-md-3">
        <label for="Country" class="form-label">Country</label>
        @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Save Teacher
    </button>
</div>