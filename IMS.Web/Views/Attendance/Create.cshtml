@model IMS.Models.ViewModels.AttendanceSessionFormViewModel
@{ ViewData["Title"] = "Create Attendance Session"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-calendar-check me-2"></i>Create Attendance Session</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="attendanceCreateForm" asp-controller="Attendance" asp-action="AddSession" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/attendance.js"></script>
    <script>
        $(function () {
            IMSAttendanceSessionForm.init('/Attendance/AddSession');
            IMSDatePicker.init({ input: '#AS_AttendanceDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

            Dropdown.load({ element: '#AS_BranchId', entityType: 'Branch', defaultText: 'Select Branch', includeDefault: true });
            Dropdown.load({ element: '#AS_BatchId', entityType: 'Batch', defaultText: 'Select Batch', includeDefault: true });
            Dropdown.load({ element: '#AS_SubjectId', entityType: 'Subject', defaultText: 'Select Subject', includeDefault: true });
            Dropdown.load({ element: '#AS_StaffId', entityType: 'Staff', defaultText: 'Select Staff', includeDefault: true });
        });
    </script>
}
