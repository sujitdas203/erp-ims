@model IMS.Models.ViewModels.AttendanceSessionIndexViewModel
@{
    ViewData["Title"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Student Attendance</h4>
        <p class="text-muted small mb-0">Record and track daily classroom student attendance sessions.</p>
    </div>
    <a asp-controller="Attendance" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> New Session
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Attendance", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Batch or subject" })
            </div>
            <div class="col-md-2">
                @Html.Label("branchId", "Branch", new { @class = "form-label" })
                <select name="branchId" id="filterBranchId" class="form-select" data-selected-value="@(Model.BranchFilter?.ToString())">
                </select>
            </div>
            <div class="col-md-2">
                <label for="date" class="form-label">Date</label>
                <input type="text" name="date" class="form-control ims-datepicker-input" value="@(Model.DateFilter?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fa-solid fa-search me-1"></i> Filter
                </button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Batch</th>
                    <th>Subject</th>
                    <th>Staff</th>
                    <th>Time</th>
                    <th>Present</th>
                    <th>Absent</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr id="session-row-@s.AS_Id">
                        <td>@s.AS_AttendanceDate.ToString("dd-MMM-yyyy")</td>
                        <td>@s.BatchName</td>
                        <td>@s.SubjectName</td>
                        <td>@s.StaffName</td>
                        <td>@s.AS_StartTime - @s.AS_EndTime</td>
                        <td><span class="badge bg-success">@s.PresentCount</span></td>
                        <td><span class="badge bg-danger">@s.AbsentCount</span></td>
                        <td class="text-end">
                            <a asp-controller="Attendance" asp-action="MarkAttendance" asp-route-id="@s.AS_Id"
                               class="btn btn-sm btn-outline-success" title="Mark Attendance"><i class="fa-solid fa-check-double"></i></a>
                            <a asp-controller="Attendance" asp-action="Edit" asp-route-id="@s.AS_Id"
                               class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                    data-id="@s.AS_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@s.AS_Id" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                            <div class="modal fade" id="deleteModal-@s.AS_Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Delete Session</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">Are you sure you want to delete this attendance session?</div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/attendance.js"></script>
    <script>$(function () {
        $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[0, 'desc']] });
        Dropdown.load({ element: '#filterBranchId', entityType: 'Branch', defaultText: 'All Branches', includeDefault: true, selectedValue: $('#filterBranchId').data('selected-value') });
        IMSDatePicker.init('#date');
    });</script>
}
