@model IMS.Models.HomeTask.HomeTaskDetailsViewModel
@{
    ViewData["Title"] = "Home Task Details";

    var isOverdue = Model.Task.HT_DueDate < DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-journal-text me-2"></i>Home Task Details</h3>
    <div class="d-flex gap-2">
        <a asp-controller="HomeTasks" asp-action="Edit" asp-route-id="@Model.Task.HT_Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Task
        </a>
        <a asp-controller="HomeTasks" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<!-- Task Header Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <h4 class="mb-1 text-primary fw-bold">@Model.Task.HT_Title</h4>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-secondary"><i class="bi bi-collection me-1"></i>@Model.Task.BatchName</span>
                    <span class="badge bg-info text-dark"><i class="bi bi-book me-1"></i>@Model.Task.SubjectName</span>
                    @if (Model.Task.HT_IsActive)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-pause-circle me-1"></i>Inactive</span>
                    }
                </div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Due Date</div>
                <div class="fw-bold @(isOverdue ? "text-danger" : "text-dark") fs-5">
                    <i class="bi bi-calendar-event me-1"></i>@Model.Task.HT_DueDate.ToString("dd MMM yyyy")
                </div>
                @if (isOverdue)
                {
                    <span class="badge bg-danger">Past Due</span>
                }
            </div>
        </div>

        <div class="row g-3 py-3 border-top border-bottom bg-light rounded px-2 my-2">
            <div class="col-md-3">
                <span class="text-muted small d-block">Assigned Teacher</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Task.TeacherName) ? "Not Assigned" : Model.Task.TeacherName)</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Max Marks</span>
                <strong>@(Model.Task.HT_MaxMarks.HasValue ? Model.Task.HT_MaxMarks.Value.ToString("0.##") : "Not Graded")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Created On</span>
                <span>@Model.Task.HT_CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Total Submissions</span>
                <span class="badge bg-primary fs-6">@Model.Task.SubmissionCount</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Task.HT_Description))
        {
            <div class="mt-3">
                <h6 class="fw-bold text-secondary">Instructions / Description:</h6>
                <div class="p-3 bg-white border rounded text-dark" style="white-space: pre-line;">@Model.Task.HT_Description</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Task.HT_AttachmentUrl))
        {
            <div class="mt-3">
                <h6 class="fw-bold text-secondary">Attachment / Resource:</h6>
                <a href="@Model.Task.HT_AttachmentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-paperclip me-1"></i> Open Attachment
                </a>
            </div>
        }
    </div>
</div>

<!-- Submissions List -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-dark"><i class="bi bi-people me-2"></i>Student Submissions (@Model.Submissions.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Submissions.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                <p class="text-muted mt-2 mb-0">No submissions received yet for this task.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Submitted On</th>
                            <th>Status</th>
                            <th>Marks Obtained</th>
                            <th>Attachment</th>
                            <th>Teacher Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model.Submissions)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@sub.StudentName</div>
                                    <small class="text-muted">Code: @sub.StudentCode</small>
                                </td>
                                <td>
                                    <span>@sub.SubmissionDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    @if (sub.SubmissionDate.Date > Model.Task.HT_DueDate.Date)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Late</span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Status == "Evaluated")
                                    {
                                        <span class="badge bg-success">Evaluated</span>
                                    }
                                    else if (sub.Status == "Submitted")
                                    {
                                        <span class="badge bg-primary">Submitted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@sub.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (sub.MarksObtained.HasValue)
                                    {
                                        <strong>@sub.MarksObtained.Value.ToString("0.##")</strong>
                                        @if (Model.Task.HT_MaxMarks.HasValue)
                                        {
                                            <span class="text-muted small"> / @Model.Task.HT_MaxMarks.Value.ToString("0.##")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(sub.AttachmentUrl))
                                    {
                                        <a href="@sub.AttachmentUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-file-earmark-arrow-down"></i> View File
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(sub.TeacherRemarks) ? "-" : sub.TeacherRemarks)</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
