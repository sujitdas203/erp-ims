@model IMS.Models.HomeTask.HomeTaskFormViewModel
@{
    ViewData["Title"] = "Add Home Task";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Add Home Task</h3>
    <a asp-controller="HomeTasks" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm("CreateAjax", "HomeTasks", FormMethod.Post, new { id = "homeTaskCreateForm" }))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/hometasks.js"></script>
}
