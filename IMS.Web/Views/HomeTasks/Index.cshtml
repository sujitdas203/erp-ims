@model IMS.Models.HomeTask.HomeTaskIndexViewModel
@{
    ViewData["Title"] = "Home Tasks & Homework";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-list-check text-primary me-2"></i>Home Tasks &amp; Homework</h4>
        <p class="text-muted small mb-0">Assign, track, and review homework assignments and submissions.</p>
    </div>
    <a asp-controller="HomeTasks" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> Add Home Task
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "HomeTasks", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("search", "Search", new { @class = "form-label" })
                @Html.TextBox("search", Model.SearchTerm, new { @class = "form-control", placeholder = "Task title or keyword" })
            </div>
            <div class="col-md-3">
                @Html.Label("batchId", "Batch", new { @class = "form-label" })
                @Html.DropDownList("batchId", Model.BatchOptions, "All Batches", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                @Html.Label("subjectId", "Subject", new { @class = "form-label" })
                @Html.DropDownList("subjectId", Model.SubjectOptions, "All Subjects", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Batch</th>
                    <th>Subject</th>
                    <th>Task Title</th>
                    <th>Assigned Date</th>
                    <th>Due Date</th>
                    <th>Max Marks</th>
                    <th>Submissions</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="homeTasksTableBody">
                @if (!Model.Tasks.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No home tasks found.</td></tr>
                }
                else
                {
                    foreach (var t in Model.Tasks)
                    {
                        <tr id="task-row-@t.HT_Id">
                            <td><span class="badge bg-light text-dark border">@t.BatchName</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@t.SubjectName</span></td>
                            <td>
                                <strong>@t.HT_Title</strong>
                                @if (!string.IsNullOrEmpty(t.TeacherName))
                                {
                                    <div class="text-muted small">By: @t.TeacherName</div>
                                }
                            </td>
                            <td>@t.HT_AssignedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (t.HT_DueDate < DateTime.Today && t.HT_Status == "Active")
                                {
                                    <span class="text-danger fw-semibold">@t.HT_DueDate.ToString("dd MMM yyyy")</span>
                                }
                                else
                                {
                                    <span>@t.HT_DueDate.ToString("dd MMM yyyy")</span>
                                }
                            </td>
                            <td>@(t.HT_MaxMarks.HasValue ? t.HT_MaxMarks.Value.ToString("N0") : "-")</td>
                            <td>
                                <a asp-controller="HomeTasks" asp-action="Details" asp-route-id="@t.HT_Id" class="badge bg-info text-dark text-decoration-none">
                                    <i class="bi bi-people me-1"></i>@t.SubmissionCount
                                </a>
                            </td>
                            <td>
                                <span class="badge @(t.HT_Status == "Active" ? "bg-success" : "bg-secondary")">
                                    @t.HT_Status
                                </span>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input toggle-active-switch"
                                           data-id="@t.HT_Id" @(t.HT_IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-controller="HomeTasks" asp-action="Details" asp-route-id="@t.HT_Id"
                                   class="btn btn-sm btn-outline-secondary" title="View Submissions"><i class="bi bi-eye"></i></a>
                                <a asp-controller="HomeTasks" asp-action="Edit" asp-route-id="@t.HT_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@t.HT_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@t.HT_Id" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <div class="modal fade" id="deleteModal-@t.HT_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Home Task</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                Are you sure you want to delete "<strong>@t.HT_Title</strong>"? This will also remove any student submissions.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { batchId = Model.BatchFilter, subjectId = Model.SubjectFilter, status = Model.StatusFilter, search = Model.SearchTerm, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/hometasks.js"></script>
}
