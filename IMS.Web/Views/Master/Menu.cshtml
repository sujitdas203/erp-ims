@* IMS.Web/Views/Master/Menu.cshtml *@
@model List<IMS.Models.Common.Master.MasterConfig>
@{
    ViewData["Title"] = "Master Management Overview";
    var groupedMasters = Model.GroupBy(m => m.GroupName).ToList();
}

<div class="container-fluid py-4 px-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-layer-group text-primary me-2"></i>Master Management
            </h3>
            <p class="text-muted mb-0 small">
                Configure and manage core institutional master data structured according to school management hierarchy and cascading dependencies.
            </p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-7">
            <i class="fa-solid fa-cubes me-1"></i> @Model.Count Active Masters
        </span>
    </div>

    <!-- Groups -->
    @foreach (var group in groupedMasters)
    {
        var groupIcon = group.Key switch
        {
            "Academic Structure" => "fa-solid fa-graduation-cap",
            "Staff & Administration" => "fa-solid fa-user-tie",
            "Fee & Finance" => "fa-solid fa-coins",
            "Examinations & Grading" => "fa-solid fa-square-poll-vertical",
            "Operations & System" => "fa-solid fa-sliders",
            _ => "fa-solid fa-folder-open"
        };

        var groupDesc = group.Key switch
        {
            "Academic Structure" => "Top-down institutional hierarchy (Academic Year → Branch → Department / Classroom → Program → Course → Subject → Batch)",
            "Staff & Administration" => "Staff roles, designations, and required institutional documentation policies",
            "Fee & Finance" => "Fee structures, scholarships, payment channels, and operational expense categories",
            "Examinations & Grading" => "Assessment types, exam configurations, and grade scale thresholds",
            "Operations & System" => "External vendors, suppliers, and automated messaging notification templates",
            _ => "Core lookup and configuration masters"
        };

        <div class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="@groupIcon"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">@group.Key</h5>
                    <div class="text-muted small">@groupDesc</div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                @foreach (var config in group.OrderBy(m => m.MenuOrder))
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <a href="/Master/@config.EntityType" class="text-decoration-none h-100">
                            <div class="card h-100 border shadow-sm master-overview-card transition-all">
                                <div class="card-body p-3 d-flex align-items-center gap-3">
                                    <div class="master-icon-wrapper rounded-3 bg-light text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 48px; height: 48px; font-size: 1.25rem;">
                                        <i class="fa-solid @(string.IsNullOrEmpty(config.Icon) ? "fa-cube" : config.Icon)"></i>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate">@config.DisplayName</h6>
                                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-0 small" style="font-size: 0.7rem;">
                                                #@config.MenuOrder
                                            </span>
                                        </div>
                                        <span class="text-muted small d-block text-truncate">
                                            <i class="fa-solid fa-table-cells me-1"></i> @config.Fields.Count Fields &bull; @(config.SoftDelete ? "Soft Delete" : "Standard Delete")
                                        </span>
                                    </div>
                                    <div class="text-muted opacity-50 pe-1">
                                        <i class="fa-solid fa-chevron-right small"></i>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .master-overview-card {
        border-color: #e2e8f0 !important;
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .master-overview-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
        border-color: #3b82f6 !important;
    }
    .master-overview-card:hover .master-icon-wrapper {
        background-color: #eff6ff !important;
        color: #2563eb !important;
    }
</style>