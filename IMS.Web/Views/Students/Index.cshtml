@model IMS.Models.ViewModels.StudentIndexViewModel
@{
    ViewData["Title"] = "Students";

    string InitialsOf(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().Substring(0, 1).ToUpper();

    string StatusBadgeClass(string status) => (status ?? "").ToLower() switch
    {
        "active" or "admitted" => "bg-success",
        "inactive" or "suspended" => "bg-secondary",
        "graduated" or "alumni" => "bg-primary",
        "transferred" => "bg-warning text-dark",
        "withdrawn" or "dropped" or "expelled" => "bg-danger",
        _ => "bg-info text-dark"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-user-graduate text-primary me-2"></i>Students Directory</h4>
        <p class="text-muted small mb-0">Manage student profiles, academic placements, and real-time statuses.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Students" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add Student
        </a>
    </div>
</div>

<!-- Search & Filters Card -->
<div class="card shadow-sm border-0 mb-3 bg-white">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Students", FormMethod.Get, new { @class = "row g-3 align-items-end", id = "studentFilterForm" }))
        {
            <div class="col-md-3">
                <label for="searchTerm" class="form-label small fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" id="searchTerm" class="form-control"
                           value="@Model.SearchTerm" placeholder="Name, Code, Admission #..." />
                </div>
            </div>
            <div class="col-md-2">
                <label for="filterStatus" class="form-label small fw-semibold">Status</label>
                <select name="status" id="filterStatus" class="form-select">
                    <option value="">All Statuses</option>
                    @if (Model.StatusOptions != null)
                    {
                        foreach (var opt in Model.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.StatusFilter)">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterBranchId" class="form-label small fw-semibold">Branch</label>
                <select name="branchId" id="filterBranchId" class="form-select">
                    <option value="">All Branches</option>
                    @if (Model.BranchOptions != null)
                    {
                        foreach (var opt in Model.BranchOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.BranchFilter?.ToString())">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="classId" class="form-label small fw-semibold">Class</label>
                <select name="classId" id="classId" class="form-select">
                    <option value="">All Classes</option>
                    @if (Model.ClassOptions != null)
                    {
                        foreach (var opt in Model.ClassOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.ClassFilter?.ToString())">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- Students Grid Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student Info</th>
                    <th>Code & Admission</th>
                    <th>Class / Section</th>
                    <th>Branch</th>
                    <th>Batch</th>
                    <th>Admission Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="studentsTableBody">
                @if (Model.Students != null && Model.Students.Any())
                {
                    foreach (var s in Model.Students)
                    {
                        <tr id="student-row-@s.S_Id">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sd-avatar-sm rounded-circle d-flex align-items-center justify-content-center bg-primary text-white fw-bold" style="width:36px; height:36px; font-size:0.85rem;">
                                        @InitialsOf(s.FullName)
                                    </div>
                                    <div>
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@s.S_Id" class="fw-bold text-dark text-decoration-none">
                                            @s.FullName
                                        </a>
                                        <div class="text-muted small">
                                            @if (!string.IsNullOrWhiteSpace(s.S_Phone))
                                            {
                                                <span><i class="bi bi-telephone me-1"></i>@s.S_Phone</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(s.S_Email))
                                            {
                                                <span><i class="bi bi-envelope me-1"></i>@s.S_Email</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@s.S_StudentCode</div>
                                <div class="text-muted small">Adm: @s.S_AdmissionNumber</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @s.ClassName @(s.SectionName != "-" ? $"- {s.SectionName}" : "")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    @s.BranchName
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">
                                    @(string.IsNullOrWhiteSpace(s.BatchName) ? "-" : s.BatchName)
                                </span>
                            </td>
                            <td>@(s.S_AdmissionDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm p-0 border-0 dropdown-toggle text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Click to change status">
                                        <span id="status-badge-@s.S_Id" class="badge @StatusBadgeClass(s.S_Status) student-status-badge" data-student-id="@s.S_Id">
                                            @s.S_Status
                                        </span>
                                    </button>
                                    <ul class="dropdown-menu shadow-sm dropdown-menu-end">
                                        <li><h6 class="dropdown-header">Change Status</h6></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Admitted"><i class="bi bi-check-circle text-info me-2"></i>Admitted</a></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Active"><i class="bi bi-check-circle text-success me-2"></i>Active</a></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Inactive"><i class="bi bi-slash-circle text-secondary me-2"></i>Inactive</a></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Transferred"><i class="bi bi-arrow-left-right text-warning me-2"></i>Transferred</a></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Alumni"><i class="bi bi-mortarboard text-primary me-2"></i>Alumni</a></li>
                                        <li><a class="dropdown-item quick-status-item" href="#" data-student-id="@s.S_Id" data-status="Dropped"><i class="bi bi-x-circle text-danger me-2"></i>Dropped</a></li>
                                    </ul>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info quick-view-btn" data-id="@s.S_Id" title="Quick View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a asp-controller="Students" asp-action="Details" asp-route-id="@s.S_Id" class="btn btn-outline-secondary" title="Full Details">
                                        <i class="bi bi-file-earmark-person"></i>
                                    </a>
                                    <a asp-controller="Students" asp-action="Edit" asp-route-id="@s.S_Id" class="btn btn-outline-primary" title="Edit Student">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger confirm-delete-btn"
                                            data-id="@s.S_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@s.S_Id" title="Remove Student">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal-@s.S_Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Remove Student</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                Are you sure you want to remove <strong>@s.FullName</strong> (@s.S_StudentCode)?
                                                <div class="text-muted small mt-2">This action removes the student profile and unlinks their guardian associations.</div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Remove Student</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No student records found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ============================================================== -->
<!-- Quick View Modal                                               -->
<!-- Displays rich student snapshot on the grid via AJAX            -->
<!-- ============================================================== -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-light py-3 border-bottom">
                <h5 class="modal-title fw-bold text-dark" id="quickViewModalLabel">
                    <i class="bi bi-person-badge text-primary me-2"></i>Student Quick View
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="quickViewLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-muted small mt-2">Loading student details...</div>
                </div>

                <div id="quickViewContent" style="display:none;">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <div>
                            <h4 id="qvFullName" class="fw-bold mb-1 text-primary"></h4>
                            <div class="text-muted small">
                                Code: <span id="qvCode" class="fw-semibold text-dark"></span> &bull; 
                                Admission No: <span id="qvAdmNo" class="fw-semibold text-dark"></span>
                            </div>
                        </div>
                        <div>
                            <span id="qvStatus" class="badge bg-secondary fs-6"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small text-uppercase">Academic Placement</h6>
                                <div class="small mb-1"><strong>Branch:</strong> <span id="qvBranch"></span></div>
                                <div class="small mb-1"><strong>Class & Section:</strong> <span id="qvClass"></span></div>
                                <div class="small mb-1"><strong>Batch:</strong> <span id="qvBatch"></span></div>
                                <div class="small"><strong>Admission Date:</strong> <span id="qvAdmDate"></span></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <h6 class="fw-bold text-secondary mb-2 small text-uppercase">Personal & Contact</h6>
                                <div class="small mb-1"><strong>Phone:</strong> <span id="qvPhone"></span></div>
                                <div class="small mb-1"><strong>Email:</strong> <span id="qvEmail"></span></div>
                                <div class="small mb-1"><strong>Gender / Blood Group:</strong> <span id="qvGender"></span> / <span id="qvBloodGroup"></span></div>
                                <div class="small"><strong>Address:</strong> <span id="qvAddress"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 text-center">
                                <div class="text-muted small text-uppercase fw-semibold">Fee Overview</div>
                                <div class="d-flex justify-content-around mt-2">
                                    <div>
                                        <div class="small text-muted">Invoiced</div>
                                        <strong id="qvFeeInvoiced" class="text-dark"></strong>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Paid</div>
                                        <strong id="qvFeePaid" class="text-success"></strong>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Balance</div>
                                        <strong id="qvFeeBalance" class="text-danger"></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 text-center">
                                <div class="text-muted small text-uppercase fw-semibold">Attendance & Guardians</div>
                                <div class="d-flex justify-content-around mt-2">
                                    <div>
                                        <div class="small text-muted">Attendance Rate</div>
                                        <strong id="qvAttendancePct" class="text-success"></strong>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Leaves Taken</div>
                                        <strong id="qvLeavesCount" class="text-dark"></strong>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Guardians</div>
                                        <strong id="qvGuardiansCount" class="text-dark"></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <a id="qvDetailsLink" href="#" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-file-earmark-person me-1"></i> Full Details
                </a>
                <a id="qvEditLink" href="#" class="btn btn-primary px-3">
                    <i class="bi bi-pencil me-1"></i> Edit Student
                </a>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/students.js"></script>
    <script>
        $(function () {
            if ($.fn.DataTable) {
                $('#dataTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    order: [[0, 'asc']],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search table..."
                    }
                });
            }
        });
    </script>
}
