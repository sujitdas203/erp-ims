@model IMS.Models.ViewModels.TimetableFormViewModel
@{ 
    ViewData["Title"] = "Add Timetable Entry"; 
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-calendar-days me-2"></i>Add Timetable Entry</h3>
    <a asp-controller="Timetable" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Timetable
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="ttCreateForm" asp-controller="Timetable" asp-action="AddTimetable" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/common/datepicker.js"></script>
<script>
$(function () {
    IMSDatePicker.init({ input: '#TT_EffectiveFrom', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
    IMSDatePicker.init({ input: '#TT_EffectiveTo', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

    var selBranch = $('#TT_BranchId').data('selected-value');
    var selBatch = $('#TT_BatchId').data('selected-value');
    var selSubject = $('#TT_SubjectId').data('selected-value');
    var selStaff = $('#TT_StaffId').data('selected-value');
    var selClassroom = $('#TT_ClassroomId').data('selected-value');
    var selDay = $('#TT_DayOfWeek').data('selected-value') || '1';

    if (typeof Dropdown !== 'undefined' && Dropdown.load) {
        Dropdown.load({ element: '#TT_BranchId', entityType: 'Branch', defaultText: '-- Select Branch --', includeDefault: true, selectedValue: selBranch });
        Dropdown.load({ element: '#TT_BatchId', entityType: 'Batch', defaultText: '-- Select Batch --', includeDefault: true, selectedValue: selBatch });
        Dropdown.load({ element: '#TT_SubjectId', entityType: 'Subject', defaultText: '-- Select Subject --', includeDefault: true, selectedValue: selSubject });
        Dropdown.load({ element: '#TT_StaffId', entityType: 'Staff', defaultText: '-- Select Staff --', includeDefault: true, selectedValue: selStaff });
        Dropdown.load({ element: '#TT_ClassroomId', entityType: 'Classroom', defaultText: '-- Select Classroom (Optional) --', includeDefault: true, selectedValue: selClassroom });
        Dropdown.load({ element: '#TT_DayOfWeek', entityType: 'DayOfWeek', defaultText: '-- Select Day --', includeDefault: false, selectedValue: selDay });
    }

    if ($.fn.select2) {
        $('.select2-staff').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: '-- Select Staff --',
            allowClear: true
        });
    }

    var $form = $("#ttCreateForm");

    function clearFieldErrors() {
        $form.find(".is-invalid").removeClass("is-invalid");
        $form.find(".field-error").text("");
    }

    function setFieldError($field, message) {
        if (!$field || !$field.length) return;
        $field.addClass("is-invalid");
        var name = $field.attr("name") || $field.attr("id");
        var $err = $field.closest(".col-md-4, .col-md-3, .col-12, .mb-3").find(".field-error[data-for='" + name + "']");
        if ($err.length) {
            $err.text(message);
        }
    }

    $form.on("input change", "input, select, textarea", function () {
        var $field = $(this);
        if ($field.hasClass("is-invalid")) {
            $field.removeClass("is-invalid");
            var name = $field.attr("name") || $field.attr("id");
            $field.closest(".col-md-4, .col-md-3, .col-12, .mb-3").find(".field-error[data-for='" + name + "']").text("");
        }
    });

    function validateForm() {
        clearFieldErrors();
        var isValid = true;
        var firstInvalid = null;

        function checkRequired($field, fieldName, label) {
            var val = ($field.val() || "").toString().trim();
            if (!val || val === "00000000-0000-0000-0000-000000000000") {
                setFieldError($field, label + " is required.");
                if (!firstInvalid) firstInvalid = $field;
                isValid = false;
            }
        }

        var $branch = $("#TT_BranchId");
        var $batch = $("#TT_BatchId");
        var $subject = $("#TT_SubjectId");
        var $staff = $("#TT_StaffId");
        var $dayOfWeek = $("#TT_DayOfWeek");
        var $startTime = $("#TT_StartTime");
        var $endTime = $("#TT_EndTime");
        var $effFrom = $("#TT_EffectiveFrom");
        var $effTo = $("#TT_EffectiveTo");

        checkRequired($branch, "TT_BranchId", "Branch");
        checkRequired($batch, "TT_BatchId", "Batch");
        checkRequired($subject, "TT_SubjectId", "Subject");
        checkRequired($staff, "TT_StaffId", "Staff");

        var dayVal = parseInt($dayOfWeek.val(), 10);
        if (isNaN(dayVal) || dayVal < 1 || dayVal > 7) {
            setFieldError($dayOfWeek, "Please select a valid Day of Week (Monday to Sunday).");
            if (!firstInvalid) firstInvalid = $dayOfWeek;
            isValid = false;
        }

        checkRequired($startTime, "TT_StartTime", "Start Time");
        checkRequired($endTime, "TT_EndTime", "End Time");

        var startVal = $startTime.val();
        var endVal = $endTime.val();
        if (startVal && endVal && endVal <= startVal) {
            setFieldError($endTime, "End Time must be after Start Time.");
            if (!firstInvalid) firstInvalid = $endTime;
            isValid = false;
        }

        var fromVal = $effFrom.val();
        var toVal = $effTo.val();
        if (fromVal && toVal && toVal < fromVal) {
            setFieldError($effTo, "Effective To must be on or after Effective From.");
            if (!firstInvalid) firstInvalid = $effTo;
            isValid = false;
        }

        if (!isValid) {
            if (window.toastr) toastr.error("Please fill in all required fields correctly.");
            if (firstInvalid && firstInvalid.length) {
                firstInvalid.focus();
            }
        }
        return isValid;
    }

    $form.on("submit", function (e) {
        e.preventDefault();
        if (!validateForm()) return false;

        var $btn = $form.find("button[type='submit']");
        var original = $btn.html();
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

        $.ajax({
            url: $form.attr("action"),
            type: "POST",
            data: $form.serialize(),
            success: function (r) {
                if (r.success) {
                    if (window.toastr) toastr.success(r.message || "Timetable entry saved successfully.");
                    setTimeout(function () { window.location.href = "/Timetable/Index"; }, 700);
                } else {
                    if (window.toastr) toastr.error(r.message || "Failed to save.");
                    if (r.errors) {
                        var firstErrField = null;
                        $.each(r.errors, function (key, val) {
                            var $f = $form.find("[name='" + key + "'], #" + key);
                            if ($f.length) {
                                setFieldError($f, val);
                                if (!firstErrField) firstErrField = $f;
                            }
                        });
                        if (firstErrField) firstErrField.focus();
                    }
                    $btn.prop("disabled", false).html(original);
                }
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : "Request failed. Please try again.";
                if (window.toastr) toastr.error(msg);
                $btn.prop("disabled", false).html(original);
            }
        });
    });
});
</script>
}
