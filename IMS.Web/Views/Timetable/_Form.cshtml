@model IMS.Models.ViewModels.TimetableFormViewModel

@if (Model.TT_Id.HasValue) { @Html.HiddenFor(m => m.TT_Id) }

<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Branch <span class="text-danger">*</span></label>
        <select id="TT_BranchId" name="TT_BranchId" class="form-select" data-selected-value="@(Model.TT_BranchId.ToString())"></select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Batch <span class="text-danger">*</span></label>
        <select id="TT_BatchId" name="TT_BatchId" class="form-select" data-selected-value="@(Model.TT_BatchId.ToString())"></select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Subject <span class="text-danger">*</span></label>
        <select id="TT_SubjectId" name="TT_SubjectId" class="form-select" data-selected-value="@(Model.TT_SubjectId.ToString())"></select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Staff <span class="text-danger">*</span></label>
        <select id="TT_StaffId" name="TT_StaffId" class="form-select select2-staff" data-selected-value="@(Model.TT_StaffId.ToString())"></select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Classroom</label>
        <select id="TT_ClassroomId" name="TT_ClassroomId" class="form-select" data-selected-value="@(Model.TT_ClassroomId?.ToString())"></select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Day <span class="text-danger">*</span></label>
        <select id="TT_DayOfWeek" name="TT_DayOfWeek" class="form-select" data-selected-value="@(Model.TT_DayOfWeek)"></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Start Time <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.TT_StartTime, new { @class = "form-control", type = "time" })
    </div>
    <div class="col-md-3">
        <label class="form-label">End Time <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.TT_EndTime, new { @class = "form-control", type = "time" })
    </div>
    <div class="col-md-3">
        <label class="form-label">Effective From</label>
        @Html.TextBoxFor(m => m.TT_EffectiveFrom, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "TT_EffectiveFrom" })
    </div>
    <div class="col-md-3">
        <label class="form-label">Effective To</label>
        @Html.TextBoxFor(m => m.TT_EffectiveTo, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "TT_EffectiveTo" })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Timetable" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Save Entry</button>
</div>
