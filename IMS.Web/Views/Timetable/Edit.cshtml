@model IMS.Models.ViewModels.TimetableFormViewModel
@{ ViewData["Title"] = "Edit Timetable Entry"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0"><i class="fa-solid fa-calendar-days me-2 text-primary"></i>Edit Timetable Entry</h3>
        <p class="text-muted small mb-0">Update class schedule period details</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Schedule
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="ttEditForm" asp-controller="Timetable" asp-action="EditTimetable" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/common/datepicker.js"></script>
<script>
$(function () {
    // 1. Initialize Date Pickers
    if (typeof IMSDatePicker !== 'undefined') {
        IMSDatePicker.init({ input: '#TT_EffectiveFrom', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
        IMSDatePicker.init({ input: '#TT_EffectiveTo', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
    }

    // 2. Generic Dropdown Loading with selected values
    var selBranch = $('#TT_BranchId').data('selected-value') || $('#TT_BranchId').val();
    var selBatch = $('#TT_BatchId').data('selected-value') || $('#TT_BatchId').val();
    var selSubject = $('#TT_SubjectId').data('selected-value') || $('#TT_SubjectId').val();
    var selStaff = $('#TT_StaffId').data('selected-value') || $('#TT_StaffId').val();
    var selClassroom = $('#TT_ClassroomId').data('selected-value') || $('#TT_ClassroomId').val();
    var selDayOfWeek = $('#TT_DayOfWeek').data('selected-value') || $('#TT_DayOfWeek').val();

    if (typeof Dropdown !== 'undefined' && Dropdown.load) {
        Dropdown.load({ element: '#TT_BranchId', entityType: 'Branch', defaultText: 'Select Branch', includeDefault: true, selectedValue: selBranch });
        Dropdown.load({ element: '#TT_BatchId', entityType: 'Batch', defaultText: 'Select Batch', includeDefault: true, selectedValue: selBatch });
        Dropdown.load({ element: '#TT_SubjectId', entityType: 'Subject', defaultText: 'Select Subject', includeDefault: true, selectedValue: selSubject });
        Dropdown.load({ element: '#TT_StaffId', entityType: 'Staff', defaultText: 'Select Staff Member', includeDefault: true, selectedValue: selStaff });
        Dropdown.load({ element: '#TT_ClassroomId', entityType: 'Classroom', defaultText: 'Select Classroom (Optional)', includeDefault: true, selectedValue: selClassroom });
        Dropdown.load({ element: '#TT_DayOfWeek', entityType: 'DayOfWeek', defaultText: 'Select Day of Week', includeDefault: true, selectedValue: selDayOfWeek });
    }

    // 3. Initialize Select2 for Staff Dropdown
    if ($.fn.select2) {
        $('.select2-staff').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: 'Type to search staff...',
            allowClear: true,
            minimumInputLength: 0
        });
    }

    // Helper functions for field errors
    function clearFieldErrors() {
        $(".is-invalid").removeClass("is-invalid");
        $(".field-error").text("").hide();
    }

    function setFieldError(fieldSelector, message) {
        var $field = $(fieldSelector);
        if ($field.length) {
            $field.addClass("is-invalid");
            var name = $field.attr("name") || $field.attr("id");
            var $errorDiv = $('.field-error[data-for="' + name + '"]');
            if ($errorDiv.length) {
                $errorDiv.text(message).show();
            }
        }
    }

    // Live validation clearing on input or change
    $(document).on("input change", "input, select, textarea", function () {
        $(this).removeClass("is-invalid");
        var name = $(this).attr("name") || $(this).attr("id");
        if (name) {
            $('.field-error[data-for="' + name + '"]').text("").hide();
        }
    });

    // 4. Form Submit & AJAX validation
    $("#ttEditForm").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this);
        clearFieldErrors();

        var branchId = $("#TT_BranchId").val();
        var batchId = $("#TT_BatchId").val();
        var subjectId = $("#TT_SubjectId").val();
        var staffId = $("#TT_StaffId").val();
        var dayOfWeek = parseInt($("#TT_DayOfWeek").val(), 10);
        var startTime = $("#TT_StartTime").val();
        var endTime = $("#TT_EndTime").val();

        var hasError = false;
        var firstInvalidField = null;

        function markInvalid(selector, msg) {
            setFieldError(selector, msg);
            hasError = true;
            if (!firstInvalidField) {
                firstInvalidField = $(selector);
            }
        }

        if (!branchId || branchId === "00000000-0000-0000-0000-000000000000") {
            markInvalid("#TT_BranchId", "Please select a Branch.");
        }
        if (!batchId || batchId === "00000000-0000-0000-0000-000000000000") {
            markInvalid("#TT_BatchId", "Please select a Batch.");
        }
        if (!subjectId || subjectId === "00000000-0000-0000-0000-000000000000") {
            markInvalid("#TT_SubjectId", "Please select a Subject.");
        }
        if (!staffId || staffId === "00000000-0000-0000-0000-000000000000") {
            markInvalid("#TT_StaffId", "Please select a Staff Member.");
        }
        if (isNaN(dayOfWeek) || dayOfWeek < 1 || dayOfWeek > 7) {
            markInvalid("#TT_DayOfWeek", "Please select a valid Day of the Week (Monday to Sunday).");
        }
        if (!startTime) {
            markInvalid("#TT_StartTime", "Start Time is required.");
        }
        if (!endTime) {
            markInvalid("#TT_EndTime", "End Time is required.");
        }
        if (startTime && endTime && startTime >= endTime) {
            markInvalid("#TT_EndTime", "End Time must be after Start Time.");
        }

        if (hasError) {
            if (window.toastr) toastr.error("Please correct the highlighted errors before saving.");
            if (firstInvalidField) {
                firstInvalidField.focus();
            }
            return false;
        }

        var $btn = $form.find("button[type='submit']");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving Changes...');

        $.ajax({
            url: $form.attr("action"),
            type: "POST",
            data: $form.serialize(),
            success: function (r) {
                if (r.success) {
                    if (window.toastr) toastr.success(r.message || "Timetable entry updated successfully.");
                    setTimeout(function () { window.location.href = "/Timetable/Index"; }, 700);
                } else {
                    if (r.errors) {
                        for (var fieldKey in r.errors) {
                            var fieldMsg = r.errors[fieldKey];
                            setFieldError("#" + fieldKey, fieldMsg);
                            setFieldError("[name='" + fieldKey + "']", fieldMsg);
                        }
                    }
                    if (window.toastr) toastr.error(r.message || "Failed to update timetable entry.");
                    $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Update Entry');
                }
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : "An unexpected server error occurred. Please try again.";
                if (xhr.responseJSON && xhr.responseJSON.errors) {
                    for (var fieldKey in xhr.responseJSON.errors) {
                        var fieldMsg = xhr.responseJSON.errors[fieldKey];
                        setFieldError("#" + fieldKey, fieldMsg);
                        setFieldError("[name='" + fieldKey + "']", fieldMsg);
                    }
                }
                if (window.toastr) toastr.error(msg);
                $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Update Entry');
            }
        });
    });
});
</script>
}
