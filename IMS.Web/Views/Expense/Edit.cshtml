@model IMS.Models.ViewModels.ExpenseFormViewModel
@{ ViewData["Title"] = "Edit Expense"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-receipt me-2"></i>Edit Expense</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="expenseEditForm" asp-controller="Expense" asp-action="EditExpense" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/expenses.js"></script>
    <script>
        $(function () {
            IMSExpenseForm.init('/Expense/EditExpense');
            IMSDatePicker.init({ input: '#EXP_ExpenseDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

            Dropdown.load({ element: '#EXP_BranchId', entityType: 'Branch', defaultText: 'Select Branch', includeDefault: true, selectedValue: $('#EXP_BranchId').data('selected-value') });
            Dropdown.load({ element: '#EXP_ExpenseCategoryId', entityType: 'ExpenseCategory', defaultText: 'Select Category', includeDefault: true, selectedValue: $('#EXP_ExpenseCategoryId').data('selected-value') });
            Dropdown.load({ element: '#EXP_VendorId', entityType: 'Vendor', defaultText: 'Select Vendor', includeDefault: true, selectedValue: $('#EXP_VendorId').data('selected-value') });
            Dropdown.load({ element: '#EXP_PaymentMethodId', entityType: 'PaymentMethod', defaultText: 'Select Method', includeDefault: true, selectedValue: $('#EXP_PaymentMethodId').data('selected-value') });
        });
    </script>
}
