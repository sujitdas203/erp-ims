@model IMS.Models.SubjectSyllabus.SyllabusIndexViewModel
@{
    ViewData["Title"] = "Subject Syllabus";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-journal-bookmark me-2"></i>Subject Syllabus</h3>
    <a asp-controller="Syllabus" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Unit
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Syllabus", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("search", "Search", new { @class = "form-label" })
                @Html.TextBox("search", Model.Search, new { @class = "form-control", placeholder = "Unit title" })
            </div>
            <div class="col-md-3">
                @Html.Label("courseId", "Course", new { @class = "form-label" })
                @Html.DropDownList("courseId", Model.CourseOptions, "All Courses", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                @Html.Label("subjectId", "Subject", new { @class = "form-label" })
                @Html.DropDownList("subjectId", Model.SubjectOptions, "All Subjects", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All", new { @class = "form-select" })
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">Go</button>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Subject</th>
                    <th>Unit #</th>
                    <th>Title</th>
                    <th>Hours</th>
                    <th>Completed</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="syllabusTableBody">
                @if (!Model.Units.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No syllabus units found.</td></tr>
                }
                else
                {
                    foreach (var u in Model.Units)
                    {
                        <tr id="syllabus-row-@u.SS_Id">
                            <td>@u.CourseName</td>
                            <td>@u.SubjectName</td>
                            <td>@u.UnitNumber</td>
                            <td>@u.UnitTitle</td>
                            <td>@(u.TotalHours?.ToString() ?? "-")</td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input toggle-completed-switch"
                                           data-id="@u.SS_Id" @(u.IsCompleted ? "checked" : "") />
                                </div>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input toggle-active-switch"
                                           data-id="@u.SS_Id" @(u.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Syllabus" asp-action="Edit" asp-route-id="@u.SS_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@u.SS_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@u.SS_Id" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <div class="modal fade" id="deleteModal-@u.SS_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Syllabus Unit</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">Delete "<strong>@u.UnitTitle</strong>" permanently?</div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { courseId = Model.CourseFilter, subjectId = Model.SubjectFilter, status = Model.StatusFilter, search = Model.Search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/students.css" />
    <script src="~/js/syllabus.js"></script>
}
