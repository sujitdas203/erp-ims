@model IMS.Models.SubjectSyllabus.SyllabusFormViewModel
@{
    ViewData["Title"] = "Add Syllabus Unit";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Add Syllabus Unit</h3>
    <a asp-controller="Syllabus" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm("CreateAjax", "Syllabus", FormMethod.Post, new { id = "syllabusForm" }))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/syllabus.js"></script>
}
