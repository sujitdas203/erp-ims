@model IMS.Models.SubjectSyllabus.SyllabusFormViewModel

@if (Model.SS_Id.HasValue)
{
    @Html.HiddenFor(m => m.SS_Id)
}

<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.CourseId, "Course", new { @class = "form-label" })
        @Html.DropDownListFor(m => m.CourseId, Model.CourseOptions, "Select Course", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="CourseId"></div>
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.SubjectId, "Subject", new { @class = "form-label" })
        @Html.DropDownListFor(m => m.SubjectId, Model.SubjectOptions, "Select Subject", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="SubjectId"></div>
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.UnitNumber, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.UnitNumber, new { @class = "form-control", type = "number", min = "1" })
        <div class="text-danger small field-error" data-for="UnitNumber"></div>
    </div>

    <div class="col-md-8">
        @Html.LabelFor(m => m.UnitTitle, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.UnitTitle, new { @class = "form-control" })
        <div class="text-danger small field-error" data-for="UnitTitle"></div>
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.TotalHours, "Total Hours (optional)", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.TotalHours, new { @class = "form-control", type = "number", min = "0" })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.Description, "Description (optional)", new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5 })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.FileUrl, "Reference File URL (optional)", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.FileUrl, new { @class = "form-control", placeholder = "https://..." })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Syllabus" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Save Unit
    </button>
</div>
