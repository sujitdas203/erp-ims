@model IMS.Models.SubjectSyllabus.SyllabusFormViewModel

@if (Model.SS_Id.HasValue && Model.SS_Id.Value != Guid.Empty)
{
    @Html.HiddenFor(m => m.SS_Id)
}

<div class="row g-3">
    <div class="col-md-4">
        <label for="CourseId" class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.CourseId, Model.CourseOptions, "-- Select Course --", new { @class = "form-select", id = "CourseId" })
        <div class="text-danger small mt-1 field-error" data-for="CourseId"></div>
    </div>
    <div class="col-md-4">
        <label for="SubjectId" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.SubjectId, Model.SubjectOptions, "-- Select Subject --", new { @class = "form-select", id = "SubjectId" })
        <div class="text-danger small mt-1 field-error" data-for="SubjectId"></div>
    </div>
    <div class="col-md-4">
        <label for="UnitNumber" class="form-label fw-semibold">Unit Number <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.UnitNumber, new { @class = "form-control", id = "UnitNumber", type = "number", min = "1", placeholder = "e.g. 1" })
        <div class="text-danger small mt-1 field-error" data-for="UnitNumber"></div>
    </div>

    <div class="col-md-8">
        <label for="UnitTitle" class="form-label fw-semibold">Unit Title <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.UnitTitle, new { @class = "form-control", id = "UnitTitle", placeholder = "e.g. Introduction to Data Structures" })
        <div class="text-danger small mt-1 field-error" data-for="UnitTitle"></div>
    </div>
    <div class="col-md-4">
        <label for="TotalHours" class="form-label fw-semibold">Total Hours <span class="text-muted fw-normal">(optional)</span></label>
        @Html.TextBoxFor(m => m.TotalHours, new { @class = "form-control", id = "TotalHours", type = "number", min = "0", placeholder = "e.g. 15" })
        <div class="text-danger small mt-1 field-error" data-for="TotalHours"></div>
    </div>

    <div class="col-12">
        <label for="Description" class="form-label fw-semibold">Description / Topics Covered <span class="text-muted fw-normal">(optional)</span></label>
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", id = "Description", rows = 4, placeholder = "Detailed syllabus topics, chapters, and objectives..." })
        <div class="text-danger small mt-1 field-error" data-for="Description"></div>
    </div>

    <div class="col-12">
        <label for="FileUrl" class="form-label fw-semibold">Reference Document / File URL <span class="text-muted fw-normal">(optional)</span></label>
        @Html.TextBoxFor(m => m.FileUrl, new { @class = "form-control", id = "FileUrl", placeholder = "https://example.com/syllabus-docs/unit1.pdf" })
        <div class="text-danger small mt-1 field-error" data-for="FileUrl"></div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
    <a asp-controller="Syllabus" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i> Cancel
    </a>
    <button type="submit" class="btn btn-primary px-4">
        <i class="bi bi-check-lg me-1"></i> Save Syllabus Unit
    </button>
</div>
