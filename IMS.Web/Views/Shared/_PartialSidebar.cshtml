@using IMS.Models.Common.Master
@using IMS.Helpers.Constants
@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentEntityType = ViewContext.RouteData.Values["entityType"]?.ToString() ?? "";

    Func<string, string, string> isActive = (area, controller) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    var masterConfigs = MasterConfigRegistry.GetMenuConfigs();
    var isMasterController = string.Equals(currentController, "Master", StringComparison.OrdinalIgnoreCase);
}

<aside class="IMS-sidebar" id="IMSSidebar">

    <!-- Brand -->
    <div class="IMS-sidebar-brand">
        <i class="fa-solid fa-graduation-cap IMS-brand-icon"></i>
        <span class="brand-text">IMS</span>
    </div>

    <nav class="IMS-nav">

        <!-- Dashboard -->
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Home")"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 1: Students & Admissions                   -->
        <!-- Student lifecycle: inquiry → enrol → graduate      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Students & Admissions</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "AdmissionApplication")"
                   asp-controller="AdmissionApplication"
                   asp-action="Index">
                    <i class="fa-solid fa-address-card"></i>
                    <span>Admissions</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Enrollment")"
                   asp-controller="Enrollment"
                   asp-action="Index">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Enrollments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Students")"
                   asp-controller="Students"
                   asp-action="Index">
                    <i class="fa-solid fa-user-graduate"></i>
                    <span>Students</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "StudentLeave")"
                   asp-controller="StudentLeave"
                   asp-action="Index">
                    <i class="fa-solid fa-user-clock"></i>
                    <span>Student Leaves</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "TransferCertificate")"
                   asp-controller="TransferCertificate"
                   asp-action="Index">
                    <i class="fa-solid fa-file-shield"></i>
                    <span>Transfer Certificates (TC)</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 2: Academic Delivery                       -->
        <!-- What is taught, when, by whom — daily/weekly ops  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Academic Delivery</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Batch")"
                   asp-controller="Batch"
                   asp-action="Index">
                    <i class="fa-solid fa-users-rectangle"></i>
                    <span>Batches</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "CourseSubject")"
                   asp-controller="CourseSubject"
                   asp-action="Index">
                    <i class="fa-solid fa-book-bookmark"></i>
                    <span>Course Subjects</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Syllabus")"
                   asp-controller="Syllabus"
                   asp-action="Index">
                    <i class="fa-solid fa-book-open-reader"></i>
                    <span>Syllabus</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Timetable")"
                   asp-controller="Timetable"
                   asp-action="Index">
                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Timetable</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "HomeTasks")"
                   asp-controller="HomeTasks"
                   asp-action="Index">
                    <i class="fa-solid fa-list-check"></i>
                    <span>Home Tasks</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "MockTests")"
                   asp-controller="MockTests"
                   asp-action="Index">
                    <i class="fa-solid fa-vial-circle-check"></i>
                    <span>Mock Tests</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 3: Attendance Centre                       -->
        <!-- Daily mark-taking — student + teacher              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Attendance Centre</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Attendance")"
                   asp-controller="Attendance"
                   asp-action="Index">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Student Attendance</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "TeacherAttendance")"
                   asp-controller="TeacherAttendance"
                   asp-action="Index">
                    <i class="fa-solid fa-clipboard-user"></i>
                    <span>Teacher Attendance</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 4: HR & Faculty                            -->
        <!-- People management — teachers and non-teaching staff -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">HR & Faculty</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Teachers")"
                   asp-controller="Teachers"
                   asp-action="Index">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    <span>Teachers</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Staff")"
                   asp-controller="Staff"
                   asp-action="Index">
                    <i class="fa-solid fa-user-tie"></i>
                    <span>Staff</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "TeacherLeave")"
                   asp-controller="TeacherLeave"
                   asp-action="Index">
                    <i class="fa-solid fa-calendar-xmark"></i>
                    <span>Teacher Leaves</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 5: Examinations                            -->
        <!-- Exam planning → marks entry → results              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Examinations</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Exam")"
                   asp-controller="Exam"
                   asp-action="Index">
                    <i class="fa-solid fa-file-pen"></i>
                    <span>Examinations</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 6: Finance                                 -->
        <!-- All money matters — fee collection + expenditure  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Finance</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Fees")"
                   asp-controller="Fees"
                   asp-action="Index">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                    <span>Fees & Payments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Expense")"
                   asp-controller="Expense"
                   asp-action="Index">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Expenses</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 7: Communication                           -->
        <!-- Information broadcast + notification alerts        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Communication</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Announcements")"
                   asp-controller="Announcements"
                   asp-action="Index">
                    <i class="fa-solid fa-bullhorn"></i>
                    <span>Announcements</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "NotificationConfig")"
                   asp-area=""
                   asp-controller="NotificationConfig"
                   asp-action="Index">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Notification Hub</span>
                </a>
            </li>
        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 8: System Setup                            -->
        <!-- One-time / rare config — Admin / Principal only   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">System Setup</div>

        <ul class="nav flex-column">

            <!-- Master Management Collapsible Sub-menu -->
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center justify-content-between @(isMasterController ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#masterMenuCollapse"
                   role="button"
                   aria-expanded="@(isMasterController ? "true" : "false")"
                   aria-controls="masterMenuCollapse">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-database"></i>
                        <span>Master Management</span>
                    </div>
                    <i class="fa-solid fa-chevron-down IMS-menu-arrow"></i>
                </a>

                <div class="collapse @(isMasterController ? "show" : "")" id="masterMenuCollapse">
                    <ul class="nav flex-column ps-3 py-1 IMS-sub-nav">
                        <li class="nav-item">
                            <a class="nav-link sub-link @(isMasterController && string.IsNullOrEmpty(currentEntityType) ? "active" : "")"
                               href="/Master">
                                <i class="fa-solid fa-border-all me-2"></i>
                                <span>Master Overview</span>
                            </a>
                        </li>
                        @{
                            string lastGroup = "";
                        }
                        @foreach (var master in masterConfigs)
                        {
                            if (!string.IsNullOrEmpty(master.GroupName) && master.GroupName != lastGroup)
                            {
                                lastGroup = master.GroupName;
                                <li class="nav-item pt-2 pb-1 px-3">
                                    <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px; opacity: 0.85;">@master.GroupName</span>
                                </li>
                            }
                            var isThisMasterActive = isMasterController && string.Equals(currentEntityType, master.EntityType, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a class="nav-link sub-link @(isThisMasterActive ? "active" : "")"
                                   href="/Master/@master.EntityType">
                                    <i class="fa-solid @(string.IsNullOrEmpty(master.Icon) ? "fa-cube" : master.Icon) me-2"></i>
                                    <span>@master.DisplayName</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "DbTest")"
                   asp-area=""
                   asp-controller="DbTest"
                   asp-action="Index">
                    <i class="fa-solid fa-server"></i>
                    <span>Database Diagnostics</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Users & Roles</span>
                    <span class="IMS-soon-badge">Soon</span>
                </a>
            </li>

        </ul>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION 9: Insights                                -->
        <!-- Decision-support for principals & management       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div class="nav-section-label">Insights</div>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Reports</span>
                    <span class="IMS-soon-badge">Soon</span>
                </a>
            </li>
        </ul>

    </nav>

</aside>
