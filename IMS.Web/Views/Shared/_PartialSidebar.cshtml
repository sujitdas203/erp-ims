@using IMS.Models.Common.Master
@using IMS.Models.Common.Navigation
@using IMS.Helpers.Constants
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject IMS.Services.Interfaces.ISidebarMenuService SidebarMenuService

@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentEntityType = ViewContext.RouteData.Values["entityType"]?.ToString() ?? "";

    Func<string, string, string> isActive = (area, controller) =>
    {
        if (string.IsNullOrEmpty(controller)) return "";
        var matchArea = string.Equals(currentArea, area ?? "", StringComparison.OrdinalIgnoreCase);
        var matchCtrl = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ||
                       (string.Equals(controller, "AdmissionApplication", StringComparison.OrdinalIgnoreCase) && string.Equals(currentController, "Admission", StringComparison.OrdinalIgnoreCase)) ||
                       (string.Equals(controller, "Students", StringComparison.OrdinalIgnoreCase) && string.Equals(currentController, "Student", StringComparison.OrdinalIgnoreCase));
        return matchArea && matchCtrl ? "active" : "";
    };

    var masterConfigs = MasterConfigRegistry.GetMenuConfigs();
    var isMasterController = string.Equals(currentController, "Master", StringComparison.OrdinalIgnoreCase);
    var isAdmin = User.IsInRole(AppRoles.TenantAdmin) || User.IsInRole("SYSTEM_ADMIN");

    var sections = await SidebarMenuService.GetSidebarMenuAsync();
}

<aside class="IMS-sidebar" id="IMSSidebar">

    <!-- Brand -->
    <div class="IMS-sidebar-brand">
        <i class="fa-solid fa-graduation-cap IMS-brand-icon"></i>
        <span class="brand-text">IMS</span>
    </div>

    <nav class="IMS-nav">

        @foreach (var navSec in sections)
        {
            // Filter items permitted for the current user
            var visibleItems = new List<NavItemConfig>();
            foreach (var item in navSec.Items)
            {
                if (string.IsNullOrEmpty(item.PermissionCode) || isAdmin)
                {
                    visibleItems.Add(item);
                }
                else
                {
                    var authResult = await AuthorizationService.AuthorizeAsync(User, $"Permission:{item.PermissionCode}");
                    if (authResult.Succeeded)
                    {
                        visibleItems.Add(item);
                    }
                }
            }

            // AUTO-HIDE: Skip entire section (including header) if no items are visible to user
            if (!visibleItems.Any())
            {
                continue;
            }

            @if (!string.IsNullOrWhiteSpace(navSec.Title))
            {
                <div class="nav-section-label">@navSec.Title</div>
            }

            <ul class="nav flex-column">
                @foreach (var item in visibleItems)
                {
                    if (item.IsMasterManagement)
                    {
                        <!-- Master Management Collapsible Sub-menu -->
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center justify-content-between @(isMasterController ? "active" : "")"
                               data-bs-toggle="collapse"
                               data-bs-target="#@(item.CollapseTargetId ?? "masterMenuCollapse")"
                               href="javascript:void(0);"
                               role="button"
                               aria-expanded="@(isMasterController ? "true" : "false")"
                               aria-controls="@(item.CollapseTargetId ?? "masterMenuCollapse")">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid @item.Icon"></i>
                                    <span>@item.Title</span>
                                </div>
                                <i class="fa-solid fa-chevron-down IMS-menu-arrow"></i>
                            </a>

                            <div class="collapse @(isMasterController ? "show" : "")" id="@(item.CollapseTargetId ?? "masterMenuCollapse")">
                                <ul class="nav flex-column ps-3 py-1 IMS-sub-nav">
                                    <li class="nav-item">
                                        <a class="nav-link sub-link @(isMasterController && string.IsNullOrEmpty(currentEntityType) ? "active" : "")"
                                           href="/Master">
                                            <i class="fa-solid fa-border-all me-2"></i>
                                            <span>Master Overview</span>
                                        </a>
                                    </li>
                                    @{
                                        string lastGroup = "";
                                    }
                                    @foreach (var master in masterConfigs)
                                    {
                                        if (!string.IsNullOrEmpty(master.GroupName) && master.GroupName != lastGroup)
                                        {
                                            lastGroup = master.GroupName;
                                            <li class="nav-item pt-2 pb-1 px-3">
                                                <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px; opacity: 0.85;">@master.GroupName</span>
                                            </li>
                                        }
                                        var isThisMasterActive = isMasterController && string.Equals(currentEntityType, master.EntityType, StringComparison.OrdinalIgnoreCase);
                                        <li class="nav-item">
                                            <a class="nav-link sub-link @(isThisMasterActive ? "active" : "")"
                                               href="/Master/@master.EntityType">
                                                <i class="fa-solid @(string.IsNullOrEmpty(master.Icon) ? "fa-cube" : master.Icon) me-2"></i>
                                                <span>@master.DisplayName</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @if (!string.IsNullOrEmpty(item.CustomUrl))
                            {
                                <a class="nav-link" href="@item.CustomUrl">
                                    <i class="fa-solid @item.Icon"></i>
                                    <span>@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="@(item.BadgeClass ?? "IMS-soon-badge")">@item.BadgeText</span>
                                    }
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(item.Controller))
                            {
                                <a class="nav-link @isActive(item.Area, item.Controller)"
                                   asp-area="@item.Area"
                                   asp-controller="@item.Controller"
                                   asp-action="@(string.IsNullOrEmpty(item.Action) ? "Index" : item.Action)">
                                    <i class="fa-solid @item.Icon"></i>
                                    <span>@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="@(item.BadgeClass ?? "IMS-soon-badge")">@item.BadgeText</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <a class="nav-link" href="javascript:void(0);">
                                    <i class="fa-solid @item.Icon"></i>
                                    <span>@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="@(item.BadgeClass ?? "IMS-soon-badge")">@item.BadgeText</span>
                                    }
                                </a>
                            }
                        </li>
                    }
                }
            </ul>
        }

    </nav>

</aside>
