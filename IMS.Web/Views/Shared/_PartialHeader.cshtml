<header class="IMS-topbar">

    <button class="IMS-sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
        <i class="fa-solid fa-bars"></i>
    </button>

    <div class="IMS-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" placeholder="Search students, faculty, batches, fees…" aria-label="Search" />
    </div>

    <div class="IMS-topbar-actions">

        <!-- Theme Switcher Dropdown (Light, Semi-Dark, Dark) -->
        <div class="dropdown" id="themeSwitcherContainer">
            <button class="IMS-icon-btn" type="button" id="themeSwitcherBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Theme (Light, Semi-Dark, Dark)">
                <i class="fa-solid fa-circle-half-stroke" id="themeSwitcherIcon"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm IMS-theme-menu" aria-labelledby="themeSwitcherBtn" style="min-width: 180px; border-radius: 10px;">
                <li>
                    <h6 class="dropdown-header text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">Theme Appearance</h6>
                </li>
                <li>
                    <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-option-btn" type="button" data-theme-value="light" onclick="IMSTheme.setTheme('light');">
                        <span class="d-flex align-items-center"><i class="fa-regular fa-sun me-2 text-warning" style="width: 16px;"></i> Light Mode</span>
                        <i class="fa-solid fa-check text-primary theme-check-icon d-none" data-theme-check="light"></i>
                    </button>
                </li>
                <li>
                    <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-option-btn" type="button" data-theme-value="semi-dark" onclick="IMSTheme.setTheme('semi-dark');">
                        <span class="d-flex align-items-center"><i class="fa-solid fa-circle-half-stroke me-2 text-primary" style="width: 16px;"></i> Semi-Dark</span>
                        <i class="fa-solid fa-check text-primary theme-check-icon d-none" data-theme-check="semi-dark"></i>
                    </button>
                </li>
                <li>
                    <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-option-btn" type="button" data-theme-value="dark" onclick="IMSTheme.setTheme('dark');">
                        <span class="d-flex align-items-center"><i class="fa-regular fa-moon me-2 text-info" style="width: 16px;"></i> Dark Mode</span>
                        <i class="fa-solid fa-check text-primary theme-check-icon d-none" data-theme-check="dark"></i>
                    </button>
                </li>
            </ul>
        </div>

        <!-- Header Notification Bell & Dropdown -->
        <div class="dropdown" id="notificationDropdownContainer">
            <button class="IMS-icon-btn" type="button" id="notificationBellBtn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                <i class="fa-regular fa-bell"></i>
                <span class="IMS-badge-dot d-none" id="headerNotificationBadge"></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-0 shadow-sm" id="notificationDropdownMenu" style="width: 350px; max-width: 90vw; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden;">
                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between px-3 py-2 bg-light border-bottom">
                    <div class="fw-semibold text-dark" style="font-size: 0.88rem;">
                        Notifications
                        <span class="badge bg-danger rounded-pill ms-1 d-none" id="headerUnreadBadge">0</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted" style="font-size: 0.75rem;" onclick="markAllNotificationsRead(event)">
                        Mark all as read
                    </button>
                </div>

                <!-- Notification List Container (Only Active / Unread) -->
                <div id="notificationList" style="max-height: 340px; overflow-y: auto;">
                    <div class="text-center py-4 text-muted" id="notificationEmptyState">
                        <span style="font-size: 0.8rem;">No active notifications</span>
                    </div>
                </div>

                <!-- Footer Link to Configuration -->
                <div class="px-3 py-2 bg-light border-top text-center">
                    <a href="/NotificationConfig" class="text-decoration-none text-muted" style="font-size: 0.78rem;">
                        <i class="fa-solid fa-gear me-1"></i> Notification Settings
                    </a>
                </div>
            </div>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown">
            <button class="IMS-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="IMS-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")</span>
                <span class="IMS-user-name d-none d-md-inline">@(User.Identity?.Name ?? "Administrator")</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/TenantUserProfile/Index"><i class="fa-regular fa-user me-2"></i>Profile</a></li>
                <li><a class="dropdown-item" href="/NotificationConfig"><i class="fa-solid fa-sliders me-2"></i>Notification Settings</a></li>
                <li><a class="dropdown-item" href="/Master"><i class="fa-solid fa-database me-2"></i>Master Registry</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item text-danger" href="/Home/Logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a></li>
            </ul>
        </div>

    </div>

</header>
